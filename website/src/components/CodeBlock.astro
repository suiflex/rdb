---
/** One-line shell command with a copy button. */
interface Props {
  code: string;
  label: string;
}
const { code, label } = Astro.props;
---

<div
  class="copy-block command-block"
>
  <code>
    <span class="select-none text-fg-3">$ </span>{code}
  </code>
  <button
    type="button"
    class="copy-btn"
    data-code={code}
    aria-label={`Copy ${label} command`}
  >
    copy
  </button>
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy-btn")) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.code ?? "");
        btn.textContent = "copied";
      } catch {
        btn.textContent = "failed";
      }
      setTimeout(() => (btn.textContent = "copy"), 1600);
    });
  }
</script>

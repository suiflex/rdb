---
import Logo from "./Logo.astro";
import { FOOTER, GITHUB, PRODUCT, url } from "../config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="home-container py-14">
    <div class="footer-grid">
      <div>
        <a href={url("/")} class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-[0]">
          <Logo class="h-7 w-7 rounded-[6px] ring-1 ring-line" />
          {PRODUCT}
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-fg-3">
          Free and open-source database management. One native binary for
          macOS, Windows, and Linux, built in Rust.
        </p>
        <a
          href="https://suiflex.dev"
          rel="noopener"
          class="footer-badge"
        >
          <img src={url("/assets/brand/logo-mark.png")} alt="" aria-hidden="true" class="h-5 w-5 rounded-md" />
          Suiflex Org
        </a>
      </div>
      {
        Object.entries(FOOTER).map(([heading, items]) => (
          <nav aria-label={heading}>
            <h2 class="font-display text-sm font-semibold">{heading}</h2>
            <ul class="mt-4 space-y-2.5">
              {items.map((item) => (
                <li>
                  <a
                    href={item.external ? item.href : url(item.href)}
                    rel={item.external ? "noopener" : undefined}
                    class="footer-link"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="footer-bottom">
      <p>Apache-2.0 licensed. Copyright {year} the RDB contributors.</p>
      <p>
        Built in the open at
        <a href={GITHUB} rel="noopener" class="text-fg-2 underline decoration-line underline-offset-4 hover:text-fg">
          suiflex/rdb
        </a>
      </p>
    </div>
  </div>
</footer>

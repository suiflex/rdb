// Shared view-model struct shapes (generated as Rust structs). Kept in a leaf
// file with no component imports so sidebar/workarea/app-window can all import
// them without an import cycle.
export struct GridColumn { name: string, type-name: string }
// `state` mirrors the app-side edit buffer: 0 normal, 1 edited (pending
// update), 2 delete-marked, 3 inserted (pending insert).
export struct GridCell { text: string, is-null: bool, state: int }
// `db` tags the owning database for container rows (Mongo db→collection tree);
// empty for SQL/Redis where the category path is used instead.
// `count` is the number of (filter-matching) containers under a header row;
// 0 hides the badge. Non-header rows always carry 0.
// `sub` is a small driver badge; only "recent" (History) rows use it, keyed
// like `DbBadge.engine` ("postgres"|"mysql"|...). Empty for every other kind.
// `sub-color`/`sub-has-custom-color` mirror `ConnItem`'s color/has-custom-color
// pair — the connection's own accent, so the badge matches everywhere else.
export struct TreeNode {
    label: string, depth: int, kind: string, expanded: bool, db: string, count: int, sub: string,
    sub-color: color, sub-has-custom-color: bool,
}
// One row of the collapsible Mongo document (JSON) tree. `path` is the stable
// collapse key; `expandable` shows a fold caret, `expanded` its state.
export struct DocRow { depth: int, key: string, preview: string, full: string, expandable: bool, expanded: bool, path: string }
// A sidebar row is either a group header (is-header=true, name holds the group
// label, expanded holds its toggle state) or a connection. `index` is the
// connection's index in the underlying store (-1 for headers) so connect/edit
// callbacks keep using the real store index regardless of grouping/order.
export struct ConnItem {
    id: string,
    name: string,
    engine: string,
    color: color,
    // Whether `color` is a user-picked accent vs. just the generic fallback
    // `theme::accent_or_default` returns when no color was ever set — lets
    // the UI fall back to the per-engine palette instead of that generic
    // color for connections that never touched the color picker.
    has-custom-color: bool,
    is-header: bool,
    expanded: bool,
    index: int,
    group: string,
    // "host : database" mono subline under the name (empty for headers).
    subline: string,
    // Show the LOCAL outline chip on this row / detail header.
    local: bool,
    // Direct children count shown next to a header row (headers only).
    count: int,
    // Starred connection: renders a badge and floats to the top of its group.
    favorite: bool,
    // Environment tag pill (empty label => no pill rendered).
    env-tag-label: string,
    env-tag-color: color,
    // True on the last row of a group's currently-visible block (last member
    // if expanded, otherwise the header itself) — rounds the card's bottom
    // corners so consecutive groups read as separate cards.
    is-group-end: bool,
}
// One Host/Port/… row of the connection-detail card.
export struct KvRow { k: string, v: string }
export struct StructField { name: string, type-name: string, nullable: bool }
// One editable row of the new-table designer.
export struct TableCol { name: string, type-name: string, nullable: bool, pk: bool }
// `kind` picks the tab glyph; preview table tabs are italic until pinned.
// `engine` is the DbBadge key ("postgres" etc, empty when no connection was
// active when the tab was created); `connection-name` is the full name shown
// via tooltip / inline label.
export struct TabItem { title: string, kind: string, preview: bool, engine: string, connection-name: string, color: color, has-custom-color: bool }
// One "Result N" chip in the results panel (a tab can accumulate several runs).
// `engine`/`connection-name` identify which connection produced that specific
// run — distinct from the connection on the owning TabItem, since a long-lived
// SQL tab can be re-run after switching the active connection.
export struct ResultTabItem { label: string, engine: string, connection-name: string, color: color, has-custom-color: bool }
// One lexed editor token; `kind`: 0 plain · 1 keyword · 2 string ·
// 3 function · 4 comment · 5 number (mirrors app/src/editor.rs).
// `sel` = inside the selection (background highlight). `cols` = char count, so
// the renderer can pin the span to the same charw grid the caret uses.
export struct Span { text: string, kind: int, sel: bool, cols: int }
// One horizontal bar of the results chart; `frac` is value/max in [0,1].
export struct ChartBar { label: string, value: string, frac: float }
// One row of the Indexes view: index name + definition/columns.
export struct IndexRow { name: string, definition: string }

// Data grid (Tabula): row-number gutter, mono cells, vertical hairlines,
// NULL italics, fk links, red pending-edit outline.
// Cells are flat row-major: row r, col c at r*col-count + c.
import { Tokens } from "tokens.slint";
import { GridColumn, GridCell } from "structs.slint";
import { ComboBox, DatePickerPopup, ScrollView, TextEdit } from "std-widgets.slint";

export component TabularGrid inherits Rectangle {
    in property <[GridColumn]> columns;
    in property <[GridCell]> cells;
    // When true the cell overlay opens as a selectable, non-editable viewer so
    // a query-result value can be selected and copied instead of edited.
    in property <bool> read-only;
    in property <int> col-count;
    in property <[length]> col-widths;     // per-column pixel widths (drag-resizable)
    in property <int> sorted-col: -1;       // display col currently sorted, -1 none
    in property <bool> sort-asc: true;
    callback sort-col(int);                 // header click → sort by this column
    callback reorder-col(int, length);      // header drag → (col, drop x in cell)
    in property <bool> filter-open;         // show the per-column filter row
    in property <[string]> col-filter-values; // current text per display column
    callback set-col-filter(int, string);   // (display col, raw filter text)
    in-out property <int> selected-row: 0;
    in-out property <int> selected-col: -1;
    // inline edit overlay: row/col currently being edited, -1 = none
    in property <int> editing-row: -1;
    in property <int> editing-col: -1;
    in-out property <string> editing-value;
    callback resize-col(int, length);      // (column index, drag delta)
    callback select-cell(int, int);        // (row, col)
    callback edit-cell(int, int);          // double-click → open inline editor
    callback cell-edited(int, int, string); // Enter in the inline editor
    callback cell-advance(int, int, string, bool); // Tab/Shift+Tab → commit + edit neighbour
    callback edit-cancelled();
    in property <int> scroll-grid-tick;
    property <int> date-row: -1;
    property <int> date-col: -1;
    // Manual row virtualization: only the on-screen window of rows is built, so a
    // single two-axis Flickable can scroll both ways smoothly without paying to
    // instantiate every row of a large result. `r` rebinds as the window slides.
    property <int> row-count: root.col-count > 0 ? root.cells.length / root.col-count : 0;
    property <int> first-row: clamp(floor(-flick.viewport-y / Tokens.grid-row-h), 0, max(0, root.row-count - 1));
    property <int> win-count: min(root.row-count - root.first-row, ceil(la.height / Tokens.grid-row-h) + 2);

    pure function is-boolean(t: string) -> bool {
        return t == "bool" || t == "boolean" || t == "BOOL" || t == "BOOLEAN"
            || t == "MYSQL_TYPE_BIT";
    }

    pure function is-date(t: string) -> bool {
        return t == "date" || t == "DATE" || t == "timestamp" || t == "TIMESTAMP"
            || t == "timestamptz" || t == "TIMESTAMPTZ" || t == "datetime"
            || t == "DATETIME" || t == "MYSQL_TYPE_DATE" || t == "MYSQL_TYPE_DATETIME"
            || t == "MYSQL_TYPE_TIMESTAMP";
    }

    changed scroll-grid-tick => {
        flick.viewport-y = min(0px, flick.height - flick.viewport-height);
    }

    // One two-axis Flickable scrolls both ways (trackpad smooth on both), and
    // rows are manually windowed — only the on-screen slice exists — so it stays
    // light on large results. The header sits above and pans with viewport-x.
    VerticalLayout {
        // fixed header + filter, clipped and panned horizontally with the rows
        Rectangle {
            clip: true;
            height: Tokens.grid-header-h + 1px + (root.filter-open ? 26px + 1px : 0px);
            hdr := VerticalLayout {
                x: flick.viewport-x;
                width: max(self.preferred-width, parent.width);

        // ----- header (27px): "name" 600 + type dim, mono -----
        HorizontalLayout {
            height: Tokens.grid-header-h;
            Rectangle {
                width: 44px;
                background: Tokens.canvas;
                Rectangle { width: 1px; x: parent.width - 1px; background: Tokens.border; }
            }
            for col[c] in root.columns: Rectangle {
                width: root.col-widths.length > c ? root.col-widths[c] : 140px;
                background: Tokens.canvas;
                clip: true;
                HorizontalLayout {
                    padding-left: Tokens.sp2;
                    padding-right: Tokens.sp2;
                    spacing: Tokens.sp2;
                    alignment: start;
                    Text {
                        vertical-alignment: center;
                        text: col.name;
                        color: Tokens.text;
                        font-family: Tokens.mono;
                        font-size: Tokens.font-sm;
                        font-weight: Tokens.weight-emphasis;
                        overflow: elide;
                    }
                    Text {
                        vertical-alignment: center;
                        text: col.type-name;
                        color: Tokens.text-faint;
                        font-family: Tokens.mono;
                        font-size: Tokens.font-xs;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // asc/desc arrow when this column drives the sort
                    Text {
                        vertical-alignment: center;
                        text: root.sorted-col == c ? (root.sort-asc ? "↑" : "↓") : "";
                        color: Tokens.accent;
                        font-family: Tokens.mono;
                        font-size: Tokens.font-sm;
                    }
                }
                // header (minus the resize handle): click sorts, drag reorders
                TouchArea {
                    width: parent.width - 5px;
                    x: 0;
                    property <bool> dragging;
                    moved => {
                        if (abs(self.mouse-x - self.pressed-x) > 6px) {
                            self.dragging = true;
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { self.dragging = false; }
                        if (e.kind == PointerEventKind.up) {
                            if (self.dragging) {
                                root.reorder-col(c, self.mouse-x);
                            } else {
                                root.sort-col(c);
                            }
                        }
                    }
                }
                Rectangle { width: 1px; x: parent.width - 1px; background: Tokens.border; }
                // right-edge drag handle to resize this column
                Rectangle {
                    width: 5px;
                    x: parent.width - self.width;
                    background: hdl.has-hover || hdl.pressed ? Tokens.accent : transparent;
                    hdl := TouchArea {
                        mouse-cursor: col-resize;
                        moved => { root.resize-col(c, self.mouse-x - self.pressed-x); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; background: Tokens.canvas; }
        }
        Rectangle { height: 1px; background: Tokens.border-strong; }

        // ----- per-column filter row (type e.g. >100, matches AND) -----
        if root.filter-open: HorizontalLayout {
            height: 26px;
            Rectangle { width: 44px; background: Tokens.chrome; }
            for col[c] in root.columns: Rectangle {
                width: root.col-widths.length > c ? root.col-widths[c] : 140px;
                background: Tokens.chrome;
                clip: true;
                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 5px;
                    height: parent.height - 4px;
                    border-radius: Tokens.radius;
                    border-width: 1px;
                    border-color: fin.has-focus ? Tokens.accent : Tokens.border-strong;
                    background: Tokens.card;
                    fin := TextInput {
                        x: Tokens.sp1;
                        width: parent.width - 2 * Tokens.sp1;
                        vertical-alignment: center;
                        text: root.col-filter-values.length > c ? root.col-filter-values[c] : "";
                        color: Tokens.text;
                        font-family: Tokens.mono;
                        font-size: Tokens.font-xs;
                        single-line: true;
                        // filter live as the user types (no Enter needed)
                        edited => { root.set-col-filter(c, self.text); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; background: Tokens.chrome; }
        }
        if root.filter-open: Rectangle { height: 1px; background: Tokens.border; }
            }
        }
        // ----- rows: one two-axis Flickable, scrolls both ways; only the
        // on-screen window of rows is instantiated so large results stay smooth -----
        la := Rectangle {
            vertical-stretch: 1;
            clip: true;
            flick := Flickable {
                width: 100%;
                height: 100%;
                viewport-width: max(hdr.preferred-width, la.width);
                viewport-height: root.row-count * Tokens.grid-row-h;

        // ----- rows (24px): windowed — `r` is the real row index -----
        for i in root.win-count: Rectangle {
            property <int> r: root.first-row + i;
            y: r * Tokens.grid-row-h;
            width: flick.viewport-width;
            height: Tokens.grid-row-h;
            property <bool> row-deleted: root.cells[r * root.col-count].state == 2;
            property <bool> row-inserted: root.cells[r * root.col-count].state == 3;
            background: row-deleted ? Tokens.error-tint
                : row-inserted ? Tokens.ok-tint
                : r == root.selected-row ? Tokens.accent-tint.with-alpha(0.55)
                : row-ta.has-hover ? Tokens.chrome.with-alpha(0.6)
                : transparent;
            // Empty: the Flickables own the wheel now; this only tracks hover.
            row-ta := TouchArea { }
            HorizontalLayout {
                // row-number gutter
                Rectangle {
                    width: 44px;
                    Text {
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        x: 0;
                        width: parent.width - Tokens.sp2;
                        text: r + 1;
                        color: Tokens.text-faint;
                        font-family: Tokens.mono;
                        font-size: Tokens.font-xs;
                    }
                    Rectangle { width: 1px; x: parent.width - 1px; background: Tokens.border; }
                }
                for c in root.col-count: Rectangle {
                    property <GridCell> cell: root.cells[r * root.col-count + c];
                    property <bool> is-selected: r == root.selected-row && c == root.selected-col;
                    property <bool> is-fk: root.columns[c].type-name == "fk";
                    property <bool> is-bar: root.columns[c].type-name == "bar";
                    property <bool> is-num: root.columns[c].type-name == "int4"
                        || root.columns[c].type-name == "int8"
                        || root.columns[c].type-name == "numeric";
                    width: root.col-widths.length > c ? root.col-widths[c] : 140px;
                    clip: !(r == root.editing-row && c == root.editing-col);
                    background: transparent;
                    cell-ta := TouchArea {
                        clicked => { root.select-cell(r, c); }
                        // Stash the value so the read-only inspector card can show
                        // it directly (editable grids reopen the inline overlay).
                        double-clicked => { root.editing-value = cell.text; root.edit-cell(r, c); }
                    }
                    if !is-bar: Text {
                        vertical-alignment: center;
                        horizontal-alignment: is-num ? right : left;
                        x: Tokens.sp2;
                        width: parent.width - 2 * Tokens.sp2;
                        overflow: elide;
                        text: cell.is-null ? "NULL"
                            : is-fk ? cell.text + " ↗" : cell.text;
                        color: cell.is-null ? Tokens.text-ghost
                            : is-fk ? Tokens.fk-text : Tokens.text;
                        font-italic: cell.is-null;
                        font-family: Tokens.mono;
                        font-size: Tokens.font-sm;
                    }
                    // share bar: tinted track + accent fill scaled by 0..1
                    if is-bar: Rectangle {
                        x: Tokens.sp2;
                        width: parent.width - 2 * Tokens.sp2;
                        height: 8px;
                        border-radius: 4px;
                        background: Tokens.accent-tint;
                        Rectangle {
                            x: 0;
                            width: parent.width * min(1.0, max(0.0, cell.text.to-float()));
                            height: parent.height;
                            border-radius: 4px;
                            background: Tokens.accent.with-alpha(0.55);
                        }
                    }
                    // strikethrough for delete-marked rows
                    if row-deleted: Rectangle {
                        height: 1px;
                        y: parent.height / 2;
                        background: Tokens.error;
                    }
                    // column hairline
                    Rectangle { width: 1px; x: parent.width - 1px; background: Tokens.border; }
                    // pending (uncommitted) edit: 2px red outline
                    if cell.state == 1: Rectangle {
                        border-width: 2px;
                        border-color: Tokens.edit-outline;
                        background: transparent;
                    }
                    // selected-cell accent frame
                    if is-selected && cell.state != 1: Rectangle {
                        border-width: 1.5px;
                        border-color: Tokens.accent;
                        background: transparent;
                    }
                    // inline editor overlay (editable grids only; a read-only
                    // result opens the centered inspector card instead)
                    if r == root.editing-row && c == root.editing-col && !root.read-only: Rectangle {
                        property <bool> compact-editor: root.is-boolean(root.columns[c].type-name)
                            || root.is-date(root.columns[c].type-name);
                        property <length> editor-w: self.compact-editor ? parent.width
                            : max(parent.width, min(520px, root.width - 2 * Tokens.sp2));
                        property <length> visible-x: parent.x + flick.viewport-x;
                        z: 100;
                        x: self.compact-editor ? 0px
                            : max(-self.visible-x, min(0px, root.width - self.visible-x - self.editor-w));
                        width: self.editor-w;
                        // Rows are fixed height now, so a multi-line editor floats
                        // taller over the rows below (z:100) instead of growing one.
                        height: self.compact-editor ? parent.height : 96px;
                        background: Tokens.card;
                        border-width: 2px;
                        // Read-only view is a value inspector, not a pending
                        // edit — neutral border so it doesn't mimic the orange
                        // edit-outline cue.
                        border-color: root.read-only ? Tokens.border-strong : Tokens.edit-outline;
                        if !root.read-only && root.is-boolean(root.columns[c].type-name): ComboBox {
                            x: 1px;
                            y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            model: ["true", "false"];
                            current-value: cell.is-null ? "" : cell.text;
                            selected(value) => {
                                root.editing-value = value;
                                root.cell-edited(r, c, value);
                            }
                        }
                        if !root.read-only && root.is-date(root.columns[c].type-name): HorizontalLayout {
                            padding-left: Tokens.sp2;
                            padding-right: 2px;
                            spacing: Tokens.sp1;
                            date-input := TextInput {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: cell.is-null ? "" : cell.text;
                                edited => { root.editing-value = self.text; }
                                color: Tokens.text;
                                font-family: Tokens.mono;
                                font-size: Tokens.font-sm;
                                single-line: true;
                                accepted => { root.cell-edited(r, c, self.text); }
                                key-pressed(e) => {
                                    if (e.text == Key.Escape) { root.edit-cancelled(); return accept; }
                                    return reject;
                                }
                                init => { self.focus(); self.select-all(); }
                            }
                            Rectangle {
                                width: 22px;
                                Text {
                                    text: "▣";
                                    color: Tokens.text-dim;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.date-row = r;
                                        root.date-col = c;
                                        date-picker.show();
                                    }
                                }
                            }
                        }
                        if root.read-only || (!root.is-boolean(root.columns[c].type-name) && !root.is-date(root.columns[c].type-name)): edit-input := TextInput {
                            x: Tokens.sp2;
                            y: Tokens.sp1;
                            width: parent.width - 2 * Tokens.sp2;
                            height: parent.height - 2 * Tokens.sp1;
                            vertical-alignment: top;
                            // Read-only view: selectable + copyable, edits blocked.
                            read-only: root.read-only;
                            text: cell.is-null ? "" : cell.text;
                            edited => { root.editing-value = self.text; }
                            color: Tokens.text;
                            font-family: Tokens.mono;
                            font-size: Tokens.font-sm;
                            single-line: false;
                            wrap: word-wrap;
                            accepted => { if (!root.read-only) { root.cell-edited(r, c, self.text); } }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.edit-cancelled();
                                    return accept;
                                }
                                // Read-only view: let selection/copy shortcuts
                                // through, don't commit or advance.
                                if (root.read-only) { return reject; }
                                if (e.text == Key.Return) {
                                    root.cell-edited(r, c, self.text);
                                    return accept;
                                }
                                if (e.text == Key.Tab || e.text == Key.Backtab) {
                                    root.cell-advance(r, c, self.text,
                                        e.text == Key.Tab && !e.modifiers.shift);
                                    return accept;
                                }
                                return reject;
                            }
                            init => { self.focus(); self.select-all(); }
                        }
                    }
                }
                // trailing filler so the row spans the full width
                Rectangle { horizontal-stretch: 1; }
            }
        }
            }
            // ----- vertical scrollbar (a Flickable draws none) -----
            if flick.viewport-height > flick.height + 1px: Rectangle {
                x: parent.width - self.width - 2px;
                y: 0;
                width: 8px;
                height: parent.height;
                property <length> scroll-range: flick.viewport-height - flick.height;
                property <length> drag-start;
                vthumb := Rectangle {
                    width: parent.width;
                    height: max(28px, parent.height * flick.height / flick.viewport-height);
                    y: parent.scroll-range > 0
                        ? (parent.height - self.height) * (-flick.viewport-y / parent.scroll-range)
                        : 0px;
                    border-radius: 4px;
                    background: vsb.pressed || vsb.has-hover ? Tokens.text-faint : Tokens.border-strong;
                }
                vsb := TouchArea {
                    pointer-event(e) => { if (e.kind == PointerEventKind.down) { parent.drag-start = flick.viewport-y; } }
                    moved => {
                        if (parent.scroll-range > 0 && parent.height > vthumb.height) {
                            flick.viewport-y = clamp(parent.drag-start
                                - (self.mouse-y - self.pressed-y) * (parent.scroll-range / (parent.height - vthumb.height)),
                                -parent.scroll-range, 0px);
                        }
                    }
                }
            }
            // ----- horizontal scrollbar (drives the Flickable's viewport-x) -----
            if flick.viewport-width > la.width + 1px: Rectangle {
                x: 0;
                y: parent.height - self.height - 2px;
                width: parent.width - 2px;
                height: 8px;
                property <length> scroll-range: flick.viewport-width - la.width;
                property <length> drag-start;
                hthumb := Rectangle {
                    height: parent.height;
                    width: max(28px, parent.width * la.width / flick.viewport-width);
                    x: parent.scroll-range > 0
                        ? (parent.width - self.width) * (-flick.viewport-x / parent.scroll-range)
                        : 0px;
                    border-radius: 4px;
                    background: hsb.pressed || hsb.has-hover ? Tokens.text-faint : Tokens.border-strong;
                }
                hsb := TouchArea {
                    pointer-event(e) => { if (e.kind == PointerEventKind.down) { parent.drag-start = flick.viewport-x; } }
                    moved => {
                        if (parent.scroll-range > 0 && parent.width > hthumb.width) {
                            flick.viewport-x = clamp(parent.drag-start
                                - (self.mouse-x - self.pressed-x) * (parent.scroll-range / (parent.width - hthumb.width)),
                                -parent.scroll-range, 0px);
                        }
                    }
                }
            }
        }
    }

    date-picker := DatePickerPopup {
        title: "Select date";
        accepted(d) => {
            if (root.date-row >= 0 && root.date-col >= 0) {
                root.cell-edited(root.date-row, root.date-col,
                    "\{d.year}-" + (d.month < 10 ? "0" : "") + "\{d.month}-"
                    + (d.day < 10 ? "0" : "") + "\{d.day}");
            }
        }
    }

    // Read-only cell inspector: a centered card with the full value, opened by
    // double-click on a result cell. Selectable + auto-selected so ⌘C copies.
    if root.read-only && root.editing-row >= 0 && root.editing-col >= 0: Rectangle {
        background: #00000088;
        // backdrop click closes
        TouchArea { clicked => { root.edit-cancelled(); } }
        Rectangle {
            width: min(560px, root.width - 4 * Tokens.sp3);
            height: min(360px, root.height - 4 * Tokens.sp3);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Tokens.card;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            // swallow clicks inside the card so they don't close it
            TouchArea {}
            VerticalLayout {
                padding: Tokens.sp3;
                spacing: Tokens.sp2;
                HorizontalLayout {
                    Text {
                        text: "Cell value";
                        horizontal-stretch: 1;
                        color: Tokens.text;
                        font-weight: Tokens.weight-emphasis;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "⌘C to copy · Esc to close";
                        color: Tokens.text-faint;
                        font-size: Tokens.font-xs;
                        vertical-alignment: center;
                    }
                }
                // TextEdit owns its own viewport/scrollbar, so a large value
                // wraps and scrolls reliably (the old ScrollView+TextInput had a
                // cyclic height dependency that broke scrolling on big values).
                detail-input := TextEdit {
                    vertical-stretch: 1;
                    read-only: true;
                    text: root.editing-value;
                    wrap: word-wrap;
                    font-family: Tokens.mono;
                    font-size: Tokens.font-sm;
                    init => { self.focus(); self.select-all(); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) { root.edit-cancelled(); return accept; }
                        return reject;
                    }
                }
                // Say *why* this is view-only: a manual query result has no row
                // identity, so open the table itself to edit or insert.
                Text {
                    text: "View-only — query results have no row identity. Open the table to edit or add rows.";
                    color: Tokens.text-faint;
                    font-size: Tokens.font-xs;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// Shared Tabula components. All colors/metrics come from Tokens.
import { Tokens } from "tokens.slint";
import { AppIcon, AppIcons } from "icons.slint";
import { PaletteItem } from "structs.slint";
import { ScrollView } from "std-widgets.slint";
import {
    Elevation, IconButton as MaterialIconButton,
    MaterialPalette, MaterialStyleMetrics, MaterialTypography, StateLayer, StateLayerArea, Switch, Icon,
    MenuItem as MaterialMenuItem, SegmentedButton,
    NavigationItem as MaterialNavigationItem
} from "@material";

// App-owned outlined text input. Material's stock field stays untouched; the
// app uses a compact, fully outlined variant in forms and filters.
export component AppTextField {
    in property <string> label;
    in property <string> supporting-text;
    in property <bool> has-error;
    in property <image> leading-icon;
    in property <image> trailing-icon;
    in property <bool> enabled: true;
    in property <bool> read-only <=> input.read-only;
    out property <bool> has-focus: input.has-focus;
    in-out property <string> text <=> input.text;
    in property <InputType> input-type <=> input.input-type;
    callback leading-icon-clicked();
    callback trailing-icon-clicked();
    callback accepted(string);
    callback edited(string);
    callback key-pressed(event: KeyEvent) -> EventResult;
    callback key-released(event: KeyEvent) -> EventResult;
    property <color> highlight: root.enabled && root.has-error ? MaterialPalette.error
        : root.has-focus ? MaterialPalette.primary : MaterialPalette.outline_variant;
    property <bool> has-leading: root.leading-icon.width > 0 && root.leading-icon.height > 0;
    property <bool> has-trailing: root.trailing-icon.width > 0 && root.trailing-icon.height > 0;
    property <length> computed-x;
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.label;
    accessible-action-set-value(value) => { root.text = value; root.edited(value); }
    layout := VerticalLayout {
        spacing: MaterialStyleMetrics.spacing_4;
        Rectangle {
            border-radius: 8px;
            border-width: root.has-focus ? 2px : 1px;
            border-color: root.highlight;
            background: MaterialPalette.surface_container_low;
            min-height: max(36px, inner.min-height);
            inner := HorizontalLayout {
                padding-left: root.has-leading ? 10px : 12px;
                padding-right: root.has-trailing ? 6px : 12px;
                spacing: MaterialStyleMetrics.spacing_8;
                if root.has-leading: Rectangle {
                    width: 20px;
                    height: 20px;
                    Icon { source: root.leading-icon; colorize: MaterialPalette.on_surface_variant; }
                    TouchArea {
                        enabled: root.enabled;
                        clicked => { root.leading-icon-clicked(); }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    min-height: input.min-height;
                    input := TextInput {
                        x: min(0px, max(parent.width - self.width - self.text-cursor-width, root.computed-x));
                        width: max(parent.width - self.text-cursor-width, self.preferred-width);
                        height: 100%;
                        font-size: MaterialTypography.body_medium.font_size;
                        font-weight: MaterialTypography.body_medium.font_weight;
                        text-cursor-width: 2px;
                        vertical-alignment: center;
                        single-line: true;
                        color: MaterialPalette.on_surface;
                        selection-background-color: MaterialPalette.primary.with-alpha(0.5);
                        selection-foreground-color: self.color;
                        enabled: root.enabled;
                        accessible-role: none;
                        cursor-position-changed(position) => {
                            if position.x + root.computed-x < 0 {
                                root.computed-x = -position.x;
                            } else if position.x + root.computed-x > parent.width - self.text-cursor-width {
                                root.computed-x = parent.width - position.x - self.text-cursor-width;
                            }
                        }
                        accepted => { root.accepted(self.text); }
                        edited => { root.edited(self.text); }
                        key-pressed(event) => { root.key-pressed(event) }
                        key-released(event) => { root.key-released(event) }
                    }
                    Text {
                        y: (parent.height - self.height) / 2;
                        width: 100%;
                        text: root.label;
                        color: MaterialPalette.on_surface_variant.with-alpha(0.72);
                        font-size: MaterialTypography.body_medium.font_size;
                        visible: root.text == "";
                    }
                }
                if root.has-trailing: Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: trailing-area.has-hover ? MaterialPalette.on_surface.with-alpha(0.08) : transparent;
                    Icon {
                        source: root.trailing-icon;
                        colorize: root.has-error ? MaterialPalette.error : MaterialPalette.on_surface_variant;
                    }
                    trailing-area := TouchArea {
                        enabled: root.enabled;
                        clicked => { root.trailing-icon-clicked(); }
                    }
                }
            }
        }
        if root.supporting-text != "": Text {
            text: root.supporting-text;
            color: root.highlight;
            font-size: MaterialTypography.body_small.font_size;
        }
    }
    public function set_selection_offsets(start: int, end: int) { input.set_selection_offsets(start, end); }
    public function select_all() { input.select_all(); }
    public function clear_selection() { input.clear_selection(); }
    public function cut() { input.cut(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }
    states [
        disabled when !root.enabled : {
            input.opacity: MaterialPalette.disable_opacity;
        }
    ]
}

// On/off switch (Material). Stays controlled: the owner holds `checked` and
// flips it in `toggled`. Material's Switch flips itself on click, which
// drops its binding, so `changed checked` re-syncs it from the owner and
// `toggled` only fires when the two disagree (no echo on the re-sync).
export component Toggle {
    in property <bool> checked;
    callback toggled();
    // Switch only sets a minimum and stretches to whatever it is given, which
    // left it floating off the right edge of settings rows. Pin its M3 size.
    width: MaterialStyleMetrics.size_52;
    height: MaterialStyleMetrics.size_32;
    sw := Switch {
        checked: root.checked;
        checked-state-changed(c) => {
            if c != root.checked {
                root.toggled();
            }
        }
    }
    changed checked => { sw.checked = root.checked; }
}

// A settings line: label (+ optional one-line description) on the left,
// toggle on the right.
export component ToggleRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description: "";
    in property <bool> checked;
    callback toggled();
    spacing: Tokens.sp3;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            color: Tokens.text;
            font-size: Tokens.font-md;
        }
        if root.description != "": Text {
            text: root.description;
            color: Tokens.text-dim;
            font-size: Tokens.font-xs;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        Toggle {
            checked: root.checked;
            toggled => { root.toggled(); }
        }
    }
}

// Settings row choosing between two options. A row that doesn't apply under
// the current settings stays visible but dimmed and inert, so the dependency
// between settings is readable instead of rows appearing and vanishing.
export component ChoiceRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description: "";
    in property <string> option-a;
    in property <string> option-b;
    in property <int> index;
    in property <bool> enabled: true;
    callback chosen(int);
    spacing: Tokens.sp3;
    opacity: root.enabled ? 1 : 0.45;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            color: Tokens.text;
            font-size: Tokens.font-md;
        }
        if root.description != "": Text {
            text: root.description;
            color: Tokens.text-dim;
            font-size: Tokens.font-xs;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        Rectangle {
            sb := SegmentedButton {
                items: [{ text: root.option-a }, { text: root.option-b }];
                current-index: root.index;
                index-changed(i) => {
                    if i != root.index {
                        root.chosen(i);
                    }
                }
            }
            // Swallows clicks while disabled; the button itself has no
            // enabled state.
            if !root.enabled: TouchArea { }
        }
    }
    changed index => { sb.current-index = root.index; }
}

// A small uppercase-ish section label for grouping settings rows, with a
// hairline divider below.
export component SettingsSectionHeader inherits VerticalLayout {
    in property <string> label;
    spacing: Tokens.sp1;
    Text {
        text: root.label;
        color: Tokens.text-dim;
        font-size: Tokens.font-xs;
        font-weight: Tokens.weight-emphasis;
    }
    Rectangle { height: 1px; background: Tokens.border; }
}

// Shared tooltip state. Buttons report their hovered tooltip + window-space
// anchor here; a single overlay in app-window.slint draws it on the top layer
// so it is never clipped by content painted after the toolbar row.
export global Tooltip {
    in-out property <string> text;
    in-out property <length> x;   // window coords: button center-x
    in-out property <length> y;   // window coords: just below the button
    in-out property <length> max-width: 360px;
    in-out property <bool> shown;
}

// Display labels follow the desktop convention while the input handlers use
// Slint's platform-independent Control/Meta modifier checks.
export global Shortcut {
    in-out property <string> primary: "⌘";
    in-out property <string> shift: "⇧";
    in-out property <string> separator: "";
    in-out property <string> enter: "↩";
    in-out property <string> backspace: "⌫";
}

// TouchArea that reports its own hover to the shared Tooltip overlay, for the
// bare Rectangle + TouchArea controls (tab chips, toolbar chips) that aren't
// one of the button components below.
export component TooltipArea inherits TouchArea {
    in property <string> tip;
    changed has-hover => {
        if self.has-hover && root.tip != "" {
            Tooltip.text = root.tip;
            Tooltip.x = self.absolute-position.x + self.width / 2;
            Tooltip.y = self.absolute-position.y + self.height + 4px;
            Tooltip.shown = true;
        } else if Tooltip.text == root.tip {
            Tooltip.shown = false;
        }
    }
}

// Dropdown select: shows the current value + a ▾ caret so it reads as a
// picker even when closed, then a click opens a themed option list. Replaces
// std-widgets ComboBox, which rendered as a blank borderless box in this theme.
// Full-color brand mark for the engine picker (icons/brand/*.svg) — distinct
// from AppIcon, which always `colorize`s to one flat tint. Engines with no
// official mark shipped (e.g. SQL Server — none hand-drawn, per operator's
// call) render nothing rather than a fabricated logo; the row's own text
// label still carries the name.
component EngineLogo inherits Image {
    in property <string> label;
    width: 16px;
    height: 16px;
    image-fit: contain;
    source:
        label == "PostgreSQL" ? @image-url("icons/brand/postgres.svg")
        : label == "MySQL" ? @image-url("icons/brand/mysql.svg")
        : label == "MariaDB" ? @image-url("icons/brand/mariadb.svg")
        : label == "Redis" ? @image-url("icons/brand/redis.svg")
        : label == "Valkey" ? @image-url("icons/brand/valkey.svg")
        : label == "MongoDB" ? @image-url("icons/brand/mongo.svg")
        : label == "SQLite" ? @image-url("icons/brand/sqlite.svg")
        : label == "Cassandra" ? @image-url("icons/brand/cassandra.svg")
        : label == "ClickHouse" ? @image-url("icons/brand/clickhouse.svg")
        : label == "Oracle" ? @image-url("icons/brand/oracle.svg")
        : @image-url("");
}

// String-valued dropdown (model + current-value) drawn as a Material outlined
// field with a Material menu. Material's own DropDownMenu is index-based,
// which the Rust-fed, string-bound selects (Engine, SSL, Group, filter
// column/operator) can't use; the closed field is composed here instead of
// wrapping TextField so the Engine picker keeps its full-color brand logos
// (TextField tints its icons to one color).
export component SelectBox {
    in property <[string]> model;
    in-out property <string> current-value;
    // Opt-in: prefixes the current value and every option row with its
    // brand logo (EngineLogo). Only the connection form's Engine dropdown
    // sets this — every other SelectBox (SSL mode, Group, …) is unaffected.
    in property <bool> show-logo: false;
    callback selected(string);
    min-height: 36px;
    accessible-role: combobox;
    accessible-value: root.current-value;
    Rectangle {
        // Match the outlined text fields while retaining the engine brand logo.
        clip: true;
        border-radius: 8px;
        border-width: 1px;
        border-color: ta.has-hover ? MaterialPalette.outline : MaterialPalette.outline_variant;
        background: MaterialPalette.surface_container_low;
        StateLayer {
            width: 100%;
            height: 100%;
            background: MaterialPalette.on_surface;
            has-hover: ta.has-hover;
            enabled: true;
        }
        HorizontalLayout {
            padding-left: MaterialStyleMetrics.padding_16;
            padding-right: MaterialStyleMetrics.padding_12;
            spacing: MaterialStyleMetrics.spacing_8;
            if root.show-logo: VerticalLayout {
                alignment: center;
                EngineLogo { label: root.current-value; }
            }
            Text {
                text: root.current-value;
                color: MaterialPalette.on_surface;
                font-size: MaterialTypography.body_medium.font_size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                AppIcon { name: "caret"; size: MaterialStyleMetrics.icon_size_18; color: MaterialPalette.on_surface_variant; }
            }
        }
    }
    ta := TouchArea {
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        close-policy: close-on-click-outside;
        Rectangle {
            background: MaterialPalette.surface_container_high;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            border-radius: MaterialStyleMetrics.border_radius_12;
            clip: true;
            drop-shadow-blur: 16px;
            drop-shadow-color: MaterialPalette.shadow.with-alpha(0.35);
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                for opt in root.model: Rectangle {
                    height: 36px;
                    Rectangle {
                        x: 5px;
                        y: 2px;
                        width: parent.width - 10px;
                        height: parent.height - 4px;
                        border-radius: 7px;
                        background: opt-ta.has-hover ? Tokens.accent
                            : (opt == root.current-value ? MaterialPalette.secondary_container : transparent);
                    }
                    // Emit before closing: closing the popup first cancels
                    // the rest of this handler.
                    opt-ta := TouchArea {
                        clicked => {
                            root.current-value = opt;
                            root.selected(opt);
                            popup.close();
                        }
                    }
                    HorizontalLayout {
                        padding-left: MaterialStyleMetrics.padding_12;
                        padding-right: MaterialStyleMetrics.padding_12;
                        spacing: MaterialStyleMetrics.spacing_8;
                        if root.show-logo: VerticalLayout {
                            alignment: center;
                            EngineLogo { label: opt; }
                        }
                        Text {
                            text: opt;
                            color: opt-ta.has-hover ? white : MaterialPalette.on_surface;
                            font-size: MaterialTypography.body_medium.font_size;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Popup menu surface in the Material look (and the app's 12px rule): one row
// per item, state-layer hover, an optional destructive row in the error
// colour. The caller owns the PopupWindow (placement differs everywhere) and
// closes it after `activated`.
export component AppMenu inherits Rectangle {
    in property <[string]> items;
    in property <int> danger-index: -1;
    callback activated(int);
    background: MaterialPalette.surface_container_high;
    border-width: 1px;
    border-color: MaterialPalette.outline_variant;
    border-radius: 10px;
    clip: true;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: MaterialPalette.shadow.with-alpha(0.42);
    VerticalLayout {
        padding-top: 5px;
        padding-bottom: 5px;
        for label[i] in root.items: Rectangle {
            property <bool> is-sep: label == "---";
            property <bool> is-danger: i == root.danger-index;
            height: is-sep ? 9px : 32px;
            if is-sep: Rectangle {
                x: 10px;
                y: 4px;
                width: parent.width - 20px;
                height: 1px;
                background: MaterialPalette.outline_variant.with-alpha(0.65);
            }
            if !is-sep: Rectangle {
                x: 5px;
                y: 2px;
                width: parent.width - 10px;
                height: parent.height - 4px;
                border-radius: 6px;
                background: row-ta.has-hover
                    ? (is-danger ? MaterialPalette.error : Tokens.accent)
                    : transparent;
            }
            if !is-sep: HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: label;
                    color: row-ta.has-hover ? white
                        : (is-danger ? MaterialPalette.error : MaterialPalette.on_surface);
                    font-size: MaterialTypography.body_medium.font_size;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
            // Emits before the caller closes the popup: closing first would
            // cancel the rest of the click handler.
            row-ta := TouchArea {
                enabled: !is-sep;
                clicked => { root.activated(i); }
            }
        }
    }
}

// Compact app-owned indexed dropdown, using the app text-field and popup
// treatment while retaining Material MenuItem selection semantics.
component AppDropDownRow inherits StateLayerArea {
    in property <string> text;
    in property <image> icon;
    in property <string> trailing-text;
    in property <int> index;
    in property <bool> selected;
    callback activated(int);
    height: MaterialStyleMetrics.size_40;
    color: MaterialPalette.on_surface;
    border-radius: 6px;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-item-index: root.index;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        background: root.has-hover ? Tokens.accent
            : (root.selected ? MaterialPalette.secondary_container : transparent);
    }
    HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_12;
        padding-right: MaterialStyleMetrics.padding_12;
        spacing: MaterialStyleMetrics.spacing_8;
        if root.icon.width > 0 && root.icon.height > 0: Icon {
            source: root.icon;
            colorize: root.has-hover ? white : MaterialPalette.on_surface_variant;
            width: MaterialStyleMetrics.icon_size_18;
        }
        Text {
            text: root.text;
            color: root.has-hover ? white
                : (root.enabled ? MaterialPalette.on_surface : MaterialPalette.on_surface.with-alpha(MaterialPalette.disable_opacity));
            font-size: MaterialTypography.body_medium.font_size;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.trailing-text != "": Text {
            text: root.trailing-text;
            color: root.has-hover ? white : MaterialPalette.on_surface_variant;
            font-size: MaterialTypography.body_small.font_size;
            vertical-alignment: center;
        }
    }
    clicked => { root.activated(root.index); }
}

component AppDropDown {
    in property <[MaterialMenuItem]> items;
    in-out property <int> current-index: -1;
    in property <bool> enabled: true;
    in property <string> label;
    in property <image> leading-icon;
    callback selected(int);
    property <length> item-height: MaterialStyleMetrics.size_40;
    property <string> text: "";
    min-width: field.min-width;
    min-height: field.min-height;
    forward-focus: field;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-value: root.text;
    accessible-action-expand => { popup.show(); }
    field := AppTextField {
        width: 100%;
        height: 100%;
        label: root.label;
        text: root.text;
        enabled: root.enabled;
        read-only: true;
        leading-icon: root.leading-icon;
        trailing-icon: AppIcons.get("caret");
        trailing-icon-clicked => { popup.show(); }
    }
    StateLayer {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: MaterialPalette.on_surface;
        has-hover: touch-area.has-hover;
        enabled: root.enabled;
    }
    touch-area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        width: root.width;
        close-policy: close-on-click-outside;
        forward-focus: popup-field;
        VerticalLayout {
            alignment: start;
            popup-field := AppTextField {
                width: root.width;
                leading-icon: root.leading-icon;
                trailing-icon: AppIcons.get("caret");
                text: root.text;
                label: root.label;
                read-only: true;
                trailing-icon-clicked => { popup.close(); }
            }
            Rectangle {
                width: 100%;
                height: min(max(root.item-height, root.items.length * root.item-height), 6 * root.item-height);
                background: MaterialPalette.surface_container_high;
                border-radius: MaterialStyleMetrics.border_radius_12;
                border-width: 1px;
                border-color: MaterialPalette.outline_variant;
                clip: true;
                ScrollView {
                    VerticalLayout {
                        for item[index] in root.items: AppDropDownRow {
                            width: 100%;
                            text: item.text;
                            icon: item.icon;
                            trailing-text: item.trailing_text;
                            index: index;
                            selected: index == root.current-index;
                            enabled: item.enabled;
                            activated(i) => {
                                root.current-index = i;
                                root.update-text();
                                popup.close();
                                root.selected(i);
                            }
                        }
                    }
                }
            }
        }
    }
    function update-text() {
        root.text = root.current-index >= 0 && root.current-index < root.items.length
            ? root.items[root.current-index].text : "";
    }
    init => { root.update-text(); }
    changed current-index => { root.update-text(); }
    changed items => { root.update-text(); }
}

// Indexed dropdown whose selection is owned by the caller.
export component IndexDropDown {
    in property <[MaterialMenuItem]> items;
    in-out property <int> current-index;
    callback selected(int);
    dd := AppDropDown {
        width: 100%;
        items: root.items;
        current-index: root.current-index;
        selected(i) => {
            root.current-index = i;
            root.selected(i);
        }
    }
}

// Engine badge: rounded square with 2-letter code, engine color fill.
export component DbBadge inherits Rectangle {
    in property <string> engine; // "postgres" | "mysql" | "redis" | "sqlite" | "mongo" | "cassandra" | "clickhouse" | "mssql" | "oracle"
    in property <length> size: 24px;
    in property <bool> circular: false;
    // Callers with a per-connection custom accent can override this; the
    // default keeps every existing call site's engine-colored look as-is.
    in property <brush> fill: Tokens.db-color(engine);
    width: self.size;
    height: self.size;
    border-radius: self.circular ? self.size / 2 : self.size * 0.28;
    background: self.fill;
    // Known engine → white brand glyph (icons/db-<engine>.svg via AppIcon).
    property <bool> known: engine == "postgres" || engine == "mysql"
        || engine == "mariadb" || engine == "redis" || engine == "valkey"
        || engine == "sqlite" || engine == "mongo"
        || engine == "cassandra" || engine == "clickhouse" || engine == "oracle";
    // Engines with no real brand mark available (e.g. SQL Server — no
    // official logo shipped, and none hand-drawn per operator's call) get
    // their initials spelled out instead of a fabricated icon or a bare "?".
    // A truly unrecognized engine still falls back to "?".
    property <string> fallback-text: engine == "mssql" ? "MS" : "?";
    if known: AppIcon {
        name: "db-" + engine;
        size: root.size * 0.58;
        color: white;
    }
    if !known: Text {
        text: root.fallback-text;
        color: white;
        font-size: root.size * 0.34;
        font-weight: 700;
    }
}

// Status label chip (LOCAL, env tags). Non-interactive, so it takes the M3
// chip corner and label type rather than Material's clickable chips.
export component OutlineChip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Tokens.ok;
    height: 20px;
    width: label.preferred-width + 2 * MaterialStyleMetrics.padding_8;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: tint.with-alpha(0.55);
    background: tint.with-alpha(0.08);
    label := Text {
        text: root.text;
        color: tint;
        font-size: MaterialTypography.label_small.font_size;
        font-weight: MaterialTypography.label_small.font_weight;
        letter-spacing: 0.5px;
    }
}

// App-owned compact action button, independent of vendored Material defaults.
// Rounded corners, compact metrics and app-selected colors live here rather
// than in the vendored Material button sources.
export component PrimaryButton inherits StateLayerArea {
    in property <image> icon;
    in property <string> text;
    color: MaterialPalette.on_primary;
    border-radius: 8px;
    min-width: max(MaterialStyleMetrics.size_32, content.min-width);
    min-height: MaterialStyleMetrics.size_32;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text == "" ? root.tooltip : root.text;
    accessible-action-default => { root.clicked(); }
    tooltip-offset: root.height / 2 + MaterialStyleMetrics.icon_size_18 / 2 + MaterialStyleMetrics.padding_14;
    elevation := Elevation {
        border-radius: root.border-radius;
        background: MaterialPalette.primary;
        width: 100%;
        height: 100%;
    }
    content := HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_14;
        padding-right: MaterialStyleMetrics.padding_14;
        padding-top: MaterialStyleMetrics.padding_6;
        padding-bottom: MaterialStyleMetrics.padding_6;
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;
        if root.icon.width > 0 && root.icon.height > 0: Icon {
            source: root.icon;
            colorize: root.enabled ? MaterialPalette.on_primary
                : MaterialPalette.on_surface.with-alpha(MaterialPalette.disable_opacity);
            width: MaterialStyleMetrics.icon_size_18;
        }
        Text {
            text: root.text;
            color: root.enabled ? MaterialPalette.on_primary
                : MaterialPalette.on_surface.with-alpha(MaterialPalette.disable_opacity);
            font-size: MaterialTypography.label_large.font_size;
            font-weight: MaterialTypography.label_large.font_weight;
            vertical-alignment: center;
            overflow: clip;
        }
    }
    states [
        disabled when !root.enabled : {
            elevation.background: transparent;
        }
        hover when root.has-hover && !root.pressed && !root.enter-pressed : {
            elevation.level: 1;
        }
    ]
}

// App-owned compact outlined action button.
export component SecondaryButton inherits StateLayerArea {
    in property <image> icon;
    in property <string> text;
    color: MaterialPalette.on_surface;
    border-radius: 8px;
    min-width: max(MaterialStyleMetrics.size_32, content.min-width);
    min-height: MaterialStyleMetrics.size_32;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text == "" ? root.tooltip : root.text;
    accessible-action-default => { root.clicked(); }
    tooltip-offset: root.height / 2 + MaterialStyleMetrics.icon_size_18 / 2 + MaterialStyleMetrics.padding_14;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: root.enabled ? MaterialPalette.outline_variant
            : MaterialPalette.on_surface.with-alpha(MaterialPalette.disable_opacity);
    }
    content := HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_14;
        padding-right: MaterialStyleMetrics.padding_14;
        padding-top: MaterialStyleMetrics.padding_6;
        padding-bottom: MaterialStyleMetrics.padding_6;
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;
        if root.icon.width > 0 && root.icon.height > 0: Icon {
            source: root.icon;
            colorize: root.enabled ? MaterialPalette.on_surface : MaterialPalette.on_surface.with-alpha(MaterialPalette.disable_opacity);
            width: MaterialStyleMetrics.icon_size_18;
        }
        Text {
            text: root.text;
            color: root.enabled ? MaterialPalette.on_surface : MaterialPalette.on_surface.with-alpha(MaterialPalette.disable_opacity);
            font-size: MaterialTypography.label_large.font_size;
            font-weight: MaterialTypography.label_large.font_weight;
            vertical-alignment: center;
            overflow: clip;
        }
    }
}

// Destructive / warning action (Cancel a running query, abort a stream).
// Material's outlined-button shape in the error color, so it reads as "stop
// this". Built on StateLayerArea (hover/press layer + ripple) because the
// Material buttons hard-wire their color to the primary role.
export component DangerButton inherits StateLayerArea {
    in property <string> text;
    color: Tokens.error;
    border-radius: 8px;
    min-width: label.preferred-width + 2 * MaterialStyleMetrics.padding_14;
    preferred-width: self.min-width;
    min-height: MaterialStyleMetrics.size_32;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    Rectangle {
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: root.enabled ? Tokens.error : Tokens.text-ghost;
    }
    label := Text {
        text: root.text;
        color: root.enabled ? Tokens.error : Tokens.text-ghost;
        font-size: MaterialTypography.label_large.font_size;
        font-weight: MaterialTypography.label_large.font_weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Plain text action button with compact app dimensions and Material state layers.
export component TextButton inherits StateLayerArea {
    in property <image> icon;
    in property <string> text;
    in property <bool> inverse;
    color: root.enabled ? (root.inverse ? MaterialPalette.inverse_primary : MaterialPalette.primary)
        : MaterialPalette.on_surface;
    border-radius: root.height / 2;
    min-width: max(MaterialStyleMetrics.size_32, content.min-width);
    min-height: MaterialStyleMetrics.size_32;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text == "" ? root.tooltip : root.text;
    accessible-action-default => { root.clicked(); }
    tooltip-offset: root.height / 2 + MaterialStyleMetrics.icon_size_18 / 2 + MaterialStyleMetrics.padding_14;
    content := HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_14;
        padding-right: MaterialStyleMetrics.padding_14;
        padding-top: MaterialStyleMetrics.padding_6;
        padding-bottom: MaterialStyleMetrics.padding_6;
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;
        if root.icon.width > 0 && root.icon.height > 0: Icon {
            source: root.icon;
            colorize: root.enabled ? (root.inverse ? MaterialPalette.inverse_primary : MaterialPalette.primary)
                : MaterialPalette.on_surface.with-alpha(MaterialPalette.disable_opacity);
            width: MaterialStyleMetrics.icon_size_18;
        }
        Text {
            text: root.text;
            color: root.enabled ? (root.inverse ? MaterialPalette.inverse_primary : MaterialPalette.primary)
                : MaterialPalette.on_surface.with-alpha(MaterialPalette.disable_opacity);
            font-size: MaterialTypography.label_large.font_size;
            font-weight: MaterialTypography.label_large.font_weight;
            vertical-alignment: center;
            overflow: clip;
        }
    }
    states [
        disabled when !root.enabled : {
            transparent-background: true;
        }
    ]
}

// Export dropdown: the same Material text button as TextButton, so it aligns
// and spaces with the other toolbar buttons, but opens a format menu.
// `export(i)` reports the chosen row index into the option list below.
export component ExportButton {
    in property <string> tooltip;            // optional hover label
    in property <bool> enabled: true;
    callback export(int);
    TextButton {
        enabled: root.enabled;
        text: "Export ▾";
        tooltip: root.tooltip;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        // Default close-on-click swallows the press and closes before the inner
        // row TouchArea completes its click, so export(i) never fired. Only
        // auto-close on clicks outside the menu.
        close-policy: close-on-click-outside;
        x: 0;
        y: parent.height + 2px;
        width: 200px;
        // No explicit height: let the popup size to its content. Binding it to
        // the child's preferred-height is a parent↔child cycle that collapses
        // the popup to zero, so the menu never appears (see SelectBox above).
        AppMenu {
            items: ["CSV", "JSON", "TSV", "SQL INSERT", "Markdown"];
            activated(i) => { root.export(i); menu.close(); }
        }
    }
}

// Form text input (conn form): outlined field with a static placeholder.
export component FormField {
    in property <string> placeholder;
    in-out property <string> text <=> tf.text;
    in property <InputType> input-type <=> tf.input-type;
    callback accepted(string);
    min-height: 36px;
    forward-focus: tf;
    Rectangle {
        clip: true;
        border-radius: 8px;
        tf := AppTextField {
            width: 100%;
            height: 100%;
            label: root.placeholder;
            accepted(t) => { root.accepted(t); }
        }
    }
}

// Small bordered key cap (⌘K, ⌘P, ⌘↵).
export component KeyCap inherits Rectangle {
    in property <string> text;
    height: Tokens.font-base + 5px;
    width: label.preferred-width + 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Tokens.border;
    background: Tokens.card;
    label := Text {
        text: root.text;
        color: Tokens.text-faint;
        font-size: Tokens.font-xs;
    }
}

// Titlebar search / command pill. Material's SearchBar is a live search field
// with its own result list; this one opens the command palette instead, so it
// keeps its button behavior and takes the M3 search-bar look: full pill,
// surface-container-high, state-layer hover.
export component SearchCommandPill inherits Rectangle {
    in property <string> placeholder: "Search or run a command...";
    callback activated;
    height: 34px;
    border-radius: 8px;
    // surface-container-high maps to the titlebar chrome itself, which made the
    // pill vanish into the bar; one step lighter plus an outline keeps it found.
    background: MaterialPalette.surface_container;
    border-width: 1px;
    border-color: MaterialPalette.outline_variant;
    StateLayer {
        width: 100%;
        height: 100%;
        background: MaterialPalette.on_surface;
        border-radius: root.border-radius;
        has-hover: ta.has-hover;
        enabled: true;
    }
    HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_16;
        padding-right: MaterialStyleMetrics.padding_8;
        spacing: MaterialStyleMetrics.spacing_8;
        VerticalLayout {
            alignment: center;
            AppIcon { name: "search"; size: MaterialStyleMetrics.icon_size_18; color: MaterialPalette.on_surface_variant; }
        }
        Text {
            text: root.placeholder;
            color: MaterialPalette.on_surface_variant;
            font-size: MaterialTypography.body_medium.font_size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            KeyCap { text: Shortcut.primary + Shortcut.separator + "K"; }
        }
    }
    ta := TouchArea { clicked => { root.activated(); } }
}

// Breadcrumb chip (titlebar connection / database / schema): Material
// assist-chip shape — 32px, 8px corners, outline, state-layer hover — keeping
// the status dot, caret and mono label, which Material's ActionChip has no
// slots for.
export component BreadcrumbChip inherits Rectangle {
    in property <string> text;
    in property <bool> show-dot: false;
    in property <color> dot-color: Tokens.ok;
    in property <bool> caret: false;
    in property <bool> mono: false;
    in property <string> tooltip;            // optional hover label
    callback clicked;
    // 40px like every titlebar control (Material buttons can't go lower).
    height: 30px;
    width: content.preferred-width + 2 * MaterialStyleMetrics.padding_10;
    border-radius: 8px;
    border-width: 1px;
    border-color: MaterialPalette.outline_variant;
    background: MaterialPalette.surface_container_low;
    StateLayer {
        width: 100%;
        height: 100%;
        background: MaterialPalette.on_surface;
        border-radius: root.border-radius;
        has-hover: ta.has-hover;
        enabled: true;
    }
    content := HorizontalLayout {
        alignment: center;
        spacing: Tokens.sp2;
        if root.show-dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.dot-color;
            }
        }
        Text {
            text: root.text;
            color: MaterialPalette.on_surface;
            font-size: MaterialTypography.label_large.font_size;
            font-weight: MaterialTypography.label_large.font_weight;
            font-family: root.mono ? Tokens.mono : "";
            vertical-alignment: center;
        }
        if root.caret: Text {
            text: "▾";
            color: Tokens.text-faint;
            font-size: 9px;
            vertical-alignment: center;
        }
    }
    ta := TooltipArea {
        tip: root.tooltip;
        clicked => { root.clicked(); }
    }
}

// Result-pane footer tabs (Data/Structure/Indexes · Data/Message/Chart),
// drawn like the document tabs: a pill hover and a 3px indicator exactly as
// wide as the label, centred under it. Material's tab bars didn't fit here —
// the secondary bar's indicator ran into the next tab, the primary bar's was
// sized off its own label measurement and left a focus tint after a click.
// Controlled: `current` comes from the owner, clicks only report `picked`.
export component FooterTabs {
    in property <[MaterialNavigationItem]> items;
    in property <int> current;
    callback picked(int);
    min-height: 40px;
    HorizontalLayout {
        for item[i] in root.items: Rectangle {
            width: 96px;
            StateLayer {
                x: 4px;
                y: 6px;
                width: parent.width - 8px;
                height: parent.height - 12px;
                border-radius: self.height / 2;
                background: MaterialPalette.on_surface;
                has-hover: tab-ta.has-hover;
                enabled: true;
            }
            label := Text {
                text: item.text;
                color: i == root.current ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                font-size: MaterialTypography.title_small.font_size;
                font-weight: MaterialTypography.title_small.font_weight;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if i == root.current: Rectangle {
                x: (parent.width - label.preferred-width) / 2;
                y: parent.height - self.height;
                width: label.preferred-width;
                height: 3px;
                border-top-left-radius: 3px;
                border-top-right-radius: 3px;
                background: MaterialPalette.primary;
            }
            tab-ta := TouchArea {
                clicked => {
                    if i != root.current {
                        root.picked(i);
                    }
                }
            }
        }
    }
}

// Grid/Tree toggle used by both query results and direct collection browsing:
// a Material segmented button. Stays controlled by `mode` like Toggle — the
// segmented button writes its own index on click, so it is re-synced from
// `mode` and only reports a change when the two disagree.
export component ResultModeToggle {
    in property <int> mode: 0;
    callback changed(int);
    sb := SegmentedButton {
        items: [{ text: "Grid" }, { text: "Tree" }];
        current-index: root.mode;
        index-changed(i) => {
            if i != root.mode {
                root.changed(i);
            }
        }
    }
    changed mode => { sb.current-index = root.mode; }
}

// Tag chip (mono text: acme, fintech). Non-interactive label in the M3 chip
// shape and surface.
export component TagChip inherits Rectangle {
    in property <string> text;
    height: MaterialStyleMetrics.size_32;
    width: label.preferred-width + 2 * MaterialStyleMetrics.padding_12;
    border-radius: self.height / 2;
    background: MaterialPalette.surface_container_highest;
    label := Text {
        text: root.text;
        color: MaterialPalette.on_surface_variant;
        font-size: MaterialTypography.label_large.font_size;
        font-family: Tokens.mono;
    }
}

// Header/toolbar icon action. Takes an AppIcons name; `active` paints it in
// the checked (primary) state for toggles like the sidebar/panel switches.
export component IconButton {
    in property <string> icon;
    in property <bool> active: false;
    in property <string> tooltip;            // optional hover label
    callback clicked;
    MaterialIconButton {
        icon: AppIcons.get(root.icon);
        checked: root.active;
        tooltip: root.tooltip;
        clicked => { root.clicked(); }
    }
}

// macOS-style window controls (– □ ×), right-aligned in the design.
// Filter/search input used in sidebars (white rounded box + magnifier).

// Autocomplete list surface, shared by the SQL editor's caret popup and the
// browse filter field. Owns only the card + scrolling row list; every caller
// positions it itself, because the anchors have nothing in common (the editor
// tracks a caret inside a scrolled viewport, the filter field just hangs it
// under the box). `row-h` and `pad` are exported so a caller's own anchor math
// can stay in sync with the height this component actually takes.
export component CompletionList inherits Rectangle {
    in property <[PaletteItem]> items;
    in property <int> selected;
    callback choose(int);
    out property <length> row-h: 22px;
    out property <length> pad: 8px;
    // Natural height, capped so a long candidate list stays a popup.
    out property <length> natural-height: min(root.items.length * root.row-h + root.pad, 200px);
    width: 360px;
    height: root.natural-height;
    border-radius: Tokens.radius;
    border-width: 1px;
    border-color: Tokens.border-strong;
    background: Tokens.card;
    drop-shadow-blur: 12px;
    drop-shadow-color: Tokens.text.with-alpha(0.25);
    clip: true;
    ScrollView {
        // Keep the keyboard-selected row visible: scroll only when the
        // selection would fall outside the viewport. Clamped so the top rows
        // sit at 0 and wrap-around (last -> first) snaps back up.
        viewport-y: -clamp(
            root.selected * root.row-h - self.visible-height + root.row-h + root.pad,
            0,
            max(0, root.items.length * root.row-h + root.pad - self.visible-height));
        VerticalLayout {
            padding: 4px;
            for it[i] in root.items: Rectangle {
                height: root.row-h;
                border-radius: Tokens.radius;
                background: i == root.selected ? Tokens.accent-tint
                    : cta.has-hover ? Tokens.chrome : transparent;
                HorizontalLayout {
                    padding-left: Tokens.sp2;
                    padding-right: Tokens.sp2;
                    spacing: Tokens.sp2;
                    VerticalLayout {
                        alignment: center;
                        AppIcon {
                            name: it.kind == "field" ? "field"
                                : it.kind == "table" ? "table"
                                : it.kind == "database" ? "database" : "keyword";
                            size: 13px;
                            color: it.kind == "table" ? Tokens.db-pg
                                : it.kind == "field" ? Tokens.text-dim : Tokens.accent;
                        }
                    }
                    Text {
                        // The label is the identity the user picks — give it all
                        // the slack so a long schema.table stays readable; the
                        // secondary `sub` yields first.
                        horizontal-stretch: 1;
                        text: it.label;
                        color: Tokens.text;
                        font-family: Tokens.mono;
                        font-size: Tokens.font-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: it.sub;
                        color: Tokens.text-faint;
                        font-family: Tokens.mono;
                        font-size: Tokens.font-xs;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                cta := TouchArea { clicked => { root.choose(i); } }
            }
        }
    }
}

// Search/filter input (sidebars, palette, toolbars): the app-owned outlined
// field with a search icon. Its input viewport follows the caret, so long
// values (a Mongo JSON filter) remain readable while editing.
export component FilterField {
    in property <string> placeholder;
    in-out property <string> text <=> tf.text;
    in property <string> trailing-cap: "";
    // Show an inline × that empties the field and re-submits it.
    in property <bool> clearable;
    callback edited(string);
    callback submitted;
    // Autocomplete. The candidate list is supplied by the owner (Rust fills it
    // on `edited`); an empty list means no popup, so nothing else needs a
    // separate "open" flag. Only the focused field paints its list, which lets
    // several filter fields share one set of window-level properties.
    in property <[PaletteItem]> completion-items;
    in property <int> completion-selected;
    callback completion-choose(int);
    // Navigation keys while the popup is up. Returns true when consumed, so an
    // unhandled key still reaches the input.
    callback completion-key(string) -> bool;
    public function focus-input() { tf.focus(); }
    forward-focus: tf;
    min-height: 36px;
    // completion list below can still hang outside it.
    Rectangle {
        clip: true;
        border-radius: 8px;
        tf := AppTextField {
            width: 100%;
            height: 100%;
            label: root.placeholder;
            leading-icon: AppIcons.get("search");
            // Clearing an applied filter has no other route: ⌘Z only ever
            // covered the code editor's own buffer, never a toolbar input, and
            // by the time the box holds text the query behind it has already
            // re-run.
            trailing-icon: root.clearable && root.text != "" ? AppIcons.get("close") : @image-url("");
            trailing-icon-clicked => {
                tf.text = "";
                // `submitted` is the existing apply path and already drops the
                // suggestion popup, so no `edited` is needed.
                root.submitted();
            }
            accepted => { root.submitted(); }
            edited(t) => { root.edited(t); }
            // Intercepted before the input sees them, so Up/Down move the popup
            // selection instead of the caret and Enter accepts a candidate
            // rather than submitting a half-typed filter. With no popup up,
            // every one of these falls through untouched.
            key-pressed(e) => {
                if (root.completion-items.length > 0
                    && (e.text == Key.UpArrow || e.text == Key.DownArrow
                        || e.text == Key.Tab || e.text == Key.Escape
                        || e.text == Key.Return)
                    && root.completion-key(e.text)) {
                    return accept;
                }
                return reject;
            }
        }
    }
    // Shortcut hint (⌘P) while the field is idle.
    if root.trailing-cap != "" && root.text == "" && !tf.has-focus: KeyCap {
        x: root.width - self.width - Tokens.sp4;
        y: (root.height - self.height) / 2;
        text: root.trailing-cap;
    }
    // Hangs under the field. Gated on focus so that when several filter fields
    // share one window-level candidate list, only the one being typed in shows
    // it.
    if root.completion-items.length > 0 && tf.has-focus: CompletionList {
        x: 0;
        y: root.height + 4px;
        items: root.completion-items;
        selected: root.completion-selected;
        choose(i) => { root.completion-choose(i); }
    }
}

// Design tokens — single source of truth for the Tabula design.
// Every color/metric in the UI resolves here; no magic hex outside this file.
// Each color carries a light and a dark value, switched by `dark`.
//
// `Palette` is imported only for its `color-scheme`, which is Slint 1.17's one
// supported way to read the live OS appearance: there is no Rust API for it in
// this version. std-widgets is already compiled in, so this costs nothing.
import { Palette } from "std-widgets.slint";
import "../../assets/fonts/IBMPlexMono-Regular.ttf";
import "../../assets/fonts/IBMPlexMono-Medium.ttf";
import "../../assets/fonts/IBMPlexMono-SemiBold.ttf";

export global Tokens {
    // 0 = follow the OS, 1 = force light, 2 = force dark. This is the only
    // theme property Rust writes.
    in-out property <int> theme-mode: 0;

    // Derived, never assigned. It is `out` on purpose: writing a bound property
    // in Slint replaces the binding permanently, so a stray `set_dark()` from
    // Rust would silently sever the link to the OS appearance and never restore
    // it. Making it read-only turns that mistake into a compile error.
    // `ColorScheme.unknown` is a real variant and falls through to light, which
    // is what the app defaulted to before.
    out property <bool> dark:
        theme-mode == 1 ? false :
        theme-mode == 2 ? true  :
        Palette.color-scheme == ColorScheme.dark;

    // ----- surfaces -----
    out property <color> chrome:  dark ? #1E1F24 : #F7F7F8;   // titlebar / toolbars / doc-tab row
    out property <color> sidebar: dark ? #191A1F : #F1F2F4;
    out property <color> canvas:  dark ? #141519 : #FCFCFD;   // main content background
    out property <color> card:    dark ? #232429 : #FFFFFF;

    // ----- hairline -----
    out property <color> border:        dark ? #FFFFFF.with-alpha(0.08) : #24262B.with-alpha(0.09);
    out property <color> border-strong: dark ? #FFFFFF.with-alpha(0.14) : #24262B.with-alpha(0.15);

    // ----- text -----
    out property <color> text:        dark ? #E8E9EC : #24262B;
    out property <color> text-dim:    dark ? #9DA0A8 : #6E737D;
    out property <color> text-faint:  dark ? #6A6D75 : #9DA2AC;
    out property <color> text-ghost:  dark ? #4B4E55 : #C2C4C9;   // NULL cells (italic), disabled

    // ----- accent -----
    out property <color> accent:         #2C5FD8;
    out property <color> accent-hover:   dark ? #4A7BE8 : #2451BA;
    out property <color> accent-tint:    dark ? #2C5FD8.with-alpha(0.18) : #E9EFFC;
    out property <color> on-tint:        dark ? #A9C2F5 : #1D3F8F; // text on accent-tint

    // ----- status -----
    out property <color> ok:    #239D5C;
    out property <color> warn:  #D9962F;
    out property <color> error: #E05A4E;
    out property <color> ok-tint:    #239D5C.with-alpha(0.12);
    out property <color> warn-tint:  #D9962F.with-alpha(0.14);
    out property <color> error-tint: #E05A4E.with-alpha(0.14);

    // ----- db engine badges -----
    out property <color> db-pg: #3577D4;
    out property <color> db-my: #E08A3C;
    out property <color> db-re: #B93C2E;
    out property <color> db-sl: #8E44AD;
    out property <color> db-mo: #58B98A;
    out property <color> db-ca: #1287A8;
    out property <color> db-ch: #FFCC01; // ClickHouse's real brand yellow
    out property <color> db-ms: #CC2927; // SQL Server's real documented brand red
    out property <color> db-mdb: #003545; // MariaDB's real brand navy ("Cyprus")
    out property <color> db-vk: #123678; // Valkey's real brand blue
    // engine string -> brand color (shared by DbBadge + connection row tint)
    public pure function db-color(engine: string) -> color {
        return engine == "postgres" ? db-pg
            : engine == "mysql" ? db-my
            : engine == "mariadb" ? db-mdb
            : engine == "redis" ? db-re
            : engine == "valkey" ? db-vk
            : engine == "sqlite" ? db-sl
            : engine == "mongo" ? db-mo
            : engine == "cassandra" ? db-ca
            : engine == "clickhouse" ? db-ch
            : engine == "mssql" ? db-ms
            : text-faint;
    }

    // ----- special cell colors -----
    out property <color> fk-text: dark ? #7FA0DE : #4A6BB0;   // foreign-key cells, with ↗

    // ----- syntax highlight (SQL editor) -----
    out property <color> syn-keyword:  dark ? #6C93EE : #2C5FD8; // weight 600
    out property <color> syn-string:   dark ? #E08087 : #C14953;
    out property <color> syn-function: dark ? #B48AE8 : #8250C4;
    out property <color> syn-comment:  dark ? #6A6D75 : #A6A9B0; // italic
    out property <color> editor-line:  dark ? #1D1E24 : #F3F1EC; // current-line highlight

    // ----- edit-pending states -----
    out property <color> edit-outline: #E05A4E; // 2px pending-cell outline

    // ----- modal / palette -----
    out property <color> veil: dark ? #101114.with-alpha(0.55) : #14161A.with-alpha(0.35);
    out property <length> modal-radius: 12px;
    out property <length> palette-width: 640px;

    // ----- metrics -----
    in-out property <length> font-base: 13px;
    out property <length> zoom-delta: font-base - 13px;
    out property <length> titlebar-h: 44px + zoom-delta;
    out property <length> doc-tab-row-h: 35px + zoom-delta;
    out property <length> doc-tab-h: 30px + zoom-delta;
    out property <length> sidebar-w: 218px;
    out property <length> grid-row-h: 24px + zoom-delta;
    out property <length> grid-header-h: 27px + zoom-delta;
    out property <length> status-bar-h: 34px + zoom-delta;
    out property <length> radius: 7px;
    out property <length> radius-lg: 8px;
    out property <length> button-h: 26px + zoom-delta;
    out property <length> selection-bar-w: 2px; // accent left bar on selection

    // ----- spacing (4px grid) -----
    out property <length> sp1: 4px;
    out property <length> sp2: 8px;
    out property <length> sp3: 12px;
    out property <length> sp4: 16px;
    out property <length> sp6: 24px;

    // ----- typography -----
    out property <length> font-xs: font-base - 2px;
    out property <length> font-sm: font-base - 1px;
    out property <length> font-md: font-base;
    out property <int>    weight-emphasis: 600;
    out property <string> mono: "IBM Plex Mono";

    // ----- icons -----
    out property <length> icon-sm: 14px + zoom-delta;
    out property <length> icon-md: 16px + zoom-delta;

    // ----- motion -----
    out property <duration> fade: 100ms;
}

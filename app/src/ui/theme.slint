// Design tokens — single source of truth. Light/dark = one `dark` flip.
// Per-connection accent is a runtime property fed from Rust, not a static token.
export global Theme {
    // ----- mode -----
    in-out property <bool> dark: true;

    // ----- base palette (selected by `dark`) -----
    out property <color> bg:       dark ? #17191b : #fbfbfc;
    out property <color> surface:  dark ? #1f2225 : #ffffff;
    out property <color> surface-2: dark ? #26292d : #f3f4f6;   // elevated/hover fill
    out property <color> hairline: dark ? #ffffff12 : #0000000d;
    out property <color> hairline-strong: dark ? #ffffff24 : #00000018;
    out property <color> text:     dark ? #e9ebed : #1b1d1f;
    out property <color> text-dim: dark ? #8b9095 : #6b7075;
    out property <color> text-faint: dark ? #5b6065 : #9aa0a6; // section captions

    // ----- accent (per-connection, default blue) -----
    in-out property <color> accent: #3b82f6;

    // ----- spacing scale (4px grid) -----
    out property <length> sp1: 4px;
    out property <length> sp2: 8px;
    out property <length> sp3: 12px;
    out property <length> sp4: 16px;
    out property <length> sp6: 24px;

    // ----- metrics -----
    // Dense TablePlus-style data rows; the sidebar tree keeps taller rows.
    out property <length> row-height: 28px;
    out property <length> tree-row-height: 32px;
    out property <length> gutter-width: 44px;
    out property <length> radius-panel: 8px;
    out property <length> radius-control: 6px;
    out property <length> radius-pill: 999px;

    // ----- icons -----
    out property <length> icon-sm: 14px;
    out property <length> icon-md: 16px;
    out property <length> icon-lg: 18px;

    // ----- typography (system fonts; embed nothing) -----
    out property <length> font-h: 14px;
    out property <length> font-body: 13px;
    out property <length> font-label: 12px;
    out property <length> font-caption: 11px;
    out property <length> font-mono: 13px;
    out property <string> mono-family: "monospace"; // SF Mono / Consolas resolve via system

    // ----- accent tints -----
    out property <color> accent-soft: accent.with-alpha(0.16);
    out property <color> accent-softer: accent.with-alpha(0.10);

    // ----- edit states (pending write buffer) -----
    out property <color> edit-pending: #f59e0b;
    out property <color> edit-delete: #ef4444;
    out property <color> edit-insert: #22c55e;
    out property <color> edit-pending-soft: edit-pending.with-alpha(0.16);
    out property <color> edit-delete-soft: edit-delete.with-alpha(0.16);
    out property <color> edit-insert-soft: edit-insert.with-alpha(0.16);

    // ----- motion -----
    out property <duration> fade: 100ms; // functional fades only, 80–120ms band
}

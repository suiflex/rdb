import { Theme } from "theme.slint";
import { GridColumn, GridCell, KvRow, StructField } from "structs.slint";
import { AppIcon } from "icons.slint";
import { TabularGrid } from "tabular-grid.slint";
import { ScrollView, Button, TextEdit, LineEdit } from "std-widgets.slint";

export component WorkArea inherits Rectangle {
    in-out property <string> query-text;
    in property <[GridColumn]> columns;
    in property <[GridCell]> cells;        // flat row-major: row r, col c at r*col-count + c
    in property <int> col-count;
    in property <[length]> col-widths;     // per-column pixel widths (drag-resizable)
    in property <string> doc-json;
    in property <[KvRow]> kv-rows;         // Redis key/value rows
    // result shape: 0 Table (SQL), 1 Documents (Mongo), 2 KeyValue (Redis), 3 Affected
    in property <int> result-kind: 0;
    property <bool> is-documents: root.result-kind == 1;
    // SQL editor only for SQL engines; documents can switch grid <-> raw JSON.
    in property <bool> sql-capable: true;
    in-out property <bool> doc-as-json: false;
    in property <string> result-status;    // Affected toast / errors
    in property <int> selected-row: 0;
    in property <int> selected-col: -1;
    in property <int> editing-row: -1;
    in property <int> editing-col: -1;
    // ----- Data / Structure toggle (Feature B) -----
    in-out property <bool> show-structure: false;
    in property <[StructField]> structure-columns;
    // ----- client-side grid filter (Feature C) -----
    in-out property <string> grid-filter;
    // ----- SQL editor toggle + active table title (TablePlus-style) -----
    in-out property <bool> sql-open: false;
    in property <string> active-table;
    // ----- pagination + edit footer (browse mode only) -----
    in property <int> page-start;       // 1-based first row shown
    in property <int> page-end;         // last row shown
    in property <int> total-rows: -1;   // -1 = unknown (count pending)
    in property <bool> can-prev;
    in property <bool> can-next;
    in property <int> pending-count;    // buffered edits awaiting ⌘S
    in property <bool> read-only;       // no primary key → editing disabled
    in-out property <string> limit-text: "300";
    callback run();
    callback apply-filter();
    callback toggle-sql();
    callback resize-col(int, length);   // (column index, drag delta)
    callback select-cell(int, int);     // (row, col)
    callback edit-cell(int, int);       // double-click → inline editor
    callback cell-edited(int, int, string);
    callback edit-cancelled();
    callback prev-page();
    callback next-page();
    callback refresh-page();
    callback set-limit(string);
    callback add-row();
    callback mark-delete();
    callback commit-edits();
    callback discard-edits();

    background: Theme.bg;

    // local splitter state (no Rust binding)
    property <length> editor-h: 140px;
    // a result is present when a table is open / a query has run
    property <bool> has-content: root.col-count > 0 || root.is-documents
        || root.kv-rows.length > 0 || root.result-status != "";

    VerticalLayout {
        padding: Theme.sp4;
        spacing: Theme.sp3;

        // ----- top toolbar: SQL toggle + active table / status -----
        HorizontalLayout {
            spacing: Theme.sp2;
            // SQL editor toggle pill (SQL engines only)
            if root.sql-capable: Rectangle {
                width: 66px;
                height: Theme.row-height;
                border-radius: Theme.radius-control;
                background: root.sql-open ? Theme.accent-soft
                    : (sql-ta.has-hover ? Theme.surface-2 : Theme.surface);
                border-width: 1px;
                border-color: root.sql-open ? Theme.accent.with-alpha(0.4) : Theme.hairline;
                sql-ta := TouchArea { clicked => { root.toggle-sql(); } }
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.sp1;
                    AppIcon {
                        name: "terminal";
                        size: Theme.icon-sm;
                        color: root.sql-open ? Theme.accent : Theme.text-dim;
                    }
                    Text {
                        vertical-alignment: center;
                        text: "SQL";
                        color: root.sql-open ? Theme.accent : Theme.text-dim;
                        font-size: Theme.font-label;
                        font-weight: 600;
                    }
                }
            }
            // active table name with a table glyph
            if root.active-table != "": AppIcon {
                name: "table";
                size: Theme.icon-sm;
                color: Theme.text-dim;
                y: (parent.height - self.height) / 2;
            }
            Text {
                vertical-alignment: center;
                text: root.active-table;
                color: Theme.text;
                font-size: Theme.font-h;
                font-weight: 600;
            }
            Rectangle {} // spacer
            Text {
                vertical-alignment: center;
                text: root.result-status;
                color: Theme.text-dim;
                font-size: Theme.font-label;
            }
        }

        // ----- query editor (only when SQL mode is toggled on) -----
        if root.sql-open: Rectangle {
            height: root.editor-h;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.hairline;
            background: Theme.surface;
            TextEdit {
                text <=> root.query-text;
                font-size: Theme.font-mono;
                wrap: no-wrap;
            }
        }

        if root.sql-open: HorizontalLayout {
            spacing: Theme.sp2;
            Rectangle {
                width: 132px;
                height: Theme.row-height;
                border-radius: Theme.radius-control;
                background: run-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                run-ta := TouchArea { clicked => { root.run(); } }
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.sp1;
                    AppIcon { name: "bolt"; size: Theme.icon-sm; color: #ffffff; }
                    Text {
                        vertical-alignment: center;
                        text: "Run  ⌘↵";
                        color: #ffffff;
                        font-size: Theme.font-label;
                        font-weight: 600;
                    }
                }
            }
            Rectangle {} // spacer
        }

        // draggable editor-height splitter
        if root.sql-open: Rectangle {
            height: 4px;
            background: split-v-area.has-hover || split-v-area.pressed ? Theme.accent : Theme.hairline;
            split-v-area := TouchArea {
                mouse-cursor: row-resize;
                moved => {
                    root.editor-h = clamp(root.editor-h + (self.mouse-y - self.pressed-y), 80px, 400px);
                }
            }
        }

        // ----- empty state: nothing open yet, SQL mode off -----
        if !root.has-content && !root.sql-open: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: Theme.sp3;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 16px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.hairline;
                        AppIcon { name: "table"; size: 26px; color: Theme.text-faint; }
                    }
                }
                Text {
                    horizontal-alignment: center;
                    text: "Select a table to view its data";
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                }
            }
        }

        // ----- Data/Structure tabs + filter input (only with content) -----
        if root.has-content: HorizontalLayout {
            spacing: Theme.sp1;
            // segmented Data | Structure control
            Rectangle {
                width: 168px;
                height: Theme.row-height;
                border-radius: Theme.radius-control;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.hairline;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    Rectangle {
                        border-radius: Theme.radius-control - 1px;
                        background: !root.show-structure ? Theme.accent-soft : transparent;
                        data-ta := TouchArea { clicked => { root.show-structure = false; } }
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.sp1;
                            AppIcon { name: "rows"; size: Theme.icon-sm; color: !root.show-structure ? Theme.accent : Theme.text-dim; }
                            Text {
                                vertical-alignment: center;
                                text: "Data";
                                color: !root.show-structure ? Theme.accent : Theme.text-dim;
                                font-size: Theme.font-label;
                                font-weight: !root.show-structure ? 600 : 400;
                            }
                        }
                    }
                    Rectangle {
                        border-radius: Theme.radius-control - 1px;
                        background: root.show-structure ? Theme.accent-soft : transparent;
                        struct-ta := TouchArea { clicked => { root.show-structure = true; } }
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.sp1;
                            AppIcon { name: "columns"; size: Theme.icon-sm; color: root.show-structure ? Theme.accent : Theme.text-dim; }
                            Text {
                                vertical-alignment: center;
                                text: "Structure";
                                color: root.show-structure ? Theme.accent : Theme.text-dim;
                                font-size: Theme.font-label;
                                font-weight: root.show-structure ? 600 : 400;
                            }
                        }
                    }
                }
            }
            Rectangle { width: Theme.sp2; } // gap
            // Table | JSON toggle — documents only (Feature: Mongo preview)
            if root.is-documents && !root.show-structure: Rectangle {
                width: 132px;
                height: Theme.row-height;
                border-radius: Theme.radius-control;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.hairline;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    Rectangle {
                        border-radius: Theme.radius-control - 1px;
                        background: !root.doc-as-json ? Theme.accent-soft : transparent;
                        table-ta := TouchArea { clicked => { root.doc-as-json = false; } }
                        Text {
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: "Table";
                            color: !root.doc-as-json ? Theme.accent : Theme.text-dim;
                            font-size: Theme.font-label;
                            font-weight: !root.doc-as-json ? 600 : 400;
                        }
                    }
                    Rectangle {
                        border-radius: Theme.radius-control - 1px;
                        background: root.doc-as-json ? Theme.accent-soft : transparent;
                        json-ta := TouchArea { clicked => { root.doc-as-json = true; } }
                        Text {
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: "JSON";
                            color: root.doc-as-json ? Theme.accent : Theme.text-dim;
                            font-size: Theme.font-label;
                            font-weight: root.doc-as-json ? 600 : 400;
                        }
                    }
                }
            }
            if root.is-documents: Rectangle { width: Theme.sp2; } // gap
            // client-side filter (only meaningful for Data view); flexes with width
            AppIcon {
                name: "filter";
                size: Theme.icon-sm;
                color: Theme.text-faint;
                y: (parent.height - self.height) / 2;
            }
            LineEdit {
                min-width: 80px;
                horizontal-stretch: 1;
                placeholder-text: "Filter rows…";
                text <=> root.grid-filter;
                edited => { root.apply-filter(); }
            }
        }

        // ----- result region -----
        if root.has-content: Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.hairline;
            background: Theme.surface;

            // structure (column definitions) view
            if root.show-structure: ScrollView {
                VerticalLayout {
                    width: max(self.preferred-width, parent.visible-width);
                    HorizontalLayout {
                        height: Theme.row-height;
                        Rectangle {
                            min-width: 200px;
                            horizontal-stretch: 2;
                            background: Theme.surface;
                            Text { x: Theme.sp1; vertical-alignment: center; text: "Column"; color: Theme.text-dim; font-size: Theme.font-label; }
                        }
                        Rectangle {
                            min-width: 160px;
                            horizontal-stretch: 1;
                            background: Theme.surface;
                            Text { x: Theme.sp1; vertical-alignment: center; text: "Type"; color: Theme.text-dim; font-size: Theme.font-label; }
                        }
                        Rectangle {
                            min-width: 90px;
                            background: Theme.surface;
                            Text { x: Theme.sp1; vertical-alignment: center; text: "Nullable"; color: Theme.text-dim; font-size: Theme.font-label; }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.hairline; }
                    for f in root.structure-columns: Rectangle {
                        height: Theme.row-height;
                        HorizontalLayout {
                            Rectangle {
                                min-width: 200px;
                                horizontal-stretch: 2;
                                Text { x: Theme.sp1; vertical-alignment: center; text: f.name; color: Theme.text; font-family: Theme.mono-family; font-size: Theme.font-mono; }
                            }
                            Rectangle {
                                min-width: 160px;
                                horizontal-stretch: 1;
                                Text { x: Theme.sp1; vertical-alignment: center; text: f.type-name; color: Theme.text-dim; font-family: Theme.mono-family; font-size: Theme.font-mono; }
                            }
                            Rectangle {
                                min-width: 90px;
                                Text { x: Theme.sp1; vertical-alignment: center; text: f.nullable ? "YES" : "NO"; color: Theme.text-dim; font-size: Theme.font-mono; }
                            }
                        }
                    }
                }
            }

            // documents raw-JSON view (toggled on); pinned top-left, full width
            if !root.show-structure && root.result-kind == 1 && root.doc-as-json: ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding: Theme.sp2;
                    Text {
                        text: root.doc-json;
                        color: Theme.text;
                        horizontal-alignment: left;
                        wrap: word-wrap;
                        font-family: Theme.mono-family;
                        font-size: Theme.font-mono;
                    }
                }
            }

            // SQL grid (kind 0) + Mongo flattened-document "Table" view (kind 1)
            if !root.show-structure
                && (root.result-kind == 0 || (root.result-kind == 1 && !root.doc-as-json)): TabularGrid {
                columns: root.columns;
                cells: root.cells;
                col-count: root.col-count;
                col-widths: root.col-widths;
                selected-row: root.selected-row;
                selected-col: root.selected-col;
                editing-row: root.editing-row;
                editing-col: root.editing-col;
                resize-col(i, d) => { root.resize-col(i, d); }
                select-cell(r, c) => { root.select-cell(r, c); }
                edit-cell(r, c) => { root.edit-cell(r, c); }
                cell-edited(r, c, t) => { root.cell-edited(r, c, t); }
                edit-cancelled() => { root.edit-cancelled(); }
            }

            // Redis key/value view (kind 2): two columns, no drag-resize
            if !root.show-structure && root.result-kind == 2: ScrollView {
                VerticalLayout {
                    width: max(self.preferred-width, parent.visible-width);
                    HorizontalLayout {
                        height: Theme.row-height;
                        Rectangle {
                            width: 240px;
                            background: Theme.surface;
                            Text { x: Theme.sp1; vertical-alignment: center; text: "Key"; color: Theme.text-dim; font-size: Theme.font-label; }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.surface;
                            Text { x: Theme.sp1; vertical-alignment: center; text: "Value"; color: Theme.text-dim; font-size: Theme.font-label; }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.hairline; }
                    for row[r] in root.kv-rows: Rectangle {
                        height: Theme.row-height;
                        background: r == root.selected-row ? Theme.accent.with-alpha(0.14) : transparent;
                        HorizontalLayout {
                            Rectangle {
                                width: 240px;
                                clip: true;
                                Text {
                                    vertical-alignment: center;
                                    x: Theme.sp1;
                                    width: parent.width - 2 * Theme.sp1;
                                    overflow: elide;
                                    text: row.key;
                                    color: Theme.text-dim;
                                    font-family: Theme.mono-family;
                                    font-size: Theme.font-mono;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                Text {
                                    vertical-alignment: center;
                                    x: Theme.sp1;
                                    width: parent.width - 2 * Theme.sp1;
                                    overflow: elide;
                                    text: row.value.text;
                                    color: row.value.is-null ? Theme.text-dim : Theme.text;
                                    font-family: Theme.mono-family;
                                    font-size: Theme.font-mono;
                                }
                            }
                        }
                    }
                }
            }

            // Affected (kind 3): no grid, just the centered status
            if !root.show-structure && root.result-kind == 3: VerticalLayout {
                alignment: center;
                Text {
                    horizontal-alignment: center;
                    text: root.result-status;
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                }
            }
        }

        // ----- pagination + edit footer (TablePlus-style, browse mode only) -----
        if root.has-content && root.active-table != "": Rectangle {
            height: 32px;
            HorizontalLayout {
                spacing: Theme.sp1;
                // + insert row
                Rectangle {
                    width: 26px;
                    border-radius: Theme.radius-control;
                    background: add-row-ta.has-hover && !root.read-only ? Theme.surface-2 : transparent;
                    add-row-ta := TouchArea { enabled: !root.read-only; clicked => { root.add-row(); } }
                    Text {
                        horizontal-alignment: center; vertical-alignment: center;
                        text: "+"; font-size: 15px;
                        color: root.read-only ? Theme.text-faint : Theme.text-dim;
                    }
                }
                // − mark selected row deleted
                Rectangle {
                    width: 26px;
                    border-radius: Theme.radius-control;
                    background: del-row-ta.has-hover && !root.read-only ? Theme.surface-2 : transparent;
                    del-row-ta := TouchArea { enabled: !root.read-only; clicked => { root.mark-delete(); } }
                    Text {
                        horizontal-alignment: center; vertical-alignment: center;
                        text: "−"; font-size: 15px;
                        color: root.read-only ? Theme.text-faint : Theme.text-dim;
                    }
                }
                // ⟳ refresh page
                Rectangle {
                    width: 26px;
                    border-radius: Theme.radius-control;
                    background: refresh-ta.has-hover ? Theme.surface-2 : transparent;
                    refresh-ta := TouchArea { clicked => { root.refresh-page(); } }
                    Text {
                        horizontal-alignment: center; vertical-alignment: center;
                        text: "⟳"; font-size: 13px; color: Theme.text-dim;
                    }
                }
                if root.read-only: Text {
                    vertical-alignment: center;
                    text: "read-only (no primary key)";
                    color: Theme.text-faint;
                    font-size: Theme.font-caption;
                }
                Rectangle {} // spacer
                // ‹ page window ›
                Rectangle {
                    width: 24px;
                    border-radius: Theme.radius-control;
                    background: prev-ta.has-hover && root.can-prev ? Theme.surface-2 : transparent;
                    prev-ta := TouchArea { enabled: root.can-prev; clicked => { root.prev-page(); } }
                    Text {
                        horizontal-alignment: center; vertical-alignment: center;
                        text: "‹"; font-size: 14px;
                        color: root.can-prev ? Theme.text-dim : Theme.text-faint;
                    }
                }
                Text {
                    vertical-alignment: center;
                    text: root.total-rows < 0
                        ? "\{root.page-start}–\{root.page-end}"
                        : "\{root.page-start}–\{root.page-end} of \{root.total-rows}";
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                }
                Rectangle {
                    width: 24px;
                    border-radius: Theme.radius-control;
                    background: next-ta.has-hover && root.can-next ? Theme.surface-2 : transparent;
                    next-ta := TouchArea { enabled: root.can-next; clicked => { root.next-page(); } }
                    Text {
                        horizontal-alignment: center; vertical-alignment: center;
                        text: "›"; font-size: 14px;
                        color: root.can-next ? Theme.text-dim : Theme.text-faint;
                    }
                }
                Rectangle { width: Theme.sp2; }
                Text {
                    vertical-alignment: center;
                    text: "limit";
                    color: Theme.text-faint;
                    font-size: Theme.font-caption;
                }
                LineEdit {
                    width: 56px;
                    text <=> root.limit-text;
                    font-size: Theme.font-label;
                    accepted(t) => { root.set-limit(t); }
                }
                Rectangle { width: Theme.sp2; }
                // pending edits badge + commit/discard (hidden when clean)
                if root.pending-count > 0: Rectangle {
                    width: 8px; height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: Theme.edit-pending;
                }
                if root.pending-count > 0: Text {
                    vertical-alignment: center;
                    text: "\{root.pending-count} pending";
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                }
                if root.pending-count > 0: Rectangle {
                    width: 92px;
                    border-radius: Theme.radius-control;
                    background: commit-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                    commit-ta := TouchArea { clicked => { root.commit-edits(); } }
                    Text {
                        horizontal-alignment: center; vertical-alignment: center;
                        text: "Commit ⌘S"; color: #ffffff;
                        font-size: Theme.font-label; font-weight: 600;
                    }
                }
                if root.pending-count > 0: Rectangle {
                    width: 64px;
                    border-radius: Theme.radius-control;
                    border-width: 1px;
                    border-color: Theme.hairline-strong;
                    background: discard-ta.has-hover ? Theme.surface-2 : transparent;
                    discard-ta := TouchArea { clicked => { root.discard-edits(); } }
                    Text {
                        horizontal-alignment: center; vertical-alignment: center;
                        text: "Discard"; color: Theme.text-dim;
                        font-size: Theme.font-label;
                    }
                }
            }
        }
    }
}

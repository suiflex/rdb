import { Theme } from "theme.slint";
export { Theme }
import { Sidebar } from "sidebar.slint";
import { ConnPicker } from "picker.slint";
import { WorkArea } from "workarea.slint";
import { CommandPalette, PaletteItem } from "palette.slint";
import { ConnForm } from "conn-form.slint";
import { AppIcon } from "icons.slint";
import {
    GridColumn,
    GridCell,
    KvRow,
    TreeNode,
    ConnItem,
    TabItem,
    StructField,
} from "structs.slint";

export component MainWindow inherits Window {
    title: "RDBS";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 400px;
    min-height: 320px;
    background: Theme.bg;

    // ----- status bar text (fed from Rust) -----
    in property <string> status-conn: "no connection";
    in property <string> status-latency: "";
    in property <string> status-rows: "";

    // ----- sidebar models -----
    in property <[ConnItem]> connections;
    in property <[TreeNode]> schema-tree;
    in property <int> selected-conn: -1;
    in property <string> active-table;
    in property <[string]> schema-list;
    in-out property <string> schema-name: "public";
    callback connect-clicked(int);
    callback toggle-group(string);
    callback open-table(string, string);   // (database, container)
    callback toggle-schema-node(string);
    callback select-schema(string);
    callback filter-tree(string);

    // ----- view state: false = connection picker, true = workspace -----
    in property <bool> connected: false;
    in property <string> picker-error;
    callback disconnect();
    callback conn-filter(string);

    // ----- work area models -----
    in-out property <string> query-text;
    in property <[GridColumn]> grid-columns;
    in property <[GridCell]> grid-cells;
    in property <int> grid-col-count;
    in property <string> doc-json;
    in property <[KvRow]> kv-rows;
    // result shape: 0 Table, 1 Documents, 2 KeyValue, 3 Affected
    in property <int> result-kind: 0;
    in property <bool> sql-capable: true;
    in property <string> result-status;
    in-out property <int> selected-row: 0;
    in-out property <int> selected-col: -1;
    in property <int> editing-row: -1;
    in property <int> editing-col: -1;
    callback select-cell(int, int);
    callback edit-cell(int, int);
    callback cell-edited(int, int, string);
    callback edit-cancelled();
    in-out property <bool> show-structure: false;
    in property <[StructField]> structure-columns;
    in-out property <string> grid-filter;
    in property <[length]> grid-col-widths;
    callback run-query();
    callback apply-filter();
    callback resize-grid-col(int, length);

    // ----- tabs + palette -----
    in property <[TabItem]> tabs;
    in-out property <int> active-tab: 0;
    in property <bool> palette-open;
    in property <[PaletteItem]> palette-items;
    callback new-tab();
    callback close-tab();
    callback select-tab(int);
    callback toggle-palette();
    callback palette-filter(string);
    callback palette-choose(int);
    callback move-row(int);
    callback toggle-theme();

    // ----- connection form -----
    in property <bool> form-open;
    in property <bool> form-edit-mode;
    in-out property <string> f-name;
    in-out property <string> f-engine;
    in-out property <string> f-host;
    in-out property <string> f-port;
    in-out property <string> f-user;
    in-out property <string> f-database;
    in-out property <string> f-password;
    in-out property <string> f-sslmode;
    in-out property <string> f-color;
    in-out property <string> f-import-url;
    in property <string> form-error;
    in property <string> test-result;
    in property <bool> test-ok;
    in property <bool> test-busy;
    callback open-add-form();
    callback open-edit-form(int);
    callback form-engine-changed(string);
    callback form-import-url();
    callback form-test-conn();
    callback form-save();
    callback form-delete();
    callback form-cancel();

    // ----- layout splitters (local, no Rust binding) -----
    property <length> sidebar-w: 260px;

    // ----- keyboard shortcuts -----
    FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control || e.modifiers.meta) {
                if (e.text == "k") {
                    root.toggle-palette();
                    return accept;
                }
                if (e.text == Key.Return) {
                    root.run-query();
                    return accept;
                }
                if (e.text == "t") {
                    root.new-tab();
                    return accept;
                }
                if (e.text == "w") {
                    root.close-tab();
                    return accept;
                }
                if (e.text == "1") {
                    root.select-tab(0);
                    return accept;
                }
                if (e.text == "2") {
                    root.select-tab(1);
                    return accept;
                }
                if (e.text == "3") {
                    root.select-tab(2);
                    return accept;
                }
                if (e.text == "4") {
                    root.select-tab(3);
                    return accept;
                }
                if (e.text == "5") {
                    root.select-tab(4);
                    return accept;
                }
                if (e.text == "6") {
                    root.select-tab(5);
                    return accept;
                }
                if (e.text == "7") {
                    root.select-tab(6);
                    return accept;
                }
                if (e.text == "8") {
                    root.select-tab(7);
                    return accept;
                }
                if (e.text == "9") {
                    root.select-tab(8);
                    return accept;
                }
            }
            if (e.text == "j") {
                root.move-row(1);
                return accept;
            }
            if (e.text == "k") {
                root.move-row(-1);
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 0px;

        // ----- accent top border (per-connection color) -----
        Rectangle {
            height: 2px;
            background: Theme.accent;
        }

        // ===== connection picker (shown while not connected) =====
        if !root.connected: ConnPicker {
            connections: root.connections;
            selected-conn: root.selected-conn;
            error: root.picker-error;
            connect-clicked(i) => {
                root.connect-clicked(i);
            }
            add-clicked() => {
                root.open-add-form();
            }
            edit-clicked(i) => {
                root.open-edit-form(i);
            }
            toggle-group(g) => {
                root.toggle-group(g);
            }
            filter(t) => {
                root.conn-filter(t);
            }
        }

        // ===== workspace (shown once connected) =====
        if root.connected: VerticalLayout {
            spacing: 0px;

            // ----- main row: sidebar | work column -----
            HorizontalLayout {
                spacing: 0px;

                Sidebar {
                    // preferred (not fixed) width so the window can auto-shrink the
                    // sidebar instead of treating sidebar-w as a hard min floor
                    horizontal-stretch: 0;
                    min-width: 150px;
                    max-width: 480px;
                    preferred-width: root.sidebar-w;
                    tree: root.schema-tree;
                    conn-name: root.status-conn;
                    active-table: root.active-table;
                    schema-list: root.schema-list;
                    schema-name <=> root.schema-name;
                    disconnect() => {
                        root.disconnect();
                    }
                    open-table(db, t) => {
                        root.open-table(db, t);
                    }
                    toggle-node(t) => {
                        root.toggle-schema-node(t);
                    }
                    select-schema(s) => {
                        root.select-schema(s);
                    }
                    filter-tree(t) => {
                        root.filter-tree(t);
                    }
                }

                // draggable vertical splitter (sidebar width)
                Rectangle {
                    width: 4px;
                    background: split-h-area.has-hover || split-h-area.pressed ? Theme.accent : Theme.hairline;
                    split-h-area := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.sidebar-w = clamp(root.sidebar-w + (self.mouse-x - self.pressed-x), 150px, 480px);
                        }
                    }
                }

                // work column: tab bar + work area (takes all remaining width)
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    // ----- tab bar (flat, TablePlus-style) -----
                    Rectangle {
                        height: 34px;
                        background: Theme.surface;
                        HorizontalLayout {
                            padding: 0px;
                            spacing: 0px;
                            for tab[i] in root.tabs: Rectangle {
                                width: 150px;
                                background: i == root.active-tab ? Theme.bg : (tab-ta.has-hover ? Theme.surface-2 : transparent);
                                tab-ta := TouchArea {
                                    clicked => {
                                        root.select-tab(i);
                                    }
                                }

                                // hairline separator between tabs
                                Rectangle { width: 1px; x: parent.width - 1px; background: Theme.hairline; }
                                HorizontalLayout {
                                    padding-left: Theme.sp2;
                                    padding-right: Theme.sp1;
                                    spacing: Theme.sp1;
                                    // engine accent dot
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 3px;
                                        background: i == root.active-tab ? Theme.accent : Theme.text-faint;
                                    }

                                    Text {
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        text: tab.title;
                                        color: i == root.active-tab ? Theme.text : Theme.text-dim;
                                        font-size: Theme.font-label;
                                        font-weight: i == root.active-tab ? 600 : 400;
                                        overflow: elide;
                                    }
                                    // close affordance (active or hovered tab)
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: Theme.radius-control;
                                        background: close-ta.has-hover ? Theme.surface-2 : transparent;
                                        visible: i == root.active-tab || tab-ta.has-hover;
                                        close-ta := TouchArea {
                                            clicked => {
                                                root.close-tab();
                                            }
                                        }

                                        AppIcon {
                                            name: "close";
                                            size: 11px;
                                            color: Theme.text-dim;
                                        }
                                    }
                                }
                                // active-tab accent underline
                                if i == root.active-tab: Rectangle {
                                    y: parent.height - self.height;
                                    height: 2px;
                                    background: Theme.accent;
                                }
                            }
                            // new-tab button
                            Rectangle {
                                width: 30px;
                                y: (parent.height - self.height) / 2;
                                height: 26px;
                                border-radius: Theme.radius-control;
                                background: add-ta.has-hover ? Theme.surface-2 : transparent;
                                add-ta := TouchArea {
                                    clicked => {
                                        root.new-tab();
                                    }
                                }

                                AppIcon {
                                    name: "plus";
                                    size: Theme.icon-sm;
                                    color: Theme.text-dim;
                                }
                            }
                            // trailing filler: gives the tab bar an infinite max-width
                            // so the work column (and the window) can stretch full-width
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.hairline;
                    }

                    WorkArea {
                        query-text <=> root.query-text;
                        columns: root.grid-columns;
                        cells: root.grid-cells;
                        col-count: root.grid-col-count;
                        col-widths: root.grid-col-widths;
                        doc-json: root.doc-json;
                        kv-rows: root.kv-rows;
                        result-kind: root.result-kind;
                        sql-capable: root.sql-capable;
                        result-status: root.result-status;
                        selected-row: root.selected-row;
                        selected-col: root.selected-col;
                        editing-row: root.editing-row;
                        editing-col: root.editing-col;
                        show-structure <=> root.show-structure;
                        structure-columns: root.structure-columns;
                        grid-filter <=> root.grid-filter;
                        active-table: root.active-table;
                        run => {
                            root.run-query();
                        }
                        apply-filter() => {
                            root.apply-filter();
                        }
                        toggle-sql() => {
                            self.sql-open = !self.sql-open;
                        }
                        resize-col(i, d) => {
                            root.resize-grid-col(i, d);
                        }
                        select-cell(r, c) => {
                            root.select-cell(r, c);
                        }
                        edit-cell(r, c) => {
                            root.edit-cell(r, c);
                        }
                        cell-edited(r, c, t) => {
                            root.cell-edited(r, c, t);
                        }
                        edit-cancelled() => {
                            root.edit-cancelled();
                        }
                    }
                }
            }

            // ----- status bar -----
            Rectangle {
                height: 1px;
                background: Theme.hairline;
            }

            Rectangle {
                height: 28px;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.sp3;
                    padding-right: Theme.sp2;
                    spacing: Theme.sp2;
                    // live status dot
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 4px;
                        y: (parent.height - self.height) / 2;
                        background: #22c55e;
                    }

                    Text {
                        vertical-alignment: center;
                        text: root.status-conn;
                        color: Theme.text;
                        font-size: Theme.font-label;
                        font-weight: 600;
                    }

                    Text {
                        vertical-alignment: center;
                        text: root.status-latency;
                        color: Theme.text-dim;
                        font-size: Theme.font-caption;
                    }

                    Rectangle { } // spacer
                    Text {
                        vertical-alignment: center;
                        text: root.status-rows;
                        color: Theme.text-dim;
                        font-size: Theme.font-caption;
                    }
                    // theme toggle
                    Rectangle {
                        width: 30px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-control;
                        background: theme-ta.has-hover ? Theme.surface-2 : transparent;
                        theme-ta := TouchArea {
                            clicked => {
                                root.toggle-theme();
                            }
                        }

                        AppIcon {
                            name: Theme.dark ? "sun" : "moon";
                            size: Theme.icon-sm;
                            color: Theme.text-dim;
                        }
                    }
                }
            }
        }
    }

    // ----- command palette overlay (drawn on top) -----
    CommandPalette {
        open: root.palette-open;
        items: root.palette-items;
        filter(t) => {
            root.palette-filter(t);
        }
        choose(i) => {
            root.palette-choose(i);
        }
    }

    // ----- connection form overlay (drawn on top of palette layer) -----
    ConnForm {
        width: root.width;
        height: root.height;
        open: root.form-open;
        edit-mode: root.form-edit-mode;
        f-name <=> root.f-name;
        f-engine <=> root.f-engine;
        f-host <=> root.f-host;
        f-port <=> root.f-port;
        f-user <=> root.f-user;
        f-database <=> root.f-database;
        f-password <=> root.f-password;
        f-sslmode <=> root.f-sslmode;
        f-color <=> root.f-color;
        f-import-url <=> root.f-import-url;
        form-error: root.form-error;
        test-result: root.test-result;
        test-ok: root.test-ok;
        test-busy: root.test-busy;
        engine-changed(v) => {
            root.form-engine-changed(v);
        }
        import-url() => {
            root.form-import-url();
        }
        test-conn() => {
            root.form-test-conn();
        }
        save() => {
            root.form-save();
        }
        delete-conn() => {
            root.form-delete();
        }
        cancel() => {
            root.form-cancel();
        }
    }
}

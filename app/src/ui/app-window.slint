import { Theme } from "theme.slint";
export { Theme }
import { Sidebar } from "sidebar.slint";
import { WorkArea } from "workarea.slint";
import { CommandPalette, PaletteItem } from "palette.slint";
import { ConnForm } from "conn-form.slint";
import { GridColumn, GridCell, TreeNode, ConnItem, TabItem } from "structs.slint";

export component MainWindow inherits Window {
    title: "DBM";
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Theme.bg;

    // ----- status bar text (fed from Rust) -----
    in property <string> status-conn: "no connection";
    in property <string> status-latency: "";
    in property <string> status-rows: "";

    // ----- sidebar models -----
    in property <[ConnItem]> connections;
    in property <[TreeNode]> schema-tree;
    in property <int> selected-conn: -1;
    callback connect-clicked(int);

    // ----- work area models -----
    in-out property <string> query-text;
    in property <[GridColumn]> grid-columns;
    in property <[GridCell]> grid-cells;
    in property <int> grid-col-count;
    in property <string> doc-json;
    in property <bool> is-documents;
    in property <string> result-status;
    in-out property <int> selected-row: 0;
    callback run-query();

    // ----- tabs + palette -----
    in property <[TabItem]> tabs;
    in-out property <int> active-tab: 0;
    in property <bool> palette-open;
    in property <[PaletteItem]> palette-items;
    callback new-tab();
    callback close-tab();
    callback select-tab(int);
    callback toggle-palette();
    callback palette-filter(string);
    callback palette-choose(int);
    callback move-row(int);
    callback toggle-theme();

    // ----- connection form -----
    in property <bool> form-open;
    in property <bool> form-edit-mode;
    in-out property <string> f-name;
    in-out property <string> f-engine;
    in-out property <string> f-host;
    in-out property <string> f-port;
    in-out property <string> f-user;
    in-out property <string> f-database;
    in-out property <string> f-password;
    in-out property <string> f-sslmode;
    in-out property <string> f-color;
    in property <string> form-error;
    callback open-add-form();
    callback open-edit-form(int);
    callback form-engine-changed(string);
    callback form-save();
    callback form-delete();
    callback form-cancel();

    // ----- keyboard shortcuts -----
    FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control || e.modifiers.meta) {
                if (e.text == "k") { root.toggle-palette(); return accept; }
                if (e.text == Key.Return) { root.run-query(); return accept; }
                if (e.text == "t") { root.new-tab(); return accept; }
                if (e.text == "w") { root.close-tab(); return accept; }
                if (e.text == "1") { root.select-tab(0); return accept; }
                if (e.text == "2") { root.select-tab(1); return accept; }
                if (e.text == "3") { root.select-tab(2); return accept; }
                if (e.text == "4") { root.select-tab(3); return accept; }
                if (e.text == "5") { root.select-tab(4); return accept; }
                if (e.text == "6") { root.select-tab(5); return accept; }
                if (e.text == "7") { root.select-tab(6); return accept; }
                if (e.text == "8") { root.select-tab(7); return accept; }
                if (e.text == "9") { root.select-tab(8); return accept; }
            }
            if (e.text == "j") { root.move-row(1); return accept; }
            if (e.text == "k") { root.move-row(-1); return accept; }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 0px;

        // ----- accent top border (per-connection color) -----
        Rectangle {
            height: 2px;
            background: Theme.accent;
        }

        // ----- main row: sidebar | work column -----
        HorizontalLayout {
            spacing: 0px;

            Sidebar {
                width: 260px;
                connections: root.connections;
                tree: root.schema-tree;
                selected-conn: root.selected-conn;
                connect-clicked(i) => { root.connect-clicked(i); }
            }

            // hairline divider
            Rectangle { width: 1px; background: Theme.hairline; }

            // work column: tab bar + work area
            VerticalLayout {
                spacing: 0px;
                // ----- tab bar -----
                Rectangle {
                    height: 34px;
                    background: Theme.surface;
                    HorizontalLayout {
                        padding-left: Theme.sp2;
                        spacing: Theme.sp1;
                        for tab[i] in root.tabs: Rectangle {
                            width: 140px;
                            border-radius: Theme.radius-control;
                            background: i == root.active-tab ? Theme.bg : transparent;
                            TouchArea { clicked => { root.select-tab(i); } }
                            Text {
                                x: Theme.sp2;
                                vertical-alignment: center;
                                text: tab.title;
                                color: i == root.active-tab ? Theme.text : Theme.text-dim;
                                font-size: Theme.font-label;
                            }
                        }
                        Rectangle {
                            width: 28px;
                            TouchArea { clicked => { root.new-tab(); } }
                            Text { text: "+"; horizontal-alignment: center; vertical-alignment: center; color: Theme.text-dim; }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.hairline; }
                WorkArea {
                    query-text <=> root.query-text;
                    columns: root.grid-columns;
                    cells: root.grid-cells;
                    col-count: root.grid-col-count;
                    doc-json: root.doc-json;
                    is-documents: root.is-documents;
                    result-status: root.result-status;
                    selected-row: root.selected-row;
                    run => { root.run-query(); }
                }
            }
        }

        // ----- status bar -----
        Rectangle { height: 1px; background: Theme.hairline; }
        Rectangle {
            height: 26px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.sp3;
                padding-right: Theme.sp3;
                spacing: Theme.sp4;
                Text {
                    vertical-alignment: center;
                    text: root.status-conn;
                    color: Theme.text;
                    font-size: Theme.font-label;
                }
                Text {
                    vertical-alignment: center;
                    text: root.status-latency;
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                }
                Rectangle {} // spacer
                Rectangle {
                    width: 44px;
                    TouchArea { clicked => { root.toggle-theme(); } }
                    Text {
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        text: Theme.dark ? "Light" : "Dark";
                        color: Theme.text-dim;
                        font-size: Theme.font-label;
                    }
                }
                Text {
                    vertical-alignment: center;
                    text: root.status-rows;
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                }
            }
        }
    }

    // ----- command palette overlay (drawn on top) -----
    CommandPalette {
        open: root.palette-open;
        items: root.palette-items;
        filter(t) => { root.palette-filter(t); }
        choose(i) => { root.palette-choose(i); }
    }

    // ----- connection form overlay (drawn on top of palette layer) -----
    ConnForm {
        width: root.width;
        height: root.height;
        open: root.form-open;
        edit-mode: root.form-edit-mode;
        f-name <=> root.f-name;
        f-engine <=> root.f-engine;
        f-host <=> root.f-host;
        f-port <=> root.f-port;
        f-user <=> root.f-user;
        f-database <=> root.f-database;
        f-password <=> root.f-password;
        f-sslmode <=> root.f-sslmode;
        f-color <=> root.f-color;
        form-error: root.form-error;
        engine-changed(v) => { root.form-engine-changed(v); }
        save() => { root.form-save(); }
        delete-conn() => { root.form-delete(); }
        cancel() => { root.form-cancel(); }
    }
}

// Syntax-highlighted SQL editor (Tabula): line-number gutter, current-line
// highlight, colored spans fed by the Rust lexer, custom caret.
// Reference: design/3-sql-editor.png.
import { Tokens } from "tokens.slint";
import { Span, PaletteItem } from "structs.slint";
import { AppIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { CompletionList } from "components.slint";

export component CodeEditor inherits Rectangle {
    in property <[[Span]]> lines;
    // Per-line fold metadata, parallel to `lines`. `fold-state`: 0 plain,
    // 1 open statement head (triangle down), 2 closed head (triangle right).
    // `line-hidden`: body line of a closed statement, collapsed to zero height.
    in property <[int]> fold-state;
    in property <[bool]> line-hidden;
    callback toggle-fold(int);
    // Ghost hint shown only while the buffer is empty (engine-specific).
    in property <string> placeholder;
    in property <int> cursor-line: 0;
    // Visual row after folded lines are removed; used only to anchor completion.
    in property <int> cursor-visual-row: 0;
    in property <int> cursor-col: 0;
    in property <int> error-line: -1;
    // Whole span of the failing statement; the engine's own line sits inside it
    // but is usually not where the mistake started.
    in property <int> error-from: -1;
    in property <int> error-to: -1;
    // Token the engine choked on, on `error-line`: column + length in chars.
    // len 0 = the engine reported only a line, so there is nothing to underline.
    in property <int> error-col: 0;
    in property <int> error-len: 0;
    // (key text, meta/ctrl, alt/option, shift) -> true when the editor consumed
    // the key. meta = ⌘ line/doc motions, alt = ⌥ word motions.
    callback edit-key(string, bool, bool, bool) -> bool;
    // Mouse: press places the caret, drag extends the selection, double-click
    // selects the word. All carry (line, col) hit-tested from the pointer.
    callback press-pos(int, int, bool);
    // (pressed line, rows travelled on screen, column) — the row delta stays
    // separate because folded lines draw at zero height, so the host has to
    // skip them to turn it back into a buffer line.
    callback drag-pos(int, int, int);
    callback select-word(int, int);
    // SQL autocomplete popup, anchored under the caret
    in property <[PaletteItem]> completion-items;
    in property <bool> completion-visible;
    in property <int> completion-selected;
    callback completion-choose(int);
    // Bumped by the host whenever the cursor jumps somewhere that isn't
    // necessarily on screen (e.g. a find match) so the viewport follows it.
    // Not bound continuously — that would fight the user's own wheel/drag
    // scrolling on `edit-scroll`.
    in property <int> scroll-request: 0;

    property <length> line-h: 21px;
    property <length> gutter-w: 40px;
    // IBM Plex Mono advance width: 600/1000 em, read straight from the hmtx
    // table of the font vendored in assets/fonts. Taken from the font metric
    // rather than measured off a hidden Text probe because `preferred-width`
    // is not a reliable multiple of the advance at every size -- at
    // font-base 14px it reports 85.05px for ten characters that render in
    // 84.0px, and that 0.1px per character piles up until the caret sits
    // whole characters away from the glyph it belongs to on a long line.
    property <length> charw: Tokens.font-md * 0.6;

    background: Tokens.canvas;

    // Land the match a full line short of the edge on both sides (not flush
    // against it) so it doesn't read as clipped, and account for the
    // VerticalLayout's own padding-top so the math matches the caret's.
    changed scroll-request => {
        edit-scroll.viewport-y = clamp(
            edit-scroll.viewport-y,
            // caret one line clear of the top edge — the smaller bound, since
            // viewport-y grows towards 0 as the content scrolls back up
            root.line-h - Tokens.sp2 - root.cursor-visual-row * root.line-h,
            // …and one line clear of the bottom edge
            edit-scroll.visible-height - Tokens.sp2
                - root.cursor-visual-row * root.line-h - 2 * root.line-h);
        // Same idea, horizontally — a long single-line query otherwise leaves
        // the caret scrolled out of sight after Cmd+Right/End or typing past
        // the right edge, with nothing bringing the viewport back to it.
        //
        // The near-side bound deliberately omits the gutter-w + sp3 offset
        // that the caret's own x-coordinate carries (unlike the vertical
        // case, there's a real gutter to the left of column 0): keeping it
        // would clamp viewport-x to a small negative value instead of 0 once
        // the caret returns near the start of the line, leaving the gutter
        // clipped off the left edge after scrolling back from a long line.
        edit-scroll.viewport-x = clamp(
            edit-scroll.viewport-x,
            root.charw - Tokens.sp2 - root.cursor-col * root.charw,
            edit-scroll.visible-width - Tokens.sp2
                - (root.gutter-w + Tokens.sp3 + root.cursor-col * root.charw)
                - 2 * root.charw);
    }

    focus-scope := FocusScope {
        key-pressed(e) => {
            if (root.edit-key(e.text, e.modifiers.meta || e.modifiers.control, e.modifiers.alt, e.modifiers.shift)) {
                return accept;
            }
            return reject;
        }

        edit-scroll := ScrollView {
            // Let the per-line TouchArea own mouse drags for text selection;
            // otherwise the Flickable hijacks a >8px drag as a pan and cancels
            // the selection. Wheel/trackpad scrolling is unaffected.
            mouse-drag-pan-enabled: false;
            width: 100%;
            height: 100%;
            VerticalLayout {
                width: max(self.preferred-width, parent.visible-width);
                alignment: start;
                padding-top: Tokens.sp2;
                padding-bottom: Tokens.sp2;

                for line[li] in root.lines: Rectangle {
                    height: root.line-hidden[li] ? 0 : root.line-h;
                    clip: true;
                    visible: !root.line-hidden[li];
                    background: li == root.error-line ? Tokens.error.with-alpha(0.16)
                        : (root.error-from >= 0 && li >= root.error-from && li <= root.error-to)
                            ? Tokens.error.with-alpha(0.06)
                        : li == root.cursor-line ? Tokens.editor-line : transparent;

                    // Char column under the pointer, hit-tested from the mono
                    // advance width. Rows below the text area (drag) add a line
                    // delta so a drag can cross lines while still grabbed here.
                    property <int> hit-col:
                        max(0, round((line-ta.mouse-x - root.gutter-w - Tokens.sp3) / root.charw));
                    // Rows the pointer has travelled from this one, signed. A
                    // press is always inside its own row, so only a drag ever
                    // sees anything but 0.
                    property <int> hit-rows: floor(line-ta.mouse-y / root.line-h);

                    line-ta := TouchArea {
                        // Sub-pixel jitter between the two taps of a double-click
                        // used to fire `moved` → drag a zero-width selection, which
                        // swallowed the double-click so word-select never landed.
                        // Only treat it as a drag once the pointer clears a small
                        // threshold from where it went down.
                        property <length> press-x;
                        property <length> press-y;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                focus-scope.focus();
                                self.press-x = self.mouse-x;
                                self.press-y = self.mouse-y;
                                root.press-pos(li, parent.hit-col, e.modifiers.shift);
                            }
                        }
                        moved => {
                            if (self.pressed
                                && (abs(self.mouse-x - self.press-x) > 3px
                                    || abs(self.mouse-y - self.press-y) > 3px)) {
                                root.drag-pos(li, parent.hit-rows, parent.hit-col);
                            }
                        }
                        double-clicked => {
                            root.select-word(li, parent.hit-col);
                        }
                    }

                    HorizontalLayout {
                        spacing: 0;
                        // gutter: fold-arrow slot (left) + line number (right)
                        Rectangle {
                            width: root.gutter-w;
                            HorizontalLayout {
                                padding-right: 6px;
                                spacing: 2px;
                                Rectangle {
                                    width: 14px;
                                    if root.fold-state[li] != 0: fold-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.toggle-fold(li);
                                        }
                                        // "fold", not the shared "caret": that
                                        // one draws a 12x6 stroke inside a 24x24
                                        // box, so at this size only ~6x3px of
                                        // hairline chevron survives and reads as
                                        // a stray tick. This glyph is a solid
                                        // triangle in a box its own size.
                                        AppIcon {
                                            name: "fold";
                                            size: 10px;
                                            color: fold-ta.has-hover ? Tokens.accent : Tokens.text-dim;
                                            transform-rotation: root.fold-state[li] == 2 ? -90deg : 0deg;
                                        }
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    text: li + 1;
                                    color: li == root.error-line ? Tokens.error
                                        : (root.error-from >= 0 && li >= root.error-from
                                            && li <= root.error-to) ? Tokens.error.with-alpha(0.55)
                                        : li == root.cursor-line ? Tokens.text : Tokens.text-ghost;
                                    font-family: Tokens.mono;
                                    font-size: Tokens.font-sm;
                                    font-weight: li == root.error-line ? 700
                                        : li == root.cursor-line ? 600 : 400;
                                }
                            }
                        }
                        Rectangle { width: Tokens.sp3; }
                        // colored spans (selected ones get a tinted background)
                        Rectangle {
                            horizontal-stretch: 1;
                            // Keep the row as wide as its text so the ScrollView
                            // still knows how far a long line reaches.
                            min-width: line.length > 0
                                ? root.charw * (line[line.length - 1].col
                                    + line[line.length - 1].cols)
                                : 0px;
                            for span in line: Rectangle {
                                // Absolute position on the caret's charw grid.
                                // Stacking these in a layout made every span box
                                // round to a whole pixel, and with charw at 7.8px
                                // the error piled up along the line until the text
                                // sat visibly off the caret.
                                x: root.charw * span.col;
                                width: root.charw * span.cols;
                                height: 100%;
                                clip: true;
                                background: span.sel ? Tokens.accent.with-alpha(0.18) : transparent;
                                Text {
                                    x: 0;
                                    vertical-alignment: center;
                                    text: span.text;
                                    font-family: Tokens.mono;
                                    font-size: Tokens.font-md;
                                    color: span.kind == 1 ? Tokens.syn-keyword
                                        : span.kind == 2 ? Tokens.syn-string
                                        : span.kind == 3 ? Tokens.syn-function
                                        : span.kind == 4 ? Tokens.syn-comment
                                        : span.kind == 6 ? Tokens.error
                                        : Tokens.text;
                                    font-weight: span.kind == 1 ? Tokens.weight-emphasis : 400;
                                    font-italic: span.kind == 4;
                                }
                            }
                        }
                    }

                    // squiggle under the token that failed
                    if li == root.error-line && root.error-len > 0: Image {
                        x: root.gutter-w + Tokens.sp3 + root.error-col * root.charw;
                        y: root.line-h - 4px;
                        width: root.error-len * root.charw;
                        height: 3px;
                        source: @image-url("icons/squiggle.svg");
                        horizontal-tiling: repeat;
                        colorize: Tokens.error;
                    }

                    // caret
                    if li == root.cursor-line && focus-scope.has-focus: Rectangle {
                        // Snapped to a whole pixel: charw is 7.8px, so an
                        // unrounded x left the caret antialiased across three
                        // columns and smudged into the glyph next to it.
                        x: round((root.gutter-w + Tokens.sp3
                            + root.cursor-col * root.charw) / 1px) * 1px;
                        y: 2px;
                        width: 2px;
                        height: parent.height - 4px;
                        background: Tokens.accent;
                    }
                }
            }
        }
    }

    // ghost placeholder: only when the buffer is a single empty line
    if root.placeholder != "" && root.lines.length <= 1
        && (root.lines.length == 0 || root.lines[0].length == 0): Text {
        x: root.gutter-w + Tokens.sp3;
        y: Tokens.sp2;
        height: root.line-h;
        text: root.placeholder;
        color: Tokens.text-ghost;
        font-family: Tokens.mono;
        font-size: Tokens.font-md;
        vertical-alignment: center;
    }

    // ----- autocomplete popup (overlays the editor, under the caret) -----
    if root.completion-visible && root.completion-items.length > 0: CompletionList {
        // Anchor to the caret's *visual* position: the caret lives inside the
        // scrolled line list, so the popup (a sibling of the scroll view) has to
        // fold in the padding and the scroll offset — otherwise a restored tab,
        // whose cursor lands on the last line, paints the popup far below the
        // viewport and it never shows. Below the caret by default; flip above when
        // that would clip past the editor's bottom edge.
        //
        // Clamp the caret anchor into the editor's own height so the popup stays
        // on-screen even when the scroll offset can't be read precisely (a short,
        // scrolled editor otherwise threw the anchor a thousand px down).
        // `viewport-y` is negative while scrolling. Keep the caret's visual
        // coordinate, rather than clamping a stale content-space coordinate.
        property <length> caret-y: clamp(Tokens.sp2 + root.cursor-visual-row * root.line-h + edit-scroll.viewport-y, Tokens.sp2, root.height - root.line-h);
        property <length> below-y: caret-y + root.line-h + 6px;
        property <length> above-y: caret-y - self.natural-height - 6px;
        items: root.completion-items;
        selected: root.completion-selected;
        choose(i) => { root.completion-choose(i); }
        x: min(root.gutter-w + Tokens.sp3 + root.cursor-col * root.charw + edit-scroll.viewport-x, root.width - self.width - Tokens.sp2);
        y: below-y + self.natural-height > root.height && above-y > 0 ? above-y : below-y;
    }
}

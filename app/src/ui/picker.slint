// Connections screen: grouped connection list (left, sidebar surface) +
// selected-connection detail panel (right, canvas surface).
// Reference: design/1-connections.png.
import { Tokens } from "tokens.slint";
import {
    DbBadge, OutlineChip, PrimaryButton, SecondaryButton, TextButton,
    TagChip, FilterField
} from "components.slint";
import { ConnItem, KvRow } from "structs.slint";
import { ScrollView } from "std-widgets.slint";

export component ConnPicker inherits Rectangle {
    in property <[ConnItem]> connections;
    in property <int> selected-conn: -1;
    in property <string> error;
    // True while a connect attempt is in flight (button shows a spinner label).
    in property <bool> connecting;

    // Detail panel (filled by Rust when a row is selected).
    in property <string> sel-name;
    in property <string> sel-engine;
    in property <string> sel-sub;      // "PostgreSQL · grup profin"
    in property <bool> sel-local;
    in property <[KvRow]> sel-rows;
    in property <[string]> sel-tags;
    in property <string> sel-footer;   // "Terakhir terhubung · 2 menit lalu · …"

    callback select-conn(int);
    callback connect-clicked(int);
    callback cancel-connect();
    callback test-clicked(int);
    callback add-clicked();
    callback edit-clicked(int);
    callback import-clicked();
    callback backup-clicked();
    callback toggle-group(string);
    callback filter(string);

    background: Tokens.canvas;

    HorizontalLayout {
        spacing: 0;

        // ================= left: grouped list =================
        Rectangle {
            width: 352px;
            background: Tokens.sidebar;

            VerticalLayout {
                spacing: 0;

                // ----- filter row -----
                HorizontalLayout {
                    padding: Tokens.sp3;
                    padding-top: Tokens.sp4;
                    padding-bottom: Tokens.sp3;
                    spacing: Tokens.sp3;
                    FilterField {
                        height: 30px;
                        horizontal-stretch: 1;
                        placeholder: "Filter connections...";
                        edited(t) => { root.filter(t); }
                    }
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: Tokens.radius;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: Tokens.card;
                        Text {
                            text: "+";
                            color: add-ta.has-hover ? Tokens.text : Tokens.text-dim;
                            font-size: 17px;
                        }
                        add-ta := TouchArea { clicked => { root.add-clicked(); } }
                    }
                }

                // ----- grouped rows -----
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-left: Tokens.sp3;
                        padding-right: Tokens.sp3;
                        spacing: Tokens.sp1;
                        alignment: start;

                        for item[i] in root.connections: Rectangle {
                            height: item.is-header ? 28px : 40px;

                            // --- group header row ---
                            if item.is-header: Rectangle {
                                hdr-ta := TouchArea {
                                    clicked => { root.toggle-group(item.name); }
                                }
                                HorizontalLayout {
                                    spacing: Tokens.sp2;
                                    alignment: start;
                                    Text {
                                        text: item.expanded ? "▾" : "▸";
                                        color: Tokens.text-faint;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: item.name;
                                        color: Tokens.text-dim;
                                        font-size: Tokens.font-xs;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: item.count;
                                        color: Tokens.text-faint;
                                        font-size: Tokens.font-sm;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // --- connection row --- (selected-conn = store index)
                            if !item.is-header: Rectangle {
                                border-radius: Tokens.radius-lg;
                                background: item.index == root.selected-conn ? Tokens.accent-tint
                                    : row-ta.has-hover ? Tokens.border : transparent;
                                border-width: item.index == root.selected-conn ? 1px : 0;
                                border-color: Tokens.accent.with-alpha(0.35);
                                animate background { duration: Tokens.fade; }

                                // selection = 2px accent left bar (never a pill)
                                if item.index == root.selected-conn: Rectangle {
                                    x: 0;
                                    width: Tokens.selection-bar-w;
                                    height: parent.height;
                                    background: Tokens.accent;
                                    border-radius: 1px;
                                }

                                row-ta := TouchArea {
                                    clicked => { root.select-conn(item.index); }
                                    double-clicked => { root.connect-clicked(item.index); }
                                }

                                HorizontalLayout {
                                    padding-left: Tokens.sp3;
                                    padding-right: Tokens.sp3;
                                    spacing: Tokens.sp3;
                                    VerticalLayout {
                                        alignment: center;
                                        DbBadge { engine: item.engine; size: 24px; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: item.name;
                                            color: Tokens.text;
                                            font-size: Tokens.font-md;
                                            font-weight: Tokens.weight-emphasis;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: item.subline;
                                            color: Tokens.text-dim;
                                            font-size: Tokens.font-xs;
                                            font-family: Tokens.mono;
                                            overflow: elide;
                                        }
                                    }
                                    if item.local: VerticalLayout {
                                        alignment: center;
                                        OutlineChip { text: "LOCAL"; }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- footer actions -----
                Rectangle { height: 1px; background: Tokens.border; }
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: Tokens.sp6;
                        padding-right: Tokens.sp6;
                        spacing: Tokens.sp4;
                        Rectangle {
                            width: new-row.preferred-width;
                            new-row := HorizontalLayout {
                                spacing: Tokens.sp2;
                                Text {
                                    text: "+";
                                    color: Tokens.text;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "New Connection";
                                    color: Tokens.text;
                                    font-size: Tokens.font-md;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            new-ta := TouchArea { clicked => { root.add-clicked(); } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Tokens.sp4;
                                TextButton { text: "Import"; clicked => { root.import-clicked(); } }
                                TextButton { text: "Backup"; clicked => { root.backup-clicked(); } }
                            }
                        }
                    }
                }
            }

            // right hairline separating list from detail
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Tokens.border;
            }
        }

        // ================= right: detail panel =================
        Rectangle {
            background: Tokens.canvas;
            horizontal-stretch: 1;

            if root.selected-conn < 0: Text {
                text: root.error == "" ? "Select a connection" : root.error;
                color: root.error == "" ? Tokens.text-faint : Tokens.error;
                font-size: Tokens.font-md;
            }

            if root.selected-conn >= 0: VerticalLayout {
                spacing: 0;

                VerticalLayout {
                    padding: 34px;
                    padding-top: 32px;
                    spacing: Tokens.sp6;
                    alignment: start;
                    vertical-stretch: 1;

                    // ----- header row -----
                    HorizontalLayout {
                        spacing: Tokens.sp4;
                        DbBadge { engine: root.sel-engine; size: 44px; }
                        VerticalLayout {
                            alignment: center;
                            spacing: Tokens.sp1;
                            HorizontalLayout {
                                spacing: Tokens.sp3;
                                alignment: start;
                                Text {
                                    text: root.sel-name;
                                    color: Tokens.text;
                                    font-size: 18px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if root.sel-local: VerticalLayout {
                                    alignment: center;
                                    OutlineChip { text: "LOCAL"; }
                                }
                            }
                            Text {
                                text: root.sel-sub;
                                color: Tokens.text-dim;
                                font-size: Tokens.font-md;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Tokens.sp2;
                                PrimaryButton {
                                    text: root.connecting ? "Connecting…" : "Connect";
                                    enabled: !root.connecting;
                                    height: 30px;
                                    clicked => { root.connect-clicked(root.selected-conn); }
                                }
                                if root.connecting: SecondaryButton {
                                    text: "Cancel";
                                    height: 30px;
                                    clicked => { root.cancel-connect(); }
                                }
                                SecondaryButton {
                                    text: "Test";
                                    height: 30px;
                                    clicked => { root.test-clicked(root.selected-conn); }
                                }
                                SecondaryButton {
                                    text: "Edit";
                                    height: 30px;
                                    clicked => { root.edit-clicked(root.selected-conn); }
                                }
                            }
                        }
                    }

                    // Connection error surfaced next to the Connect button.
                    if root.error != "": Text {
                        text: root.error;
                        color: Tokens.error;
                        font-size: Tokens.font-sm;
                        wrap: word-wrap;
                    }

                    // ----- key/value card -----
                    Rectangle {
                        border-radius: Tokens.radius-lg;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: Tokens.card;
                        height: kv-col.preferred-height;
                        clip: true;
                        kv-col := VerticalLayout {
                            for row[ri] in root.sel-rows: Rectangle {
                                height: 33px;
                                if ri > 0: Rectangle {
                                    y: 0;
                                    height: 1px;
                                    width: parent.width;
                                    background: Tokens.border;
                                }
                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    Text {
                                        width: 105px;
                                        text: row.k;
                                        color: Tokens.text-dim;
                                        font-size: Tokens.font-md;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.v;
                                        color: Tokens.text;
                                        font-size: Tokens.font-md;
                                        font-family: Tokens.mono;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ----- tag chips -----
                    HorizontalLayout {
                        spacing: Tokens.sp2;
                        alignment: start;
                        for t in root.sel-tags: TagChip { text: t; }
                    }
                }

                // ----- footer status -----
                Rectangle { height: 1px; background: Tokens.border; }
                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        padding-left: 34px;
                        Text {
                            text: root.sel-footer;
                            color: Tokens.text-faint;
                            font-size: Tokens.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

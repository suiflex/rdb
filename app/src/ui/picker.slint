// Connections screen: grouped connection list (left, sidebar surface) +
// selected-connection detail panel (right, canvas surface).
// Reference: design/1-connections.png.
import { Tokens } from "tokens.slint";
import {
    DbBadge, OutlineChip, PrimaryButton, SecondaryButton, TextButton,
    TagChip, FilterField, Tooltip, FloatingCard, DangerButton
} from "components.slint";
import { AppIcon } from "icons.slint";
import { ConnItem, KvRow, TopLevelGroup } from "structs.slint";
import { ScrollView } from "std-widgets.slint";

export component ConnPicker inherits Rectangle {
    in property <[TopLevelGroup]> connections;
    in property <int> selected-conn: -1;
    in property <string> error;
    // True while a connect attempt is in flight (button shows a spinner label).
    in property <bool> connecting;

    // Detail panel (filled by Rust when a row is selected).
    in property <string> sel-name;
    in property <string> sel-engine;
    in property <color> sel-color;
    in property <bool> sel-has-custom-color;
    in property <string> sel-sub;      // "PostgreSQL · grup profin"
    in property <bool> sel-local;
    in property <string> sel-env-tag-label;
    in property <color> sel-env-tag-color;
    in property <[KvRow]> sel-rows;
    in property <[string]> sel-tags;
    in property <string> sel-footer;   // "Terakhir terhubung · 2 menit lalu · …"

    callback select-conn(int);
    callback connect-clicked(int);
    callback cancel-connect();
    callback test-clicked(int);
    callback add-clicked();
    // "New Subgroup" on a group's context menu: opens the add-connection
    // form with the Group field ready for a full path (arg is the parent
    // group's path, informational only — the text itself starts empty).
    callback add-conn-in-group(string);
    callback edit-clicked(int);
    // Export saved connections to ~/Downloads. Arg is the format: 0 = JSON, 1 = CSV.
    callback export-conns(int);
    callback toggle-group(string);
    // Right-click a group header: rename (old, new) or delete it (its
    // connections fall back to Ungrouped, nothing is destroyed).
    callback group-rename(string, string);
    callback group-delete(string);
    // Toggle the starred flag on a connection (arg is the store index).
    callback toggle-favorite(int);
    // Drag-reorder/move: (store index of dragged row, signed row-step delta
    // for a same-group reorder, release Y relative to the list content's top
    // for cross-group drop detection).
    callback reorder-conn(int, int, int);
    callback filter(string);
    // Open an external link (Product Hunt / GitHub) in the system browser.
    callback open-url(string);

    // Group header context menu (Rename/Delete) + its rename modal state.
    property <string> group-menu-target: "";
    property <int> group-menu-target-depth: 0;
    property <length> group-menu-x: 0px;
    property <length> group-menu-y: 0px;
    property <bool> rename-modal-open: false;
    property <string> rename-old: "";
    property <string> rename-text: "";
    property <bool> delete-confirm-open: false;
    property <string> delete-confirm-target: "";

    background: Tokens.canvas;

    HorizontalLayout {
        spacing: 0;

        // ================= left: floating grouped list =================
        // Canvas gutter around the card so the sidebar reads as a floating
        // panel (rounded, bordered, drop-shadow) instead of a flush column.
        Rectangle {
            width: 560px;
            background: Tokens.canvas;

            card := FloatingCard {
                x: Tokens.sp3;
                y: Tokens.sp3;
                width: parent.width - 2 * Tokens.sp3;
                height: parent.height - 2 * Tokens.sp3;

            VerticalLayout {
                spacing: 0;

                // ----- filter row -----
                HorizontalLayout {
                    padding: Tokens.sp3;
                    padding-top: Tokens.sp4;
                    padding-bottom: Tokens.sp3;
                    spacing: Tokens.sp3;
                    FilterField {
                        height: 30px;
                        horizontal-stretch: 1;
                        placeholder: "Filter connections...";
                        edited(t) => { root.filter(t); }
                    }
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: Tokens.radius;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: Tokens.card;
                        Text {
                            text: "+";
                            color: add-ta.has-hover ? Tokens.text : Tokens.text-dim;
                            font-size: 17px;
                        }
                        add-ta := TouchArea { clicked => { root.add-clicked(); } }
                    }
                }

                // ----- grouped rows -----
                ScrollView {
                    vertical-stretch: 1;
                    list-content := VerticalLayout {
                        padding-left: Tokens.sp3;
                        padding-right: Tokens.sp3;
                        // Spacing here is *between* top-level group cards only
                        // — each card below is its own element now, so this
                        // is the one place that gap needs to be expressed.
                        spacing: Tokens.sp2;
                        alignment: start;

                        for grp[gi] in root.connections: Rectangle {
                            // One continuous card around a whole top-level
                            // group — its header, every nested subgroup, and
                            // any of its own direct connections — so all of
                            // it reads as belonging to the same group no
                            // matter how a nested subgroup's own distinct
                            // color breaks up the fill inside. The no-groups
                            // case (`has-header` false, nothing ever put in a
                            // group) has nothing to outline — it's just the
                            // bare connection list on the canvas, as before.
                            height: gwrap.preferred-height;
                            background: grp.has-header ? Tokens.card : transparent;
                            border-width: grp.has-header ? 1px : 0px;
                            border-color: Tokens.border-strong;
                            border-radius: Tokens.radius-lg;

                            gwrap := VerticalLayout {
                                padding: grp.has-header ? 1px : 0px;
                                spacing: 0px;
                                alignment: start;

                                for item[i] in grp.rows: Rectangle {
                            // A box "starts" on a header row (top-level group or
                            // nested subgroup alike), or on a *nested* row whose
                            // depth differs from the row before it (a subgroup's
                            // own connections resuming after a deeper nested
                            // subgroup ends). A depth-0 row never starts its own
                            // box this way — a group's direct connections
                            // resuming after a subgroup must stay flush and same
                            // color as their header, or they read as detached
                            // from the group instead of still belonging to it.
                            // A box "ends" on the last row before depth drops
                            // back out of it, or before a sibling header at the
                            // same depth begins — which also naturally closes a
                            // collapsed (childless) header's box on itself. This
                            // one rule generalizes the old depth-0-only
                            // `is-group-end` special case to any nesting depth.
                            property <bool> box-top: item.is-header || i == 0
                                || (item.depth > 0 && grp.rows[i - 1].depth != item.depth);
                            property <bool> box-bottom: i == grp.rows.length - 1
                                || grp.rows[i + 1].depth < item.depth
                                || (grp.rows[i + 1].depth == item.depth && grp.rows[i + 1].is-header);
                            property <length> content-h: item.is-header ? 28px : 40px;
                            // A gap only belongs *between* sibling boxes at the
                            // same-or-shallower level (a new subgroup starting,
                            // or a parent's own rows resuming after one ends) —
                            // never between a header and the first row of its
                            // own box, which must stay visually attached.
                            property <bool> needs-gap: box-top && i > 0
                                && grp.rows[i - 1].depth >= item.depth;

                            height: needs-gap ? content-h + Tokens.sp2 : content-h;
                            background: transparent;

                            // Card surface: the top-level group's card keeps its
                            // usual full-width fill; a subgroup gets an inset,
                            // differently-shaded surface so it reads as its own
                            // card nested inside the parent group's card.
                            card-box := Rectangle {
                                y: parent.height - content-h;
                                height: content-h;
                                x: item.depth * Tokens.sp2;
                                width: parent.width - 2 * self.x;
                                background: item.depth > 0 ? Tokens.canvas : Tokens.card;
                                border-top-left-radius: box-top ? Tokens.radius-lg : 0px;
                                border-top-right-radius: box-top ? Tokens.radius-lg : 0px;
                                border-bottom-left-radius: box-bottom ? Tokens.radius-lg : 0px;
                                border-bottom-right-radius: box-bottom ? Tokens.radius-lg : 0px;

                            // --- group header row ---
                            if item.is-header: Rectangle {
                                width: parent.width;
                                height: parent.height;
                                hdr-ta := TouchArea {
                                    // `item.group` is the raw-case key stored on
                                    // SavedConnection; `item.name` is uppercased
                                    // for display only — using it here would
                                    // silently desync collapse state for any
                                    // group name that isn't already all-caps.
                                    clicked => { root.toggle-group(item.group); }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down
                                            && e.button == PointerEventButton.right
                                            && item.group != "Ungrouped") {
                                            root.group-menu-target = item.group;
                                            root.group-menu-target-depth = item.depth;
                                            root.group-menu-x = self.absolute-position.x - root.absolute-position.x;
                                            root.group-menu-y = self.absolute-position.y - root.absolute-position.y;
                                            group-menu.show();
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    // Explicit fill so the trailing stretch spacer
                                    // below has real room to push the menu button to
                                    // the true right edge, and so the button — laid
                                    // out through the same container as the label
                                    // text — shares its vertical centering exactly
                                    // instead of drifting from a separately computed
                                    // position.
                                    width: parent.width;
                                    height: parent.height;
                                    padding-left: Tokens.sp2 + item.depth * Tokens.sp3;
                                    spacing: Tokens.sp2;
                                    // No `alignment: start` here (deliberately) — that
                                    // mode disables stretch factors entirely, which is
                                    // exactly what silently broke the menu button
                                    // pushing itself to the right edge. Default
                                    // (stretch) leaves the Text children untouched
                                    // (content-sized, so their stretch factor is 0)
                                    // and lets the trailing spacer Rectangle absorb
                                    // the remaining width instead.
                                    // Same circular caret badge the ⌘O "Open
                                    // Connection" modal uses for its group rows
                                    // (palette.slint), rotated instead of swapping
                                    // glyphs, so both surfaces read identically.
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 8px;
                                            border-width: 1.5px;
                                            border-color: Tokens.warn;
                                            AppIcon {
                                                name: "caret";
                                                size: 8px;
                                                color: Tokens.warn;
                                                // chevron glyph's visual mass sits at
                                                // its bottom vertex, so geometric
                                                // centering still reads slightly low —
                                                // nudge up 1px to compensate
                                                y: (parent.height - self.height) / 2 - 1px;
                                                transform-rotation: item.expanded ? 0deg : -90deg;
                                            }
                                        }
                                    }
                                    // All-caps text has no descenders, so its visible
                                    // glyphs sit slightly above the true vertical center
                                    // of the line box — the extra padding-top (vs. none
                                    // on bottom) shifts the centered position down ~1px
                                    // to read level with the caret badge / "⋯" button.
                                    VerticalLayout {
                                        alignment: center;
                                        padding-top: 2px;
                                        Text {
                                            text: item.name;
                                            color: Tokens.text-dim;
                                            font-size: Tokens.font-xs;
                                            font-weight: 700;
                                            letter-spacing: 0.8px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        padding-top: 2px;
                                        Text {
                                            text: item.count;
                                            color: Tokens.text-faint;
                                            font-size: Tokens.font-sm;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    // Visible Rename/Delete affordance — right-click
                                    // does the same, but a hidden-until-hover button
                                    // is the only discoverable path on a fresh
                                    // install. Three plain dots, not a Unicode
                                    // glyph — the app's bundled fonts don't cover
                                    // "…"/"⋯" and it fell back to a tofu box.
                                    if item.group != "Ungrouped": VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            // square + fully round so the hover halo
                                            // is always a circle centered on the dots,
                                            // instead of an off-square rounded rect
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            opacity: hdr-ta.has-hover || gmore-ta.has-hover ? 1.0 : 0.0;
                                            background: gmore-ta.has-hover ? Tokens.card.with-alpha(0.5) : transparent;
                                            // HorizontalLayout's cross (vertical) axis
                                            // defaults to `stretch`, which doesn't
                                            // resize a fixed-height child but doesn't
                                            // center it either — dots sat pinned to
                                            // the top instead of the circle's middle.
                                            // Wrap in a VerticalLayout for its own
                                            // (supported) main-axis centering.
                                            VerticalLayout {
                                                alignment: center;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    for _dot in [0, 1, 2]: Rectangle {
                                                        width: 3px;
                                                        height: 3px;
                                                        border-radius: 1.5px;
                                                        background: Tokens.text-faint;
                                                    }
                                                }
                                            }
                                            gmore-ta := TouchArea {
                                                clicked => {
                                                    root.group-menu-target = item.group;
                                                    root.group-menu-target-depth = item.depth;
                                                    root.group-menu-x = self.absolute-position.x - root.absolute-position.x;
                                                    root.group-menu-y = self.absolute-position.y - root.absolute-position.y;
                                                    group-menu.show();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // --- connection row --- (selected-conn = store index)
                            if !item.is-header: Rectangle {
                                // Only the selected row fills — solid brand color
                                // so it dominates the list (CodexBar-style). Idle
                                // rows stay plain (engine color still reads from
                                // the badge square); hover gets a faint tint.
                                property <color> tint: item.has-custom-color ? item.color : Tokens.db-color(item.engine);
                                property <bool> selected: item.index == root.selected-conn;
                                border-radius: Tokens.radius-lg;
                                background: selected ? tint
                                    : row-ta.has-hover ? tint.with-alpha(0.14)
                                    : transparent;
                                animate background { duration: Tokens.fade; }
                                // "Grabbed" affordance while dragging the handle:
                                // Slint can't cheaply follow the cursor without a
                                // feedback loop, so lift + outline signals the drag
                                // is live; the drop lands on pointer release.
                                border-width: grip-ta.pressed ? 1px : 0;
                                border-color: Tokens.accent;
                                drop-shadow-blur: grip-ta.pressed ? 14px : 0;
                                drop-shadow-color: #00000055;

                                row-ta := TouchArea {
                                    clicked => { root.select-conn(item.index); }
                                    double-clicked => { root.connect-clicked(item.index); }
                                }

                                HorizontalLayout {
                                    padding-left: Tokens.sp3 + item.depth * Tokens.sp3;
                                    padding-right: Tokens.sp3;
                                    spacing: Tokens.sp3;
                                    // Drag handle: reorders within the group.
                                    // Always rendered (so the pointer grab isn't
                                    // dropped mid-drag when the row loses hover);
                                    // faint until hovered. Emits a row-step delta
                                    // on release for Rust to resolve.
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 12px;
                                            opacity: row-ta.has-hover || grip-ta.has-hover || grip-ta.pressed ? 1.0 : 0.0;
                                            AppIcon {
                                                name: "grip";
                                                size: 12px;
                                                color: selected ? white.with-alpha(0.7) : Tokens.text-faint;
                                            }
                                            grip-ta := TouchArea {
                                                mouse-cursor: grab;
                                                pointer-event(ev) => {
                                                    if ev.kind == PointerEventKind.up {
                                                        // Row-step delta for a same-group reorder, plus the
                                                        // release point's Y relative to the top of the (already
                                                        // scrolled) list content — Rust maps that to whichever
                                                        // row/header it landed on to detect a cross-group drop.
                                                        // Both are in the same on-screen coordinate frame, so
                                                        // scroll offset cancels out of the subtraction.
                                                        root.reorder-conn(
                                                            item.index,
                                                            round((self.mouse-y - self.pressed-y) / 40px),
                                                            round((self.absolute-position.y + self.mouse-y
                                                                - list-content.absolute-position.y) / 1px));
                                                    }
                                                }
                                                changed has-hover => {
                                                    if self.has-hover {
                                                        Tooltip.text = "Drag to reorder";
                                                        Tooltip.x = self.absolute-position.x + self.width / 2;
                                                        Tooltip.y = self.absolute-position.y + self.height + 4px;
                                                        Tooltip.shown = true;
                                                    } else if Tooltip.text == "Drag to reorder" {
                                                        Tooltip.shown = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        // ring keeps the same-color badge visible
                                        // on the solid selected fill
                                        DbBadge {
                                            engine: item.engine;
                                            size: 24px;
                                            fill: item.has-custom-color ? item.color : Tokens.db-color(item.engine);
                                            border-width: selected ? 1px : 0;
                                            border-color: white.with-alpha(0.5);
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: item.name;
                                            color: selected ? white : Tokens.text;
                                            font-size: Tokens.font-md;
                                            font-weight: Tokens.weight-emphasis;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: item.subline;
                                            color: selected ? white.with-alpha(0.75) : Tokens.text-dim;
                                            font-size: Tokens.font-xs;
                                            font-family: Tokens.mono;
                                            overflow: elide;
                                        }
                                    }
                                    if item.local: VerticalLayout {
                                        alignment: center;
                                        OutlineChip { text: "LOCAL"; }
                                    }
                                    if item.env-tag-label != "": VerticalLayout {
                                        alignment: center;
                                        OutlineChip { text: item.env-tag-label; tint: item.env-tag-color; }
                                    }
                                    // Star toggle: always present (so its own
                                    // TouchArea keeps receiving clicks); shown when
                                    // starred or on hover. Gating on `if` here would
                                    // remove the element the instant the pointer
                                    // enters it and steals hover from the row.
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            opacity: item.favorite || row-ta.has-hover || star-ta.has-hover ? 1.0 : 0.0;
                                            border-radius: Tokens.radius;
                                            background: star-ta.has-hover ? Tokens.card.with-alpha(0.4) : transparent;
                                            Text {
                                                text: item.favorite ? "★" : "☆";
                                                color: item.favorite
                                                    ? #f5b301
                                                    : (selected ? white.with-alpha(0.8) : Tokens.text-faint);
                                                font-size: 15px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            star-ta := TouchArea {
                                                clicked => { root.toggle-favorite(item.index); }
                                                changed has-hover => {
                                                    if self.has-hover {
                                                        Tooltip.text = item.favorite ? "Remove favorite" : "Add to favorites";
                                                        Tooltip.x = self.absolute-position.x + self.width / 2;
                                                        Tooltip.y = self.absolute-position.y + self.height + 4px;
                                                        Tooltip.shown = true;
                                                    } else {
                                                        Tooltip.shown = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            } // card-box
                                }
                            } // gwrap
                        }
                    }
                }

                // ----- footer actions -----
                Rectangle { height: 1px; background: Tokens.border; }
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: Tokens.sp6;
                        padding-right: Tokens.sp6;
                        spacing: Tokens.sp4;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                            width: new-row.preferred-width;
                            height: 30px;
                            border-radius: Tokens.radius;
                            background: new-ta.has-hover ? Tokens.border : transparent;
                            animate background { duration: Tokens.fade; }
                            new-row := HorizontalLayout {
                                spacing: Tokens.sp2;
                                padding-left: Tokens.sp3;
                                padding-right: Tokens.sp3;
                                alignment: center;
                                Text {
                                    text: "+";
                                    color: Tokens.text;
                                    font-size: Tokens.font-md;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "New Connection";
                                    color: Tokens.text;
                                    font-size: Tokens.font-md;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            new-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add-clicked(); }
                            }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Tokens.sp4;
                                Rectangle {
                                    width: exp-btn.preferred-width;
                                    height: exp-btn.preferred-height;
                                    export-menu := PopupWindow {
                                        // See ExportButton: default close-on-click
                                        // eats the press before the row click fires.
                                        close-policy: close-on-click-outside;
                                        x: 0;
                                        y: -76px;
                                        width: 130px;
                                        height: menu-box.preferred-height;
                                        menu-box := Rectangle {
                                            background: Tokens.card;
                                            border-width: 1px;
                                            border-color: Tokens.border-strong;
                                            border-radius: Tokens.radius;
                                            drop-shadow-blur: 12px;
                                            drop-shadow-color: #00000022;
                                            VerticalLayout {
                                                padding: 4px;
                                                for opt[i] in ["JSON", "CSV"]: Rectangle {
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: exp-row-ta.has-hover ? Tokens.accent-tint : transparent;
                                                    exp-row-ta := TouchArea {
                                                        clicked => { root.export-conns(i); export-menu.close(); }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: Tokens.sp2;
                                                        Text {
                                                            text: opt;
                                                            color: Tokens.text;
                                                            font-size: Tokens.font-sm;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    exp-btn := TextButton { text: "Export ▾"; clicked => { export-menu.show(); } }
                                }
                            }
                        }
                    }
                }
            }
            }
        }

        // ================= right: detail panel =================
        Rectangle {
            background: Tokens.canvas;
            horizontal-stretch: 1;

            if root.selected-conn < 0: VerticalLayout {
                alignment: center;
                spacing: Tokens.sp4;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icon.svg");
                        width: 72px;
                        height: 72px;
                        image-fit: contain;
                        opacity: 0.9;
                    }
                }
                Text {
                    text: root.error == "" ? "Select a connection" : root.error;
                    color: root.error == "" ? Tokens.text-faint : Tokens.error;
                    font-size: Tokens.font-md;
                    horizontal-alignment: center;
                }
                // Primary action: create a new connection.
                HorizontalLayout {
                    alignment: center;
                    PrimaryButton {
                        text: "+ New Connection";
                        height: 34px;
                        clicked => { root.add-clicked(); }
                    }
                }
                // Social badges: Product Hunt launch + GitHub star, open browser.
                // Drawn as pills (not the remote SVG, which the UI can't render).
                HorizontalLayout {
                    alignment: center;
                    spacing: Tokens.sp2;
                    Rectangle {
                        height: 32px;
                        horizontal-stretch: 0;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: ph-ta.has-hover ? Tokens.card : transparent;
                        HorizontalLayout {
                            padding-left: Tokens.sp3;
                            padding-right: Tokens.sp3;
                            spacing: Tokens.sp2;
                            alignment: center;
                            Text {
                                text: "P";
                                color: #DA552F;
                                font-size: 15px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Product Hunt";
                                color: Tokens.text;
                                font-size: Tokens.font-md;
                                vertical-alignment: center;
                            }
                        }
                        ph-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-url("https://www.producthunt.com/products/rdb"); }
                        }
                    }
                    Rectangle {
                        height: 32px;
                        horizontal-stretch: 0;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: gh-ta.has-hover ? Tokens.card : transparent;
                        HorizontalLayout {
                            padding-left: Tokens.sp3;
                            padding-right: Tokens.sp3;
                            spacing: Tokens.sp2;
                            alignment: center;
                            Text {
                                text: "★";
                                color: Tokens.warn;
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Star on GitHub";
                                color: Tokens.text;
                                font-size: Tokens.font-md;
                                vertical-alignment: center;
                            }
                        }
                        gh-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-url("https://github.com/suiflex/rdb"); }
                        }
                    }
                }
                // Supported-engine trust badges: real brand marks, full
                // color — unlike DbBadge (the sidebar/picker badge), which
                // is deliberately monochrome. SQL Server has no official
                // mark shipped with the app, so it's a text label instead
                // of a fabricated logo (same choice the website makes).
                VerticalLayout {
                    spacing: Tokens.sp1;
                    alignment: center;
                    Text {
                        text: "Works with";
                        color: Tokens.text-faint;
                        font-size: Tokens.font-xs;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: Tokens.sp3;
                        Image {
                            source: @image-url("icons/brand/postgres.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                        Image {
                            source: @image-url("icons/brand/mysql.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                        Image {
                            source: @image-url("icons/brand/redis.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                        Image {
                            source: @image-url("icons/brand/mongo.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                        Image {
                            source: @image-url("icons/brand/sqlite.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                        Image {
                            source: @image-url("icons/brand/cassandra.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                        Image {
                            source: @image-url("icons/brand/clickhouse.svg");
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                        Text {
                            text: "SQL Server";
                            color: Tokens.text-faint;
                            font-size: Tokens.font-xs;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.selected-conn >= 0: VerticalLayout {
                spacing: 0;

                VerticalLayout {
                    padding: 34px;
                    padding-top: 32px;
                    spacing: Tokens.sp6;
                    alignment: start;
                    vertical-stretch: 1;
                    max-width: 560px;

                    // ----- header row -----
                    HorizontalLayout {
                        spacing: Tokens.sp4;
                        DbBadge {
                            engine: root.sel-engine;
                            size: 44px;
                            fill: root.sel-has-custom-color ? root.sel-color : Tokens.db-color(root.sel-engine);
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: Tokens.sp1;
                            HorizontalLayout {
                                spacing: Tokens.sp3;
                                alignment: start;
                                Text {
                                    text: root.sel-name;
                                    color: Tokens.text;
                                    font-size: 18px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if root.sel-local: VerticalLayout {
                                    alignment: center;
                                    OutlineChip { text: "LOCAL"; }
                                }
                                if root.sel-env-tag-label != "": VerticalLayout {
                                    alignment: center;
                                    OutlineChip { text: root.sel-env-tag-label; tint: root.sel-env-tag-color; }
                                }
                            }
                            Text {
                                text: root.sel-sub;
                                color: Tokens.text-dim;
                                font-size: Tokens.font-md;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Tokens.sp2;
                                PrimaryButton {
                                    text: root.connecting ? "Connecting…" : "Connect";
                                    enabled: !root.connecting;
                                    height: 30px;
                                    clicked => { root.connect-clicked(root.selected-conn); }
                                }
                                if root.connecting: SecondaryButton {
                                    text: "Cancel";
                                    height: 30px;
                                    clicked => { root.cancel-connect(); }
                                }
                                SecondaryButton {
                                    text: "Test";
                                    height: 30px;
                                    clicked => { root.test-clicked(root.selected-conn); }
                                }
                                SecondaryButton {
                                    text: "Edit";
                                    height: 30px;
                                    clicked => { root.edit-clicked(root.selected-conn); }
                                }
                            }
                        }
                    }

                    // Connection error surfaced next to the Connect button.
                    if root.error != "": Text {
                        text: root.error;
                        color: Tokens.error;
                        font-size: Tokens.font-sm;
                        wrap: word-wrap;
                    }

                    // ----- key/value card -----
                    Rectangle {
                        border-radius: Tokens.radius-lg;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: Tokens.card;
                        height: kv-col.preferred-height;
                        clip: true;
                        kv-col := VerticalLayout {
                            for row[ri] in root.sel-rows: Rectangle {
                                height: 33px;
                                if ri > 0: Rectangle {
                                    y: 0;
                                    height: 1px;
                                    width: parent.width;
                                    background: Tokens.border;
                                }
                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    Text {
                                        width: 105px;
                                        text: row.k;
                                        color: Tokens.text-dim;
                                        font-size: Tokens.font-md;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.v;
                                        color: Tokens.text;
                                        font-size: Tokens.font-md;
                                        font-family: Tokens.mono;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ----- tag chips -----
                    HorizontalLayout {
                        spacing: Tokens.sp2;
                        alignment: start;
                        for t in root.sel-tags: TagChip { text: t; }
                    }
                }

                // ----- footer status -----
                Rectangle { height: 1px; background: Tokens.border; }
                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        padding-left: 34px;
                        Text {
                            text: root.sel-footer;
                            color: Tokens.text-faint;
                            font-size: Tokens.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    group-menu := PopupWindow {
        // Anchored to the "⋯" button's actual position (was hardcoded to
        // 60px — the reason the menu opened in an unrelated spot). Clamp so
        // it stays on screen if the button sits near the panel's edge.
        x: min(root.group-menu-x, root.width - 148px);
        y: min(root.group-menu-y, root.height - 124px);
        width: 140px;
        Rectangle {
            background: Tokens.card;
            border-radius: Tokens.radius;
            border-width: 1px;
            border-color: Tokens.border-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: Tokens.text.with-alpha(0.25);
            VerticalLayout {
                padding: 4px;
                // "New Subgroup" only makes sense on a top-level group — the
                // guided Group/Subgroup picker in the connection form is
                // two levels deep, not a full tree, so a subfolder header
                // doesn't offer it.
                property <bool> target-is-top-level: root.group-menu-target-depth == 0;
                for label[action] in ["New Subgroup", "Rename", "Delete"]: Rectangle {
                    visible: action != 0 || target-is-top-level;
                    height: self.visible ? 28px : 0px;
                    border-radius: Tokens.radius;
                    background: gmenu-ta.has-hover ? (action == 2 ? Tokens.error-tint : Tokens.accent-tint) : transparent;
                    Text {
                        x: Tokens.sp2;
                        text: label;
                        color: action == 2 ? Tokens.error : Tokens.text;
                        font-size: Tokens.font-sm;
                        vertical-alignment: center;
                    }
                    gmenu-ta := TouchArea {
                        clicked => {
                            if (action == 0) {
                                root.add-conn-in-group(root.group-menu-target);
                            } else if (action == 1) {
                                root.rename-old = root.group-menu-target;
                                root.rename-text = root.group-menu-target;
                                root.rename-modal-open = true;
                            } else {
                                root.delete-confirm-target = root.group-menu-target;
                                root.delete-confirm-open = true;
                            }
                            group-menu.close();
                        }
                    }
                }
            }
        }
    }

    // ----- Rename group -----
    Rectangle {
        visible: root.rename-modal-open;
        background: Tokens.veil;
        TouchArea { clicked => { root.rename-modal-open = false; } }
        changed visible => {
            if (self.visible) { rti.focus(); }
        }
        Rectangle {
            width: 340px;
            x: (parent.width - self.width) / 2;
            y: 140px;
            height: rbox.preferred-height;
            border-radius: Tokens.modal-radius;
            background: Tokens.card;
            border-width: 1px;
            border-color: Tokens.border;
            drop-shadow-blur: 42px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #1C191426;
            TouchArea {}
            rbox := VerticalLayout {
                padding: Tokens.sp4;
                spacing: Tokens.sp3;
                Text {
                    text: "Rename group";
                    color: Tokens.text;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 34px;
                    border-radius: Tokens.radius;
                    background: Tokens.canvas;
                    border-width: 1px;
                    border-color: Tokens.border;
                    rti := TextInput {
                        x: Tokens.sp2;
                        width: parent.width - 2 * Tokens.sp2;
                        vertical-alignment: center;
                        text <=> root.rename-text;
                        color: Tokens.text;
                        font-size: Tokens.font-md;
                        single-line: true;
                        accepted => {
                            root.group-rename(root.rename-old, root.rename-text);
                            root.rename-modal-open = false;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.sp2;
                    alignment: end;
                    SecondaryButton {
                        text: "Cancel";
                        height: 30px;
                        clicked => { root.rename-modal-open = false; }
                    }
                    PrimaryButton {
                        text: "Rename";
                        height: 30px;
                        clicked => {
                            root.group-rename(root.rename-old, root.rename-text);
                            root.rename-modal-open = false;
                        }
                    }
                }
            }
        }
    }

    // ----- Delete group confirmation -----
    Rectangle {
        visible: root.delete-confirm-open;
        background: Tokens.veil;
        TouchArea { clicked => { root.delete-confirm-open = false; } }
        Rectangle {
            width: 340px;
            x: (parent.width - self.width) / 2;
            y: 140px;
            height: dbox.preferred-height;
            border-radius: Tokens.modal-radius;
            background: Tokens.card;
            border-width: 1px;
            border-color: Tokens.border;
            drop-shadow-blur: 42px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #1C191426;
            TouchArea {}
            dbox := VerticalLayout {
                padding: Tokens.sp4;
                spacing: Tokens.sp3;
                Text {
                    text: "Delete group?";
                    color: Tokens.text;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "\"" + root.delete-confirm-target + "\" will be deleted. Connections inside move up to the parent group — nothing is destroyed.";
                    color: Tokens.text-dim;
                    font-size: Tokens.font-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Tokens.sp2;
                    alignment: end;
                    SecondaryButton {
                        text: "Cancel";
                        height: 30px;
                        clicked => { root.delete-confirm-open = false; }
                    }
                    DangerButton {
                        text: "Delete";
                        height: 30px;
                        clicked => {
                            root.group-delete(root.delete-confirm-target);
                            root.delete-confirm-open = false;
                        }
                    }
                }
            }
        }
    }
}

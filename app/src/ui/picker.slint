// Connections screen: grouped connection list (left, sidebar surface) +
// selected-connection detail panel (right, canvas surface).
// Reference: design/1-connections.png.
import { Tokens } from "tokens.slint";
import {
    DbBadge, OutlineChip, PrimaryButton, SecondaryButton, TextButton,
    TagChip, FilterField
} from "components.slint";
import { AppIcon } from "icons.slint";
import { ConnItem, KvRow } from "structs.slint";
import { ScrollView } from "std-widgets.slint";

export component ConnPicker inherits Rectangle {
    in property <[ConnItem]> connections;
    in property <int> selected-conn: -1;
    in property <string> error;
    // True while a connect attempt is in flight (button shows a spinner label).
    in property <bool> connecting;

    // Detail panel (filled by Rust when a row is selected).
    in property <string> sel-name;
    in property <string> sel-engine;
    in property <string> sel-sub;      // "PostgreSQL · grup profin"
    in property <bool> sel-local;
    in property <[KvRow]> sel-rows;
    in property <[string]> sel-tags;
    in property <string> sel-footer;   // "Terakhir terhubung · 2 menit lalu · …"

    callback select-conn(int);
    callback connect-clicked(int);
    callback cancel-connect();
    callback test-clicked(int);
    callback add-clicked();
    callback edit-clicked(int);
    // Export saved connections to ~/Downloads. Arg is the format: 0 = JSON, 1 = CSV.
    callback export-conns(int);
    callback toggle-group(string);
    // Toggle the starred flag on a connection (arg is the store index).
    callback toggle-favorite(int);
    // Drag-reorder: (store index of dragged row, signed number of rows moved).
    callback reorder-conn(int, int);
    callback filter(string);

    background: Tokens.canvas;

    HorizontalLayout {
        spacing: 0;

        // ================= left: floating grouped list =================
        // Canvas gutter around the card so the sidebar reads as a floating
        // panel (rounded, bordered, drop-shadow) instead of a flush column.
        Rectangle {
            width: 372px;
            background: Tokens.canvas;

            card := Rectangle {
                x: Tokens.sp3;
                y: Tokens.sp3;
                width: parent.width - 2 * Tokens.sp3;
                height: parent.height - 2 * Tokens.sp3;
                background: Tokens.sidebar;
                border-radius: Tokens.radius-lg;
                border-width: 1px;
                border-color: Tokens.border;
                drop-shadow-blur: 18px;
                drop-shadow-color: #00000035;
                drop-shadow-offset-y: 6px;
                clip: true;

            VerticalLayout {
                spacing: 0;

                // ----- filter row -----
                HorizontalLayout {
                    padding: Tokens.sp3;
                    padding-top: Tokens.sp4;
                    padding-bottom: Tokens.sp3;
                    spacing: Tokens.sp3;
                    FilterField {
                        height: 30px;
                        horizontal-stretch: 1;
                        placeholder: "Filter connections...";
                        edited(t) => { root.filter(t); }
                    }
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: Tokens.radius;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: Tokens.card;
                        Text {
                            text: "+";
                            color: add-ta.has-hover ? Tokens.text : Tokens.text-dim;
                            font-size: 17px;
                        }
                        add-ta := TouchArea { clicked => { root.add-clicked(); } }
                    }
                }

                // ----- grouped rows -----
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-left: Tokens.sp3;
                        padding-right: Tokens.sp3;
                        spacing: Tokens.sp1;
                        alignment: start;

                        for item[i] in root.connections: Rectangle {
                            height: item.is-header ? 28px : 40px;

                            // --- group header row ---
                            if item.is-header: Rectangle {
                                hdr-ta := TouchArea {
                                    clicked => { root.toggle-group(item.name); }
                                }
                                HorizontalLayout {
                                    spacing: Tokens.sp2;
                                    alignment: start;
                                    Text {
                                        text: item.expanded ? "▾" : "▸";
                                        color: Tokens.text-faint;
                                        font-size: 9px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: item.name;
                                        color: Tokens.text-dim;
                                        font-size: Tokens.font-xs;
                                        font-weight: 700;
                                        letter-spacing: 0.8px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: item.count;
                                        color: Tokens.text-faint;
                                        font-size: Tokens.font-sm;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // --- connection row --- (selected-conn = store index)
                            if !item.is-header: Rectangle {
                                // Only the selected row fills — solid brand color
                                // so it dominates the list (CodexBar-style). Idle
                                // rows stay plain (engine color still reads from
                                // the badge square); hover gets a faint tint.
                                property <color> tint: Tokens.db-color(item.engine);
                                property <bool> selected: item.index == root.selected-conn;
                                border-radius: Tokens.radius-lg;
                                background: selected ? tint
                                    : row-ta.has-hover ? tint.with-alpha(0.14)
                                    : transparent;
                                animate background { duration: Tokens.fade; }
                                // "Grabbed" affordance while dragging the handle:
                                // Slint can't cheaply follow the cursor without a
                                // feedback loop, so lift + outline signals the drag
                                // is live; the drop lands on pointer release.
                                border-width: grip-ta.pressed ? 1px : 0;
                                border-color: Tokens.accent;
                                drop-shadow-blur: grip-ta.pressed ? 14px : 0;
                                drop-shadow-color: #00000055;

                                row-ta := TouchArea {
                                    clicked => { root.select-conn(item.index); }
                                    double-clicked => { root.connect-clicked(item.index); }
                                }

                                HorizontalLayout {
                                    padding-left: Tokens.sp3;
                                    padding-right: Tokens.sp3;
                                    spacing: Tokens.sp3;
                                    // Drag handle: reorders within the group.
                                    // Always rendered (so the pointer grab isn't
                                    // dropped mid-drag when the row loses hover);
                                    // faint until hovered. Emits a row-step delta
                                    // on release for Rust to resolve.
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 12px;
                                            opacity: row-ta.has-hover || grip-ta.has-hover || grip-ta.pressed ? 1.0 : 0.0;
                                            AppIcon {
                                                name: "grip";
                                                size: 12px;
                                                color: selected ? white.with-alpha(0.7) : Tokens.text-faint;
                                            }
                                            grip-ta := TouchArea {
                                                mouse-cursor: grab;
                                                pointer-event(ev) => {
                                                    if ev.kind == PointerEventKind.up {
                                                        root.reorder-conn(
                                                            item.index,
                                                            round((self.mouse-y - self.pressed-y) / 40px));
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        // ring keeps the same-color badge visible
                                        // on the solid selected fill
                                        DbBadge {
                                            engine: item.engine;
                                            size: 24px;
                                            border-width: selected ? 1px : 0;
                                            border-color: white.with-alpha(0.5);
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: item.name;
                                            color: selected ? white : Tokens.text;
                                            font-size: Tokens.font-md;
                                            font-weight: Tokens.weight-emphasis;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: item.subline;
                                            color: selected ? white.with-alpha(0.75) : Tokens.text-dim;
                                            font-size: Tokens.font-xs;
                                            font-family: Tokens.mono;
                                            overflow: elide;
                                        }
                                    }
                                    if item.local: VerticalLayout {
                                        alignment: center;
                                        OutlineChip { text: "LOCAL"; }
                                    }
                                    // Star toggle: always present (so its own
                                    // TouchArea keeps receiving clicks); shown when
                                    // starred or on hover. Gating on `if` here would
                                    // remove the element the instant the pointer
                                    // enters it and steals hover from the row.
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            opacity: item.favorite || row-ta.has-hover || star-ta.has-hover ? 1.0 : 0.0;
                                            border-radius: Tokens.radius;
                                            background: star-ta.has-hover ? Tokens.card.with-alpha(0.4) : transparent;
                                            Text {
                                                text: item.favorite ? "★" : "☆";
                                                color: item.favorite
                                                    ? #f5b301
                                                    : (selected ? white.with-alpha(0.8) : Tokens.text-faint);
                                                font-size: 15px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            star-ta := TouchArea {
                                                clicked => { root.toggle-favorite(item.index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----- footer actions -----
                Rectangle { height: 1px; background: Tokens.border; }
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: Tokens.sp6;
                        padding-right: Tokens.sp6;
                        spacing: Tokens.sp4;
                        Rectangle {
                            width: new-row.preferred-width;
                            new-row := HorizontalLayout {
                                spacing: Tokens.sp2;
                                Text {
                                    text: "+";
                                    color: Tokens.text;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "New Connection";
                                    color: Tokens.text;
                                    font-size: Tokens.font-md;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            new-ta := TouchArea { clicked => { root.add-clicked(); } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Tokens.sp4;
                                Rectangle {
                                    width: exp-btn.preferred-width;
                                    height: exp-btn.preferred-height;
                                    export-menu := PopupWindow {
                                        // See ExportButton: default close-on-click
                                        // eats the press before the row click fires.
                                        close-policy: close-on-click-outside;
                                        x: 0;
                                        y: -76px;
                                        width: 130px;
                                        height: menu-box.preferred-height;
                                        menu-box := Rectangle {
                                            background: Tokens.card;
                                            border-width: 1px;
                                            border-color: Tokens.border-strong;
                                            border-radius: Tokens.radius;
                                            drop-shadow-blur: 12px;
                                            drop-shadow-color: #00000022;
                                            VerticalLayout {
                                                padding: 4px;
                                                for opt[i] in ["JSON", "CSV"]: Rectangle {
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: exp-row-ta.has-hover ? Tokens.accent-tint : transparent;
                                                    exp-row-ta := TouchArea {
                                                        clicked => { export-menu.close(); root.export-conns(i); }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: Tokens.sp2;
                                                        Text {
                                                            text: opt;
                                                            color: Tokens.text;
                                                            font-size: Tokens.font-sm;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    exp-btn := TextButton { text: "Export ▾"; clicked => { export-menu.show(); } }
                                }
                            }
                        }
                    }
                }
            }
            }
        }

        // ================= right: detail panel =================
        Rectangle {
            background: Tokens.canvas;
            horizontal-stretch: 1;

            if root.selected-conn < 0: VerticalLayout {
                alignment: center;
                spacing: Tokens.sp4;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icon.svg");
                        width: 72px;
                        height: 72px;
                        image-fit: contain;
                        opacity: 0.9;
                    }
                }
                Text {
                    text: root.error == "" ? "Select a connection" : root.error;
                    color: root.error == "" ? Tokens.text-faint : Tokens.error;
                    font-size: Tokens.font-md;
                    horizontal-alignment: center;
                }
            }

            if root.selected-conn >= 0: VerticalLayout {
                spacing: 0;

                VerticalLayout {
                    padding: 34px;
                    padding-top: 32px;
                    spacing: Tokens.sp6;
                    alignment: start;
                    vertical-stretch: 1;

                    // ----- header row -----
                    HorizontalLayout {
                        spacing: Tokens.sp4;
                        DbBadge { engine: root.sel-engine; size: 44px; }
                        VerticalLayout {
                            alignment: center;
                            spacing: Tokens.sp1;
                            HorizontalLayout {
                                spacing: Tokens.sp3;
                                alignment: start;
                                Text {
                                    text: root.sel-name;
                                    color: Tokens.text;
                                    font-size: 18px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if root.sel-local: VerticalLayout {
                                    alignment: center;
                                    OutlineChip { text: "LOCAL"; }
                                }
                            }
                            Text {
                                text: root.sel-sub;
                                color: Tokens.text-dim;
                                font-size: Tokens.font-md;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Tokens.sp2;
                                PrimaryButton {
                                    text: root.connecting ? "Connecting…" : "Connect";
                                    enabled: !root.connecting;
                                    height: 30px;
                                    clicked => { root.connect-clicked(root.selected-conn); }
                                }
                                if root.connecting: SecondaryButton {
                                    text: "Cancel";
                                    height: 30px;
                                    clicked => { root.cancel-connect(); }
                                }
                                SecondaryButton {
                                    text: "Test";
                                    height: 30px;
                                    clicked => { root.test-clicked(root.selected-conn); }
                                }
                                SecondaryButton {
                                    text: "Edit";
                                    height: 30px;
                                    clicked => { root.edit-clicked(root.selected-conn); }
                                }
                            }
                        }
                    }

                    // Connection error surfaced next to the Connect button.
                    if root.error != "": Text {
                        text: root.error;
                        color: Tokens.error;
                        font-size: Tokens.font-sm;
                        wrap: word-wrap;
                    }

                    // ----- key/value card -----
                    Rectangle {
                        border-radius: Tokens.radius-lg;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: Tokens.card;
                        height: kv-col.preferred-height;
                        clip: true;
                        kv-col := VerticalLayout {
                            for row[ri] in root.sel-rows: Rectangle {
                                height: 33px;
                                if ri > 0: Rectangle {
                                    y: 0;
                                    height: 1px;
                                    width: parent.width;
                                    background: Tokens.border;
                                }
                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    Text {
                                        width: 105px;
                                        text: row.k;
                                        color: Tokens.text-dim;
                                        font-size: Tokens.font-md;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.v;
                                        color: Tokens.text;
                                        font-size: Tokens.font-md;
                                        font-family: Tokens.mono;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ----- tag chips -----
                    HorizontalLayout {
                        spacing: Tokens.sp2;
                        alignment: start;
                        for t in root.sel-tags: TagChip { text: t; }
                    }
                }

                // ----- footer status -----
                Rectangle { height: 1px; background: Tokens.border; }
                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        padding-left: 34px;
                        Text {
                            text: root.sel-footer;
                            color: Tokens.text-faint;
                            font-size: Tokens.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

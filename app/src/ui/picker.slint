import { Theme } from "theme.slint";
import { ConnItem } from "structs.slint";
import { ScrollView, LineEdit, Button } from "std-widgets.slint";

// Full-window connection picker (TablePlus-style): search + grouped connection
// list + Create button. Shown while not connected; replaced by the workspace
// once a connection succeeds.
export component ConnPicker inherits Rectangle {
    in property <[ConnItem]> connections;
    in property <int> selected-conn: -1;
    in property <string> error;
    callback connect-clicked(int);
    callback add-clicked();
    callback edit-clicked(int);
    callback toggle-group(string);
    callback filter(string);

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.sp6;
        spacing: Theme.sp3;

        // ----- header: title + Create -----
        HorizontalLayout {
            spacing: Theme.sp2;
            Text {
                vertical-alignment: center;
                text: "Connections";
                color: Theme.text;
                font-size: 18px;
            }
            Rectangle {} // spacer
            Button {
                text: "+ Create Connection";
                clicked => { root.add-clicked(); }
            }
        }

        // ----- search -----
        LineEdit {
            placeholder-text: "Search for connection…";
            edited(t) => { root.filter(t); }
        }

        // ----- error toast (connect failure) -----
        if root.error != "": Rectangle {
            height: Theme.row-height;
            border-radius: Theme.radius-control;
            background: #ef444422;
            HorizontalLayout {
                padding-left: Theme.sp2;
                Text {
                    vertical-alignment: center;
                    text: root.error;
                    color: #f87171;
                    font-size: Theme.font-label;
                }
            }
        }

        // ----- list -----
        ScrollView {
            VerticalLayout {
                spacing: Theme.sp1;
                for conn[i] in root.connections: Rectangle {
                    height: Theme.tree-row-height + Theme.sp2;
                    // group header
                    if conn.is-header: Rectangle {
                        TouchArea { clicked => { root.toggle-group(conn.group); } }
                        HorizontalLayout {
                            padding-left: Theme.sp1;
                            spacing: Theme.sp1;
                            Text {
                                vertical-alignment: center;
                                text: conn.expanded ? "▾" : "▸";
                                color: Theme.text-dim;
                                font-size: Theme.font-label;
                            }
                            Text {
                                vertical-alignment: center;
                                text: conn.name;
                                color: Theme.text-dim;
                                font-size: Theme.font-label;
                            }
                            Rectangle {}
                        }
                    }
                    // connection row
                    if !conn.is-header: Rectangle {
                        border-radius: Theme.radius-control;
                        background: ta.has-hover ? Theme.surface : transparent;
                        ta := TouchArea { clicked => { root.connect-clicked(conn.index); } }
                        HorizontalLayout {
                            padding-left: Theme.sp3;
                            padding-right: Theme.sp2;
                            spacing: Theme.sp2;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                y: (parent.height - self.height) / 2;
                                background: conn.color;
                            }
                            Text {
                                vertical-alignment: center;
                                text: conn.name;
                                color: Theme.text;
                                font-size: Theme.font-body;
                            }
                            Rectangle {} // spacer
                            Rectangle {
                                width: 18px;
                                TouchArea { clicked => { root.edit-clicked(conn.index); } }
                                Text { text: "✎"; horizontal-alignment: center; color: Theme.text-dim; font-size: Theme.font-label; }
                            }
                            Text {
                                vertical-alignment: center;
                                text: conn.engine;
                                color: Theme.text-dim;
                                font-size: Theme.font-label;
                            }
                        }
                    }
                }
            }
        }
    }
}

import { Theme } from "theme.slint";
import { TreeNode } from "structs.slint";
import { AppIcon } from "icons.slint";
import { ScrollView, ComboBox } from "std-widgets.slint";

// Workspace sidebar (TablePlus-style). Three stacked regions:
//   1. connection header card (click to disconnect / go back)
//   2. scrollable object tree: collapsible "Tables/Views/Functions" categories,
//      each holding container rows that expand to show columns
//   3. a pinned schema selector glued to the bottom while (2) scrolls
export component Sidebar inherits Rectangle {
    in property <[TreeNode]> tree;
    in property <string> conn-name;
    in property <string> active-table;   // highlighted (currently open) table
    in property <[string]> schema-list;
    in-out property <string> schema-name;
    callback disconnect();
    callback open-table(string);
    callback toggle-node(string);
    callback select-schema(string);

    background: Theme.surface;

    VerticalLayout {
        padding: Theme.sp2;
        spacing: Theme.sp1;

        // ----- connection header card -----
        Rectangle {
            height: 44px;
            border-radius: Theme.radius-panel;
            background: back-ta.has-hover ? Theme.surface-2 : transparent;
            back-ta := TouchArea { clicked => { root.disconnect(); } }
            HorizontalLayout {
                padding-left: Theme.sp2;
                padding-right: Theme.sp2;
                spacing: Theme.sp2;
                // accent disc with a database glyph
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: Theme.accent-soft;
                    AppIcon { name: "database"; size: Theme.icon-md; color: Theme.accent; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: root.conn-name;
                        color: Theme.text;
                        font-size: Theme.font-h;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: "Connected";
                        color: Theme.text-faint;
                        font-size: Theme.font-caption;
                    }
                }
                Rectangle {}
                // disconnect affordance
                AppIcon {
                    name: "close";
                    size: Theme.icon-sm;
                    color: back-ta.has-hover ? Theme.text-dim : Theme.text-faint;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.hairline; }

        // ----- scrollable object tree (fills the gap above the pinned footer) -----
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-top: Theme.sp1;
                spacing: 2px;
                for node[i] in root.tree: Rectangle {
                    property <bool> is-category: node.kind == "category";
                    property <bool> is-container: node.kind == "table" || node.kind == "collection" || node.kind == "keyspace";
                    property <bool> is-field: node.kind == "field";
                    property <bool> is-active: is-container && node.label == root.active-table;
                    height: is-category ? 28px : Theme.row-height;
                    border-radius: Theme.radius-control;
                    background: is-active ? Theme.accent-soft
                        : (row-ta.has-hover && (is-container || is-category) ? Theme.surface-2 : transparent);
                    // active-row accent bar
                    if is-active: Rectangle {
                        x: 0;
                        width: 3px;
                        height: parent.height - 8px;
                        y: 4px;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                    row-ta := TouchArea {
                        enabled: is-container || is-category;
                        clicked => {
                            if (is-category) { root.toggle-node(node.label); }
                            else { root.open-table(node.label); }
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.sp2 + node.depth * Theme.sp3;
                        padding-right: Theme.sp1;
                        spacing: Theme.sp1;
                        // chevron: categories + containers expand (rotates when open)
                        if is-category || is-container: AppIcon {
                            name: "chevron";
                            size: Theme.icon-sm;
                            color: Theme.text-faint;
                            transform-rotation: node.expanded ? 90deg : 0;
                        }
                        // leading type icon
                        if is-category: AppIcon {
                            name: node.label == "Views" ? "view"
                                : (node.label == "Functions" ? "function" : "rows");
                            size: Theme.icon-sm;
                            color: Theme.text-faint;
                        }
                        if is-container: AppIcon {
                            name: "table";
                            size: Theme.icon-sm;
                            color: is-active ? Theme.accent : Theme.text-dim;
                        }
                        // field marker dot
                        if is-field: Rectangle {
                            width: Theme.icon-sm;
                            Rectangle {
                                width: 4px; height: 4px; border-radius: 2px;
                                background: Theme.text-faint;
                            }
                        }
                        Text {
                            vertical-alignment: center;
                            text: node.label;
                            color: is-category ? Theme.text-faint
                                : (is-field ? Theme.text-dim
                                    : (is-active ? Theme.accent : Theme.text));
                            font-size: is-category ? Theme.font-caption
                                : (is-field ? Theme.font-label : Theme.font-body);
                            font-weight: is-category ? 700 : (is-active ? 600 : 400);
                            font-family: is-field ? Theme.mono-family : "";
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // ----- pinned schema selector (always glued to the bottom) -----
        Rectangle { height: 1px; background: Theme.hairline; }
        Rectangle {
            height: 46px;
            HorizontalLayout {
                padding: Theme.sp1;
                spacing: Theme.sp2;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-control;
                    background: Theme.surface-2;
                    AppIcon { name: "layers"; size: Theme.icon-sm; color: Theme.text-dim; }
                }
                ComboBox {
                    model: root.schema-list;
                    current-value <=> root.schema-name;
                    selected(v) => { root.select-schema(v); }
                }
            }
        }
    }
}

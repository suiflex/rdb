// Workspace sidebar (Tabula): Items/Queries/History tabs, filter field,
// FUNCTIONS/TABLES sections, pinned schema selector.
// Reference: design/workspace.png (left column).
import { Tokens } from "tokens.slint";
import { TreeNode } from "structs.slint";
import { AppMenu, DbBadge, FilterField, IconButton, KeyCap, Tooltip, Shortcut } from "components.slint";
import { AppIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { CircularProgressIndicator, MaterialPalette, MaterialStyleMetrics } from "@material";

export component Sidebar inherits Rectangle {
    in property <[TreeNode]> tree;
    in property <string> conn-name;
    in property <string> active-table;   // highlighted (currently open) table
    in property <int> active-count: -1;  // row count badge on the active table
    in property <[string]> schema-list;
    in property <string> schema-name;
    // 0 = Items, 1 = Queries, 2 = History. Read-only: tab clicks signal via
    // mode-changed and the owner (MainWindow) sets the value back down.
    in property <int> mode: 0;
    // Dims the tree + shows a spinner while the schema/db/connection reloads.
    in property <bool> tree-loading;
    // Query tab rows reuse TreeNode: kind "qcat" headers / "query" / "recent".
    in property <[TreeNode]> query-tree;
    callback disconnect();
    callback open-table(string, string);   // (database, container)
    callback pin-table(string, string);    // double-click keeps this object tab
    callback toggle-fields(string, string); // (database, table) — expand columns inline
    callback copy-field(string, string, int); // (table, field label, action)
    callback table-action(string, string, int); // (database, table, action)
    callback open-function(string);
    callback open-query(string, int);      // (label, index in its section)
    callback insert-query(int);            // History row: append its SQL to editor
    callback rerun-query(int);             // History ▶: run it, editor untouched
    // History menu action: 0 insert, 1 run, 2 copy, 3 save to queries, 4 delete.
    callback history-action(int, int);
    callback run-saved-query(int);         // Saved ▶: run it, editor untouched
    // Saved menu action: 0 run, 1 open in new tab, 2 insert, 3 copy, 4 delete.
    callback query-action(int, int);
    callback toggle-node(string);
    callback select-schema(string);
    callback filter-tree(string);
    callback mode-changed(int);
    callback add-item();
    // bumped by ⌘P (app-window) to focus the filter field
    in property <int> focus-tick;
    changed focus-tick => { fld.focus-input(); }

    // Pending container click, deferred so a double-click can pre-empt it: the
    // single-click action rebuilds the tree and destroys the row's TouchArea,
    // which would otherwise swallow the second click of every double-click.
    property <string> pending-db;
    property <string> pending-label;
    property <int> history-menu-index: -1;
    property <length> history-menu-y: 0px;
    property <int> query-menu-index: -1;
    property <length> query-menu-y: 0px;
    property <string> field-menu-table: "";
    property <string> field-menu-label: "";
    property <length> field-menu-x: 0px;
    property <length> field-menu-y: 0px;
    property <string> table-menu-db: "";
    property <string> table-menu-label: "";
    property <length> table-menu-x: 0px;
    property <length> table-menu-y: 0px;
    click-timer := Timer {
        interval: 220ms;
        running: false;
        triggered => {
            self.running = false;
            root.toggle-fields(root.pending-db, root.pending-label);
        }
    }

    // Gutter in the rail's strip colour, so the card reads as a panel with no
    // shadow of its own: an elevation shadow drew a line between the card and
    // the active rail tile that joins it.
    background: Tokens.sidebar;

    // Sidebar on the right (rail beyond it on the right edge).
    in property <bool> mirror;

    // Flush against the connections rail so the active rail tile runs
    // straight into the card (the notch); the gutter stays on the other side.
    card := Rectangle {
        background: MaterialPalette.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Tokens.border;
        x: Tokens.sp2;
        y: Tokens.sp2;
        width: parent.width - 2 * Tokens.sp2;
        height: parent.height - 2 * Tokens.sp2;

    VerticalLayout {
        spacing: 0;

        // ----- Items | Queries | History -----
        Rectangle {
            height: 42px;
            HorizontalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                padding-top: 4px;
                spacing: Tokens.sp1;
                alignment: start;
                for label[m] in ["Items", "Queries", "History"]: Rectangle {
                    width: t.preferred-width + 20px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: root.mode == m ? Tokens.border-strong
                        : (mt.has-hover ? Tokens.border : transparent);
                    t := Text {
                        text: label;
                        color: root.mode == m ? Tokens.text
                            : (mt.has-hover ? Tokens.text-dim : Tokens.text-faint);
                        font-size: Tokens.font-md;
                        font-weight: root.mode == m ? Tokens.weight-emphasis : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    mt := TouchArea {
                        clicked => {
                            root.mode-changed(m);
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ----- filter -----
        HorizontalLayout {
            padding-left: Tokens.sp3;
            padding-right: Tokens.sp3;
            padding-bottom: Tokens.sp2;
            fld := FilterField {
                placeholder: root.mode == 1 ? "Filter queries..." : "Filter items...";
                trailing-cap: root.mode == 0 ? Shortcut.primary + Shortcut.separator + "P" : "";
                edited(t) => { root.filter-tree(t); }
            }
        }

        // ----- tree (Items) / query list (Queries, History) -----
        Rectangle {
            vertical-stretch: 1;
            tree-scroll := ScrollView {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                width: tree-scroll.visible-width;
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                spacing: 0;
                alignment: start;

                for node[i] in root.mode == 0 ? root.tree : root.query-tree: Rectangle {
                    property <bool> is-category: node.kind == "category" || node.kind == "qcat";
                    property <bool> is-database: node.kind == "database";
                    property <bool> is-container: node.kind == "table" || node.kind == "collection" || node.kind == "keyspace" || node.kind == "key";
                    property <bool> is-function: node.kind == "function";
                    property <bool> is-query: node.kind == "query" || node.kind == "recent";
                    property <bool> is-field: node.kind == "field";
                    property <bool> is-hint: node.kind == "hint";
                    property <bool> is-active: (is-container && node.label == root.active-table)
                        || (is-query && node.expanded);
                    property <bool> is-table-target: is-container && node.label == root.table-menu-label && root.table-menu-label != "";
                    height: is-category ? 28px : 26px;
                    border-radius: 6px;
                    border-width: is-table-target ? 1.5px : 0px;
                    border-color: Tokens.accent;
                    background: is-active || is-table-target ? Tokens.accent-tint
                        : (row-ta.has-hover && !is-category && !is-hint
                            ? Tokens.border : transparent);
                    // selection = 2px accent left bar + tint (never a pill)
                    if is-active: Rectangle {
                        x: 0;
                        width: Tokens.selection-bar-w;
                        height: parent.height;
                        border-radius: 1px;
                        background: Tokens.accent;
                    }

                    row-ta := TouchArea {
                        enabled: !is-hint;
                        changed has-hover => {
                            if (self.has-hover && node.kind == "recent") {
                                Tooltip.text = node.db;
                                Tooltip.x = root.absolute-position.x + root.width / 2;
                                Tooltip.y = self.absolute-position.y + parent.height + 4px;
                                Tooltip.max-width = 520px;
                                Tooltip.shown = node.db != "";
                            } else if Tooltip.text == node.db {
                                Tooltip.shown = false;
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right
                                && node.kind == "recent") {
                                root.history-menu-index = node.count;
                                root.history-menu-y = self.absolute-position.y - root.absolute-position.y;
                                history-menu.show();
                            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right
                                && node.kind == "query") {
                                root.query-menu-index = node.count;
                                root.query-menu-y = self.absolute-position.y - root.absolute-position.y;
                                query-menu.show();
                            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right
                                && is-container) {
                                click-timer.running = false;
                                root.table-menu-db = node.db;
                                root.table-menu-label = node.label;
                                root.table-menu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                root.table-menu-y = self.absolute-position.y - root.absolute-position.y + self.height;
                                table-menu.show();
                            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right
                                && node.kind == "field") {
                                root.field-menu-table = node.sub;
                                root.field-menu-label = node.label;
                                root.field-menu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                root.field-menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                field-menu.show();
                            }
                        }
                        clicked => {
                            if (is-category || is-database) {
                                root.toggle-node(node.label);
                            } else if (is-container) {
                                // Defer the expand/open: a double-click cancels it
                                // and opens instead. Acting now would rebuild the
                                // tree and eat the second click.
                                root.pending-db = node.db;
                                root.pending-label = node.label;
                                click-timer.running = false;
                                click-timer.running = true;
                            } else if (is-function) {
                                root.open-function(node.label);
                            } else if (is-query) {
                                // Saved opens into the editor; History appends so it
                                // never clobbers what the user is writing.
                                if (node.kind == "recent") {
                                    root.insert-query(node.count);
                                } else {
                                    root.open-query(node.label, node.count);
                                }
                            }
                        }
                        double-clicked => {
                            if (is-container) {
                                click-timer.running = false;
                                root.open-table(node.db, node.label);
                                root.pin-table(node.db, node.label);
                            }
                        }
                    }

                    HorizontalLayout {
                        // clamp at 0 so a depth-0 non-category row (Mongo/Redis
                        // db header, which has no wrapping category) doesn't get
                        // a negative offset and sit flush-left of everything.
                        padding-left: is-category ? Tokens.sp2 : Tokens.sp2 + max(0, node.depth - 1) * Tokens.sp3;
                        padding-right: Tokens.sp2;
                        spacing: Tokens.sp2;

                        // Compact native section heading: "Functions  10"
                        if is-category: HorizontalLayout {
                            spacing: Tokens.sp2;
                            alignment: start;
                            Rectangle {
                                width: 13px;
                                VerticalLayout {
                                    alignment: center;
                                    AppIcon {
                                        name: "caret";
                                        size: 12px;
                                        color: Tokens.text-dim;
                                        // down when expanded, right when collapsed
                                        transform-rotation: node.expanded ? 0deg : -90deg;
                                    }
                                }
                            }
                            Text {
                                text: node.label;
                                color: Tokens.text;
                                font-size: Tokens.font-sm;
                                font-weight: Tokens.weight-emphasis;
                                vertical-alignment: center;
                            }
                            if node.count > 0: Text {
                                text: "· " + node.count;
                                color: Tokens.text-faint;
                                font-size: Tokens.font-xs;
                                vertical-alignment: center;
                            }
                        }

                        // leading glyph per row type
                        if is-function: Rectangle {
                            width: 13px;
                            VerticalLayout {
                                alignment: center;
                                AppIcon {
                                    name: "function";
                                    size: 13px;
                                    color: Tokens.warn;
                                }
                            }
                        }
                        // expandable rows get a caret hinting single-click
                        // toggles them: SQL tables reveal their columns, Mongo/
                        // Redis db headers reveal their collections/keys.
                        if node.kind == "table" || is-database: Rectangle {
                            width: 13px;
                            VerticalLayout {
                                alignment: center;
                                AppIcon {
                                    name: "caret";
                                    size: 11px;
                                    color: is-active ? Tokens.on-tint : Tokens.text-faint;
                                    transform-rotation: node.expanded ? 0deg : -90deg;
                                }
                            }
                        }
                        if is-container || is-database: Rectangle {
                            width: 13px;
                            VerticalLayout {
                                alignment: center;
                                AppIcon {
                                    name: is-database ? "database" : (node.kind == "view" ? "view" : "table");
                                    size: 13px;
                                    color: is-active ? Tokens.accent : Tokens.db-pg;
                                }
                            }
                        }
                        if is-query: Rectangle {
                            width: 16px;
                            VerticalLayout {
                                alignment: center;
                                AppIcon {
                                    name: node.kind == "recent" ? "clock" : "star";
                                    size: 13px;
                                    color: is-active ? Tokens.on-tint : Tokens.text-faint;
                                }
                            }
                        }

                        // label
                        if !is-category: Text {
                            horizontal-stretch: 1;
                            text: node.label;
                            color: is-hint || is-field ? Tokens.text-faint
                                : is-active ? Tokens.on-tint : Tokens.text;
                            font-size: Tokens.font-sm;
                            font-family: is-field || is-hint ? "" : Tokens.mono;
                            font-weight: is-active ? Tokens.weight-emphasis : 400;
                            font-italic: is-hint;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // Driver badge for the engine a History row ran against.
                        if node.kind == "recent" && node.sub != "": Rectangle {
                            width: 16px;
                            VerticalLayout {
                                alignment: center;
                                DbBadge {
                                    engine: node.sub;
                                    size: 14px;
                                    fill: node.sub-has-custom-color ? node.sub-color : Tokens.db-color(node.sub);
                                }
                            }
                        }

                        // ▶: re-run this entry directly (editor untouched).
                        // Nested TouchArea wins over the row, so the row still
                        // performs its own click action (append / open).
                        if node.kind == "recent" || node.kind == "query": Rectangle {
                            width: 20px;
                            AppIcon {
                                x: 4px;
                                y: 5px;
                                name: "play";
                                size: 12px;
                                color: rerun-ta.has-hover ? Tokens.accent : Tokens.text-faint;
                            }
                            rerun-ta := TouchArea {
                                clicked => {
                                    if (node.kind == "recent") {
                                        root.rerun-query(node.count);
                                    } else {
                                        root.run-saved-query(node.count);
                                    }
                                }
                            }
                        }

                        // active table row-count badge (e.g. emiten · 986)
                        if is-active && is-container && root.active-count >= 0: Text {
                            text: root.active-count;
                            color: Tokens.on-tint;
                            font-size: Tokens.font-xs;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            }
            if root.tree-loading: Rectangle {
                width: parent.width;
                height: parent.height;
                background: Tokens.sidebar.with-alpha(0.62);
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        CircularProgressIndicator { indeterminate: true; min-height: 20px; max-height: 20px; }
                    }
                }
            }
        }

        // ----- pinned schema selector -----
        Rectangle { height: 1px; background: Tokens.border; }
        Rectangle {
            height: 46px;
            HorizontalLayout {
                padding: Tokens.sp2;
                spacing: Tokens.sp2;
                Rectangle {
                    border-radius: Tokens.radius;
                    border-width: 1px;
                    border-color: Tokens.border;
                    background: Tokens.card;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        padding-left: Tokens.sp3;
                        padding-right: Tokens.sp2;
                        Text {
                            text: "schema: " + root.schema-name;
                            color: Tokens.text;
                            font-size: Tokens.font-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: "⇅";
                            color: Tokens.text-faint;
                            font-size: Tokens.font-sm;
                            vertical-alignment: center;
                        }
                    }
                    schema-ta := TouchArea {
                        clicked => { root.select-schema(root.schema-name); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "plus";
                        clicked => { root.add-item(); }
                    }
                }
            }
        }
    }
    }

    history-menu := PopupWindow {
        x: root.width - self.width - 4px;
        y: min(root.history-menu-y, root.height - self.height - 4px);
        width: 200px;
        height: history-list.preferred-height;
        history-list := AppMenu {
            items: ["Insert to editor", "Run", "Copy query", "Save to queries", "Delete"];
            danger-index: 4;
            activated(action) => {
                root.history-action(root.history-menu-index, action);
                history-menu.close();
            }
        }
    }

    query-menu := PopupWindow {
        x: root.width - self.width - 4px;
        y: min(root.query-menu-y, root.height - self.height - 4px);
        width: 200px;
        height: query-list.preferred-height;
        query-list := AppMenu {
            items: ["Run", "Open in new tab", "Insert to editor", "Copy query", "Delete"];
            danger-index: 4;
            activated(action) => {
                root.query-action(root.query-menu-index, action);
                query-menu.close();
            }
        }
    }

    field-menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: min(root.field-menu-x, root.width - self.width - 4px);
        y: min(root.field-menu-y, root.height - self.height - 4px);
        width: 220px;
        AppMenu {
            items: ["Copy Column Name", "Copy with Quotes", "Copy All Column Names"];
            activated(action) => {
                root.copy-field(root.field-menu-table, root.field-menu-label, action);
                field-menu.close();
            }
        }
    }

    table-menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: min(root.table-menu-x, root.width - self.width - 4px);
        y: min(root.table-menu-y, root.height - self.height - 4px);
        width: 220px;
        AppMenu {
            items: [
                "Open in new tab",
                "Open structure",
                "---",
                "Copy name",
                "Copy qualified name",
                "Copy SELECT script",
                "---",
                "Import (CSV / JSON / SQL)…",
                "Export…",
                "New table…",
                "---",
                "Truncate…"
            ];
            danger-index: 11;
            activated(action) => {
                root.table-action(root.table-menu-db, root.table-menu-label, action);
                root.table-menu-label = "";
                table-menu.close();
            }
        }
    }
}

import { Tokens } from "tokens.slint";
import { AgentMessage } from "structs.slint";
import { BreadcrumbChip, ChoiceRow, DangerButton, IconButton, PrimaryButton, SecondaryButton, SelectBox, TooltipArea } from "components.slint";
import { AppIcon } from "icons.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";

component MarkdownText inherits Rectangle {
    in property <styled-text> formatted;
    in property <string> plain;
    in property <length> text-size: Tokens.font-md;
    in property <color> text-color: Tokens.text;

    // StyledText's preferred height does not include every wrapped line.
    height: max(plain-measure.preferred-height, rich-text.preferred-height) + Tokens.sp1;
    plain-measure := Text {
        width: parent.width;
        text: root.plain;
        font-size: root.text-size;
        wrap: word-wrap;
        color: transparent;
        accessible-role: none;
    }
    rich-text := StyledText {
        width: parent.width;
        height: parent.height;
        text: root.formatted;
        default-color: root.text-color;
        default-font-size: root.text-size;
        link-color: Tokens.accent;
    }
}

// A 24px icon action for dense cards, where IconButton's 40px target crowds
// the content it acts on.
component MiniAction inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: area.has-hover ? Tokens.border : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(); }
    AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        size: 14px;
        color: area.has-hover ? Tokens.text : Tokens.text-dim;
    }
    area := TooltipArea {
        tip: root.tip;
        clicked => { root.clicked(); }
    }
}

export component AgentPanel inherits Rectangle {
    in property <[AgentMessage]> messages;
    in property <[string]> conversations;
    in property <int> selected-conversation: -1;
    in property <string> connection-name;
    in property <[string]> connection-options;
    in property <string> connection-choice;
    in property <string> database-name;
    in property <[string]> database-options;
    in property <[string]> model-options;
    in property <string> model-name;
    in property <[string]> template-options;
    in property <[string]> selected-templates;
    in-out property <string> template-choice: "Add a template";
    in-out property <int> mode: 0;
    in property <bool> busy: false;
    in property <bool> can-retry: false;
    in property <string> status;
    in property <bool> status-error;
    in property <string> proposed-write;
    in property <string> write-target;
    in property <bool> write-destructive;
    in property <string> selection-preview;
    in property <[string]> mention-options;
    in-out property <string> draft: "";
    callback close;
    callback select-database(string);
    callback select-connection(string);
    callback select-model(string);
    callback toggle-template(string);
    callback new-conversation;
    callback choose-conversation(int);
    callback delete-conversation(int);
    callback mode-changed(int);
    callback send(string);
    callback retry;
    callback copy-text(string);
    callback insert-sql(string);
    callback cancel;
    callback approve-write;
    callback reject-write;
    callback clear-selection;
    callback mention-query(string);
    callback mention-selected(string);
    property <bool> scroll-to-latest;
    property <int> shown-message-count: root.messages.length;
    init => { root.scroll-to-latest = root.messages.length > 0; }
    changed shown-message-count => { root.scroll-to-latest = root.messages.length > 0; }
    changed selected-conversation => { root.scroll-to-latest = root.messages.length > 0; }

    preferred-width: 360px;
    min-width: 300px;
    background: Tokens.sidebar;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: 48px;
            padding-left: Tokens.sp3;
            padding-right: Tokens.sp3;
            spacing: Tokens.sp2;
            VerticalLayout {
                width: 18px;
                alignment: center;
                AppIcon { name: "robot"; size: 18px; color: Tokens.accent; }
            }
            Text {
                text: "Assistant";
                color: Tokens.text;
                font-size: Tokens.font-md;
                font-weight: Tokens.weight-emphasis;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton { icon: "plus"; tooltip: "New conversation"; clicked => { root.new-conversation(); } }
            IconButton { icon: "close"; tooltip: "Close Assistant"; clicked => { root.close(); } }
        }
        Rectangle { height: 1px; background: Tokens.border; }

        VerticalLayout {
            spacing: Tokens.sp2;
            if root.connection-name != "": VerticalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                spacing: Tokens.sp1;
                Text { text: "Connection"; color: Tokens.text-dim; font-size: Tokens.font-xs; }
                if root.connection-options.length > 0: SelectBox {
                    model: root.connection-options;
                    current-value: root.connection-choice;
                    selected(name) => { root.select-connection(name); }
                }
                if root.connection-options.length == 0: Text {
                    text: root.connection-name; color: Tokens.text;
                    font-size: Tokens.font-sm; overflow: elide; }
                if root.database-name != "" || root.database-options.length > 1: Text {
                    text: "Database"; color: Tokens.text-dim; font-size: Tokens.font-xs; }
                if root.database-options.length > 1: SelectBox {
                    model: root.database-options;
                    current-value: root.database-name;
                    selected(name) => { root.select-database(name); }
                }
                if root.database-options.length <= 1 && root.database-name != "": Text {
                    text: root.database-name;
                    color: Tokens.text;
                    font-size: Tokens.font-sm;
                    overflow: elide;
                }
            }
            if root.model-options.length > 0: HorizontalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                spacing: Tokens.sp1;
                Text { text: "Model"; color: Tokens.text-dim; font-size: Tokens.font-xs;
                    vertical-alignment: center; }
                SelectBox {
                    model: root.model-options;
                    current-value: root.model-name;
                    selected(name) => { root.select-model(name); }
                }
            }
            if root.template-options.length > 0: VerticalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                spacing: Tokens.sp1;
                Text { text: "Prompt templates"; color: Tokens.text-dim;
                    font-size: Tokens.font-xs; }
                SelectBox {
                    model: root.template-options;
                    current-value <=> root.template-choice;
                    selected(name) => { root.toggle-template(name); root.template-choice = "Add a template"; }
                }
                for name in root.selected-templates: HorizontalLayout {
                    spacing: Tokens.sp1;
                    Text { text: name; color: Tokens.text; font-size: Tokens.font-xs;
                        overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    IconButton { icon: "close"; tooltip: "Remove prompt template";
                        clicked => { root.toggle-template(name); } }
                }
            }
            if root.conversations.length > 1 || (root.conversations.length == 1 && root.selected-conversation < 0): ScrollView {
                height: root.conversations.length < 3 ? root.conversations.length * 40px : 120px;
                VerticalLayout {
                    spacing: Tokens.sp1;
                    for title[i] in root.conversations: HorizontalLayout {
                        height: 40px;
                        padding-left: Tokens.sp3;
                        padding-right: Tokens.sp3;
                        spacing: Tokens.sp1;
                        BreadcrumbChip {
                            text: title;
                            show-dot: i == root.selected-conversation;
                            clicked => { root.choose-conversation(i); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton {
                            icon: "close";
                            tooltip: "Delete conversation";
                            clicked => { root.delete-conversation(i); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Tokens.border; }
            if root.messages.length == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                padding-left: Tokens.sp4;
                padding-right: Tokens.sp4;
                spacing: Tokens.sp2;
                AppIcon { name: "robot"; size: 32px; color: Tokens.text-dim; }
                Text {
                    text: "Explore your database";
                    color: Tokens.text;
                    font-size: Tokens.font-md;
                    font-weight: Tokens.weight-emphasis;
                }
                Text {
                    text: "Ask for SQL help, or let Agent inspect real data.";
                    color: Tokens.text-dim;
                    wrap: word-wrap;
                    font-size: Tokens.font-sm;
                    horizontal-alignment: center;
                }
            }
            if root.messages.length > 0: messages-scroll := ScrollView {
                vertical-stretch: 1;
                viewport-height: message-list.preferred-height;
                Timer {
                    interval: 16ms;
                    running: root.scroll-to-latest;
                    triggered => {
                        messages-scroll.viewport-y = min(0px, messages-scroll.visible-height - messages-scroll.viewport-height);
                        root.scroll-to-latest = false;
                    }
                }
                message-list := VerticalLayout {
                    width: parent.width;
                    padding: Tokens.sp3;
                    spacing: Tokens.sp3;
                    alignment: start;
                    for msg in root.messages: Rectangle {
                        height: message-content.preferred-height + 2 * Tokens.sp3;
                        background: msg.role == "user" ? Tokens.accent-tint : Tokens.card;
                        border-radius: 8px;
                        message-content := VerticalLayout {
                            x: Tokens.sp3;
                            y: Tokens.sp3;
                            width: parent.width - 2 * Tokens.sp3;
                            spacing: Tokens.sp3;
                            for block in msg.blocks: VerticalLayout {
                                if block.kind == 0 || block.kind == 1: MarkdownText {
                                    formatted: block.formatted;
                                    plain: block.plain;
                                    text-size: block.kind == 1 ? Tokens.font-md + 1px : Tokens.font-md;
                                }
                                if block.kind == 2: HorizontalLayout {
                                    spacing: Tokens.sp2;
                                    Text {
                                        text: block.prefix;
                                        color: Tokens.accent;
                                        font-size: Tokens.font-md;
                                    }
                                    MarkdownText {
                                        formatted: block.formatted;
                                        plain: block.plain;
                                        horizontal-stretch: 1;
                                    }
                                }
                                if block.kind == 3: Rectangle {
                                    height: code-measure.y + code-measure.preferred-height + Tokens.sp3;
                                    background: Tokens.sidebar;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Tokens.border;
                                    code-head := HorizontalLayout {
                                        x: Tokens.sp3;
                                        y: Tokens.sp1;
                                        width: parent.width - Tokens.sp3 - Tokens.sp1;
                                        height: 24px;
                                        spacing: 2px;
                                        Text {
                                            text: block.prefix != "" ? block.prefix : "code";
                                            color: Tokens.text-dim;
                                            font-size: Tokens.font-xs;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        MiniAction {
                                            icon: "copy";
                                            tip: "Copy";
                                            clicked => { root.copy-text(block.plain); }
                                        }
                                        MiniAction {
                                            icon: "pencil";
                                            tip: "Insert into the editor";
                                            clicked => { root.insert-sql(block.plain); }
                                        }
                                    }
                                    // Wrapped TextInput reports no height for its
                                    // extra lines; a hidden Text measures them.
                                    code-measure := Text {
                                        x: Tokens.sp3;
                                        y: code-head.y + code-head.height + Tokens.sp1;
                                        width: parent.width - 2 * Tokens.sp3;
                                        text: block.plain;
                                        wrap: word-wrap;
                                        font-family: Tokens.mono;
                                        font-size: Tokens.font-sm;
                                        color: transparent;
                                        accessible-role: none;
                                    }
                                    // Read-only TextInput rather than Text, so part
                                    // of the code can be selected and copied.
                                    TextInput {
                                        x: code-measure.x;
                                        y: code-measure.y;
                                        width: code-measure.width;
                                        height: code-measure.preferred-height;
                                        text: block.plain;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Tokens.text;
                                        font-family: Tokens.mono;
                                        font-size: Tokens.font-sm;
                                    }
                                }
                                if block.kind == 4: Rectangle {
                                    height: row-title.preferred-height + row-text.preferred-height + 4 * Tokens.sp3 + Tokens.sp2;
                                    background: Tokens.sidebar;
                                    border-radius: 6px;
                                    row-title := Text {
                                        x: Tokens.sp3;
                                        y: Tokens.sp3;
                                        width: parent.width - 2 * Tokens.sp3;
                                        text: "Row " + block.prefix;
                                        color: Tokens.accent;
                                        font-size: Tokens.font-xs;
                                        font-weight: Tokens.weight-emphasis;
                                    }
                                    row-text := Text {
                                        x: Tokens.sp3;
                                        y: Tokens.sp3 + row-title.preferred-height + Tokens.sp2;
                                        width: parent.width - 2 * Tokens.sp3;
                                        text: block.plain;
                                        color: Tokens.text;
                                        font-size: Tokens.font-md;
                                        wrap: word-wrap;
                                    }
                                }
                                if block.kind == 5: Rectangle {
                                    height: quote-text.preferred-height + 2 * Tokens.sp2;
                                    Rectangle { width: 2px; height: parent.height; background: Tokens.accent; }
                                    quote-text := MarkdownText {
                                        x: Tokens.sp2;
                                        y: Tokens.sp2;
                                        width: parent.width - Tokens.sp2;
                                        formatted: block.formatted;
                                        plain: block.plain;
                                        text-color: Tokens.text-dim;
                                    }
                                }
                            }
                            if msg.steps != "": HorizontalLayout {
                                spacing: Tokens.sp1;
                                VerticalLayout {
                                    alignment: start;
                                    AppIcon { name: "terminal"; size: 12px; color: Tokens.text-dim; }
                                }
                                Text {
                                    text: msg.steps;
                                    color: Tokens.text-dim;
                                    font-family: Tokens.mono;
                                    font-size: Tokens.font-xs;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    if root.busy: HorizontalLayout {
                        spacing: Tokens.sp2;
                        property <int> dots: 0;
                        Timer {
                            interval: 400ms;
                            running: root.busy;
                            triggered => { parent.dots = Math.mod(parent.dots + 1, 4); }
                        }
                        AppIcon { name: "robot"; size: 16px; color: Tokens.accent; }
                        Text {
                            text: (root.status != "" ? root.status : "Thinking")
                                + (parent.dots == 1 ? "." : parent.dots == 2 ? ".." : parent.dots == 3 ? "..." : "");
                            color: Tokens.text-dim;
                            font-size: Tokens.font-sm;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
            if root.status != "" && !root.busy && root.status-error: HorizontalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                Rectangle {
                    background: Tokens.error-tint;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Tokens.error.with-alpha(0.4);
                    height: status-text.preferred-height + 2 * Tokens.sp2;
                    Rectangle {
                        x: 0;
                        width: 3px;
                        height: parent.height;
                        border-radius: 1.5px;
                        background: Tokens.error;
                    }
                    status-text := Text {
                        x: Tokens.sp3;
                        y: Tokens.sp2;
                        width: parent.width - Tokens.sp3 - Tokens.sp2;
                        text: root.status;
                        color: Tokens.text;
                        wrap: word-wrap;
                        font-size: Tokens.font-sm;
                    }
                }
            }
            if root.status != "" && !root.busy && !root.status-error: Text {
                text: root.status;
                color: Tokens.text-dim;
                wrap: word-wrap;
                font-size: Tokens.font-xs;
                horizontal-alignment: center;
            }
            if root.proposed-write != "": HorizontalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                Rectangle {
                    background: root.write-destructive ? Tokens.error-tint : Tokens.warn-tint;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.write-destructive ? Tokens.error : Tokens.warn;
                    VerticalLayout {
                        padding: Tokens.sp3;
                        spacing: Tokens.sp2;
                        HorizontalLayout {
                            spacing: Tokens.sp2;
                            Rectangle {
                                width: risk-label.preferred-width + 2 * Tokens.sp2;
                                height: 20px;
                                border-radius: 4px;
                                background: root.write-destructive ? Tokens.error : Tokens.warn;
                                risk-label := Text {
                                    text: root.write-destructive ? "DESTRUCTIVE" : "WRITE";
                                    color: white;
                                    font-size: Tokens.font-xs;
                                    font-weight: Tokens.weight-emphasis;
                                }
                            }
                            Text {
                                text: "Run this SQL once?";
                                color: Tokens.text;
                                font-size: Tokens.font-sm;
                                font-weight: Tokens.weight-emphasis;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            MiniAction {
                                icon: "copy";
                                tip: "Copy SQL";
                                clicked => { root.copy-text(root.proposed-write); }
                            }
                        }
                        if root.write-destructive: Text {
                            text: "It drops or rewrites data and cannot be undone.";
                            color: Tokens.error;
                            font-size: Tokens.font-sm;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Target: " + root.write-target;
                            color: Tokens.text-dim;
                            font-size: Tokens.font-xs;
                            wrap: word-wrap;
                        }
                        // Long SQL scrolls inside a capped box so the buttons
                        // below never leave the panel.
                        sql-box := Rectangle {
                            height: min(sql-measure.preferred-height + 2 * Tokens.sp2, 160px);
                            background: Tokens.sidebar;
                            border-radius: 6px;
                            ScrollView {
                                viewport-width: sql-box.width;
                                viewport-height: sql-measure.preferred-height + 2 * Tokens.sp2;
                                sql-measure := Text {
                                    x: Tokens.sp2;
                                    y: Tokens.sp2;
                                    width: sql-box.width - 2 * Tokens.sp2 - 12px;
                                    text: root.proposed-write;
                                    wrap: word-wrap;
                                    font-family: Tokens.mono;
                                    font-size: Tokens.font-sm;
                                    color: transparent;
                                    accessible-role: none;
                                }
                                TextInput {
                                    x: sql-measure.x;
                                    y: sql-measure.y;
                                    width: sql-measure.width;
                                    height: sql-measure.preferred-height;
                                    text: root.proposed-write;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    color: Tokens.text;
                                    font-family: Tokens.mono;
                                    font-size: Tokens.font-sm;
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: Tokens.sp1;
                            SecondaryButton { text: "Deny"; clicked => { root.reject-write(); } }
                            if root.write-destructive: DangerButton {
                                text: "Run once";
                                clicked => { root.approve-write(); }
                            }
                            if !root.write-destructive: PrimaryButton {
                                text: "Run once";
                                clicked => { root.approve-write(); }
                            }
                        }
                    }
                }
            }
            ChoiceRow {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                label: "Mode";
                option-a: "Ask";
                option-b: "Agent";
                index: root.mode;
                chosen(i) => { root.mode = i; root.mode-changed(i); }
            }
            Text {
                text: root.mode == 0
                    ? "Ask suggests SQL without running queries."
                    : "Agent can read data; writes need approval.";
                color: Tokens.text-dim;
                font-size: Tokens.font-xs;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            if root.selection-preview != "": HorizontalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                spacing: Tokens.sp1;
                AppIcon { name: "terminal"; size: 16px; color: Tokens.accent; }
                Text {
                    text: root.selection-preview;
                    color: Tokens.text;
                    font-size: Tokens.font-xs;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton { icon: "close"; tooltip: "Remove editor selection";
                    clicked => { root.clear-selection(); } }
            }
            HorizontalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                TextEdit {
                    height: 88px;
                    text <=> root.draft;
                    edited => { root.mention-query(self.text); }
                    wrap: word-wrap;
                    font-size: Tokens.font-sm;
                }
            }
            if root.mention-options.length > 0: HorizontalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                SelectBox {
                    model: root.mention-options;
                    current-value: "Choose a table";
                    selected(name) => { root.mention-selected(name); }
                }
            }
            HorizontalLayout {
                padding-left: Tokens.sp3;
                padding-right: Tokens.sp3;
                padding-bottom: Tokens.sp2;
                Rectangle { horizontal-stretch: 1; }
                if root.busy: SecondaryButton { text: "Stop"; clicked => { root.cancel(); } }
                if !root.busy && root.can-retry && root.proposed-write == "": SecondaryButton {
                    text: "Retry";
                    clicked => { root.retry(); }
                }
                if !root.busy: PrimaryButton {
                    text: "Send";
                    enabled: root.draft != "" && root.proposed-write == "";
                    clicked => { root.send(root.draft); }
                }
            }
        }
    }
}

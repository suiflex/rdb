// Open-connections rail (TablePlus-style), on the outer side of the Items/
// Queries/History card: one tile per connection that is live or being opened.
// Saved but closed connections and their groups stay in the picker, which
// the "+" at the bottom opens.
import { Tokens } from "tokens.slint";
import { TopLevelGroup } from "structs.slint";
import { DbBadge, TooltipArea } from "components.slint";
import { StateLayer, MaterialPalette } from "@material";
import { ScrollView } from "std-widgets.slint";

export component ConnectionsPanel inherits Rectangle {
    in property <[TopLevelGroup]> connections;
    // Store index of the active tab's connection — same field the picker
    // uses (`selected-conn`), so "active" always means the same row
    // everywhere instead of drifting on a name-string comparison.
    in property <int> selected-conn: -1;
    // The sidebar card is showing next to the rail: the active tile joins it.
    in property <bool> notch;
    // Rail on the right edge: the card (and the notch) is to its left.
    in property <bool> mirror;
    callback connect-clicked(int);
    callback open-picker();

    // A strip distinct from the card: Material's `surface` (the card) is the
    // canvas colour in both themes, so a canvas rail hid the notch.
    background: Tokens.sidebar;

    VerticalLayout {
        padding-top: Tokens.sp2;
        padding-bottom: Tokens.sp2;
        spacing: Tokens.sp2;
        list := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: list.visible-width;
                for group in root.connections: VerticalLayout {
                    for item in group.rows: Rectangle {
                        // The sidebar model lists every saved connection; the
                        // rail keeps the open ones plus the one being opened.
                        property <bool> open: !item.is-header && (item.live || item.index == root.selected-conn);
                        property <bool> active: !item.is-header && item.index == root.selected-conn;
                        // Active tile in the card's colour, running into the card
                        // on its inner edge: a tab, not a separate highlight.
                        property <bool> joined: active && root.notch;
                        visible: open;
                        height: open ? 72px : 0px;
                        tile := Rectangle {
                            x: joined && root.mirror ? 0 : Tokens.sp1;
                            y: Tokens.sp1;
                            width: parent.width - (joined ? Tokens.sp1 : 2 * Tokens.sp1);
                            height: parent.height - 2 * Tokens.sp1;
                            border-top-left-radius: joined && root.mirror ? 0 : Tokens.radius;
                            border-bottom-left-radius: joined && root.mirror ? 0 : Tokens.radius;
                            border-top-right-radius: joined && !root.mirror ? 0 : Tokens.radius;
                            border-bottom-right-radius: joined && !root.mirror ? 0 : Tokens.radius;
                            background: joined ? MaterialPalette.surface : active ? Tokens.accent-tint : transparent;
                            StateLayer {
                                width: 100%;
                                height: 100%;
                                background: MaterialPalette.on_surface;
                                border-radius: Tokens.radius;
                                has-hover: tile-ta.has-hover;
                                enabled: true;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                padding-left: 2px;
                                padding-right: 2px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        DbBadge {
                                            x: 2px;
                                            y: 2px;
                                            engine: item.engine;
                                            size: 32px;
                                            fill: item.has-custom-color ? item.color : Tokens.db-color(item.engine);
                                        }
                                        // Live = connected; amber while still opening.
                                        Rectangle {
                                            x: parent.width - self.width;
                                            y: parent.height - self.height;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: self.width / 2;
                                            border-width: 2px;
                                            border-color: joined ? MaterialPalette.surface : Tokens.sidebar;
                                            background: item.live ? Tokens.ok : Tokens.warn;
                                        }
                                    }
                                }
                                Text {
                                    text: item.name;
                                    color: joined ? Tokens.text : active ? Tokens.on-tint : Tokens.text-dim;
                                    font-size: Tokens.font-xs;
                                    font-weight: active ? Tokens.weight-emphasis : 400;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                            tile-ta := TooltipArea {
                                tip: item.name;
                                clicked => { root.connect-clicked(item.index); }
                            }
                        }
                        // Concave corners above and below the joined tile, on the
                        // card side, so the tab flows into the card. A card-coloured
                        // square with a rail-coloured quarter-circle cut out of it
                        // (plain rectangular clip, no layer).
                        if joined: Rectangle {
                            x: root.mirror ? 0 : parent.width - self.width;
                            y: tile.y - self.height;
                            width: Tokens.radius;
                            height: Tokens.radius;
                            clip: true;
                            background: MaterialPalette.surface;
                            Rectangle {
                                x: root.mirror ? 0 : -parent.width;
                                y: -parent.height;
                                width: 2 * parent.width;
                                height: 2 * parent.height;
                                border-radius: parent.width;
                                background: Tokens.sidebar;
                            }
                        }
                        if joined: Rectangle {
                            x: root.mirror ? 0 : parent.width - self.width;
                            y: tile.y + tile.height;
                            width: Tokens.radius;
                            height: Tokens.radius;
                            clip: true;
                            background: MaterialPalette.surface;
                            Rectangle {
                                x: root.mirror ? 0 : -parent.width;
                                y: 0;
                                width: 2 * parent.width;
                                height: 2 * parent.height;
                                border-radius: parent.width;
                                background: Tokens.sidebar;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: self.width / 2;
                StateLayer {
                    width: 100%;
                    height: 100%;
                    background: MaterialPalette.on_surface;
                    border-radius: parent.border-radius;
                    has-hover: add-ta.has-hover;
                    enabled: true;
                }
                Text {
                    text: "+";
                    color: add-ta.has-hover ? Tokens.accent : Tokens.text-dim;
                    font-size: 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                add-ta := TooltipArea {
                    tip: "Open connection";
                    clicked => { root.open-picker(); }
                }
            }
        }
    }
}

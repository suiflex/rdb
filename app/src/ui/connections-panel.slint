// Open-connections rail (TablePlus-style), to the left of the Items/Queries/
// History card: one tile per connection that is live or being opened. Saved
// but closed connections and their groups stay in the picker, which the "+"
// at the bottom opens.
import { Tokens } from "tokens.slint";
import { TopLevelGroup } from "structs.slint";
import { DbBadge, TooltipArea } from "components.slint";
import { StateLayer, MaterialPalette } from "@material";
import { ScrollView } from "std-widgets.slint";

export component ConnectionsPanel inherits Rectangle {
    in property <[TopLevelGroup]> connections;
    // Store index of the active tab's connection — same field the picker
    // uses (`selected-conn`), so "active" always means the same row
    // everywhere instead of drifting on a name-string comparison.
    in property <int> selected-conn: -1;
    callback connect-clicked(int);
    callback open-picker();

    background: Tokens.canvas;

    VerticalLayout {
        padding-top: Tokens.sp2;
        padding-bottom: Tokens.sp2;
        spacing: Tokens.sp2;
        list := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: list.visible-width;
                for group in root.connections: VerticalLayout {
                    for item in group.rows: Rectangle {
                        // The sidebar model lists every saved connection; the
                        // rail keeps the open ones plus the one being opened.
                        property <bool> open: !item.is-header && (item.live || item.index == root.selected-conn);
                        property <bool> active: !item.is-header && item.index == root.selected-conn;
                        visible: open;
                        height: open ? 72px : 0px;
                        tile := Rectangle {
                            x: Tokens.sp1;
                            y: Tokens.sp1;
                            width: parent.width - 2 * Tokens.sp1;
                            height: parent.height - 2 * Tokens.sp1;
                            border-radius: Tokens.radius;
                            background: active ? Tokens.accent-tint : transparent;
                            StateLayer {
                                background: MaterialPalette.on_surface;
                                border-radius: parent.border-radius;
                                has-hover: tile-ta.has-hover;
                                enabled: true;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                padding-left: 2px;
                                padding-right: 2px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        DbBadge {
                                            x: 2px;
                                            y: 2px;
                                            engine: item.engine;
                                            size: 32px;
                                            fill: item.has-custom-color ? item.color : Tokens.db-color(item.engine);
                                        }
                                        // Live = connected; amber while still opening.
                                        Rectangle {
                                            x: parent.width - self.width;
                                            y: parent.height - self.height;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: self.width / 2;
                                            border-width: 2px;
                                            border-color: Tokens.canvas;
                                            background: item.live ? Tokens.ok : Tokens.warn;
                                        }
                                    }
                                }
                                Text {
                                    text: item.name;
                                    color: active ? Tokens.on-tint : Tokens.text-dim;
                                    font-size: Tokens.font-xs;
                                    font-weight: active ? Tokens.weight-emphasis : 400;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                            tile-ta := TooltipArea {
                                tip: item.name;
                                clicked => { root.connect-clicked(item.index); }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: self.width / 2;
                StateLayer {
                    background: MaterialPalette.on_surface;
                    border-radius: parent.border-radius;
                    has-hover: add-ta.has-hover;
                    enabled: true;
                }
                Text {
                    text: "+";
                    color: add-ta.has-hover ? Tokens.accent : Tokens.text-dim;
                    font-size: 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                add-ta := TooltipArea {
                    tip: "Open connection";
                    clicked => { root.open-picker(); }
                }
            }
        }
    }
}

{
  "suiteName": "RDB desktop UI",
  "mode": "desktop",
  "mcpProvider": "slint-mcp",
  "projectSlug": "rdb-desktop",
  "projectName": "RDB Desktop",
  "cases": [
    {
      "sourceRef": "rdb/v43/grid-block-selection",
      "name": "grid_block_selection_widens_across_columns",
      "title": "Dragging sideways selects a block of cells instead of panning the grid",
      "description": "The results grid sat in a bare Flickable, so a sideways drag was taken as a pan and the selection never widened. Films the real gesture: the tinted block should grow across two columns while the grid stays put.",
      "priority": "P1",
      "source": "MCP",
      "category": "Regression",
      "tags": [
        "rdb",
        "grid",
        "selection",
        "v43"
      ],
      "steps": [
        {
          "order": 0,
          "action": "Launch rdb in mock mode on the saved SQL screen",
          "expected": "Window up, MCP port answers",
          "code": "{\"tool\": \"slint.launch\", \"arguments\": {\"command\": [\"${RDB_BINARY}\"], \"env\": {\"RDB_MOCK\": \"1\", \"RDB_SCREEN\": \"sql\", \"RDB_WIN\": \"1400x900\"}, \"ready_timeout_s\": 60}}"
        },
        {
          "order": 1,
          "action": "Wait for the result rows",
          "expected": "The grid has cells, so the query has finished",
          "code": "{\"tool\": \"slint.assert_visible\", \"arguments\": {\"id\": \"TabularGrid::cell-ta\", \"timeout_s\": 60}}"
        },
        {
          "order": 2,
          "action": "Start filming",
          "expected": "Recording",
          "code": "{\"tool\":\"slint.start_video\",\"arguments\":{\"interval_ms\":60}}"
        },
        {
          "order": 3,
          "action": "Drag from the first cell across to another column, two rows down",
          "expected": "Block widens across columns; the grid does not scroll",
          "code": "{\"tool\":\"slint.drag\",\"arguments\":{\"id\":\"TabularGrid::cell-ta\",\"index\":0,\"to_id\":\"TabularGrid::cell-ta\",\"to_index\":7,\"timeout_s\":30}}"
        },
        {
          "order": 4,
          "action": "Capture the selection",
          "expected": "Screenshot shows the tinted block",
          "code": "{\"tool\":\"slint.screenshot\",\"arguments\":{}}"
        },
        {
          "order": 5,
          "action": "Stop filming",
          "expected": "MP4 attached to the run",
          "code": "{\"tool\":\"slint.stop_video\",\"arguments\":{}}"
        },
        {
          "order": 6,
          "action": "Stop the application",
          "expected": "Process exits",
          "code": "{\"tool\":\"slint.close\",\"arguments\":{}}"
        }
      ]
    },
    {
      "sourceRef": "rdb/v43/grid-column-drag",
      "name": "grid_drag_down_stays_in_one_column",
      "title": "Dragging straight down selects rows within the one column",

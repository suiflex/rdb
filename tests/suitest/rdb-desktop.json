        },
        {
          "order": 4,
          "action": "Capture the selection",
          "expected": "Screenshot shows one tinted column",
          "code": "{\"tool\":\"slint.screenshot\",\"arguments\":{}}"
        },
        {
          "order": 5,
          "action": "Stop filming",
          "expected": "MP4 attached to the run",
          "code": "{\"tool\":\"slint.stop_video\",\"arguments\":{}}"
        },
        {
          "order": 6,

          "expected": "Process exits",
          "code": "{\"tool\":\"slint.close\",\"arguments\":{}}"
        }
      ]
    },
    {
      "sourceRef": "rdb/v43/copy-whole-grid",
      "name": "toolbar_copy_takes_the_whole_grid",
      "title": "The toolbar Copy button still copies every loaded row",
      "description": "Copy semantics changed so a selection copies only itself; the toolbar button had to keep copying everything. The footer note is the observable: it should read \"copied 10 rows\" for the ten-row result.",
      "priority": "P1",
      "source": "MCP",
      "category": "Regression",
      "tags": [
        "rdb",
        "copy",
        "v43"
      ],
      "steps": [
        {
          "order": 0,
          "action": "Launch rdb in mock mode on the saved SQL screen",
          "expected": "Window up, MCP port answers",
          "code": "{\"tool\": \"slint.launch\", \"arguments\": {\"command\": [\"${RDB_BINARY}\"], \"env\": {\"RDB_MOCK\": \"1\", \"RDB_SCREEN\": \"sql\", \"RDB_WIN\": \"1400x900\"}, \"ready_timeout_s\": 60}}"
        },
        {
          "order": 1,
          "action": "Wait for the result rows",
          "expected": "The grid has cells, so the query has finished",
          "code": "{\"tool\": \"slint.assert_visible\", \"arguments\": {\"id\": \"TabularGrid::cell-ta\", \"timeout_s\": 60}}"
        },
        {
          "order": 2,
          "action": "Start filming",
          "expected": "Recording",
          "code": "{\"tool\":\"slint.start_video\",\"arguments\":{\"interval_ms\":60}}"
        },
        {
          "order": 3,
          "action": "Click the toolbar Copy button",
          "expected": "The whole grid goes to the clipboard",
          "code": "{\"tool\":\"slint.click\",\"arguments\":{\"id\":\"TextButton::label\",\"label\":\"Copy\",\"timeout_s\":30}}"
        },
        {
          "order": 4,
          "action": "Dump the window elements",
          "expected": "The footer note is in the tree, whatever it says",
          "code": "{\"tool\":\"slint.element_tree\",\"arguments\":{\"max_elements\":400}}"
        },
        {
          "order": 5,
          "action": "Read the footer note",
          "expected": "It reports every loaded row, not a selection",
          "code": "{\"tool\":\"slint.assert_text\",\"arguments\":{\"id\":\"QueryPane::results-meta\",\"contains\":\"copied\",\"timeout_s\":15}}"
        },
        {
          "order": 6,
          "action": "Stop filming",
          "expected": "MP4 attached to the run",
          "code": "{\"tool\":\"slint.stop_video\",\"arguments\":{}}"
        },
        {
          "order": 7,
          "action": "Stop the application",
          "expected": "Process exits",
          "code": "{\"tool\":\"slint.close\",\"arguments\":{}}"
        }
      ]
    },
    {
      "sourceRef": "rdb/v43/close-query-tab",
      "name": "closing_a_query_tab_keeps_the_window_responsive",
      "title": "Closing a query tab does not freeze the window",
      "description": "Closing a tab held a non-reentrant mutex across the persist that re-locks it, deadlocking the UI thread. A frozen window stops answering its MCP port, so the read after the click is the regression check.",
      "priority": "P1",
      "source": "MCP",
      "category": "Regression",
      "tags": [
        "rdb",
        "tabs",
        "v43"
      ],
      "steps": [
        {
          "order": 0,
          "action": "Launch rdb in mock mode on the saved SQL screen",
          "expected": "Window up, MCP port answers",
          "code": "{\"tool\": \"slint.launch\", \"arguments\": {\"command\": [\"${RDB_BINARY}\"], \"env\": {\"RDB_MOCK\": \"1\", \"RDB_SCREEN\": \"sql\", \"RDB_WIN\": \"1400x900\"}, \"ready_timeout_s\": 60}}"
        },
        {
          "order": 1,
          "action": "Wait for the tab strip",
          "expected": "Close control present",
          "code": "{\"tool\":\"slint.assert_visible\",\"arguments\":{\"id\":\"MainWindow::close-ta\",\"timeout_s\":45}}"
        },
        {
          "order": 2,
          "action": "Start filming",
          "expected": "Recording",
          "code": "{\"tool\":\"slint.start_video\",\"arguments\":{\"interval_ms\":60}}"
        },
        {
          "order": 3,
          "action": "Close a query tab",
          "expected": "The tab closes",
          "code": "{\"tool\":\"slint.click\",\"arguments\":{\"id\":\"MainWindow::close-ta\",\"timeout_s\":30}}"
        },
        {
          "order": 4,
          "action": "Read the window back",
          "expected": "The app still answers, so the event loop did not deadlock",
          "code": "{\"tool\":\"slint.assert_visible\",\"arguments\":{\"id\":\"CodeEditor::focus-scope\",\"timeout_s\":30}}"
        },
        {
          "order": 5,
          "action": "Stop filming",
          "expected": "MP4 attached to the run",
          "code": "{\"tool\":\"slint.stop_video\",\"arguments\":{}}"
        },
        {
          "order": 6,
          "action": "Stop the application",
          "expected": "Process exits",
          "code": "{\"tool\":\"slint.close\",\"arguments\":{}}"
        }
      ]
    },
    {
      "sourceRef": "rdb/v43/editor-caret",
      "name": "editor_caret_renders_on_the_pixel_grid",
      "title": "The editor caret renders as one crisp bar between characters",
      "description": "The mono advance is 7.8px, so an unrounded caret x was antialiased across three pixel columns and smeared into the neighbouring glyph. Clicks into a line mid-way and films the caret landing.",
      "priority": "P2",
      "source": "MCP",
      "category": "Visual",
      "tags": [
        "rdb",
        "editor",
        "v43"
      ],
      "steps": [
        {
          "order": 0,
          "action": "Launch rdb in mock mode on the saved SQL screen",
          "expected": "Window up, MCP port answers",
          "code": "{\"tool\": \"slint.launch\", \"arguments\": {\"command\": [\"${RDB_BINARY}\"], \"env\": {\"RDB_MOCK\": \"1\", \"RDB_SCREEN\": \"sql\", \"RDB_WIN\": \"1400x900\"}, \"ready_timeout_s\": 60}}"
        },
        {
          "order": 1,
          "action": "Wait for the editor",
          "expected": "Editor focus scope present",
          "code": "{\"tool\":\"slint.assert_visible\",\"arguments\":{\"id\":\"CodeEditor::focus-scope\",\"timeout_s\":45}}"
        },
        {
          "order": 2,
          "action": "Start filming",
          "expected": "Recording",
          "code": "{\"tool\":\"slint.start_video\",\"arguments\":{\"interval_ms\":60}}"
        },
        {
          "order": 3,
          "action": "Click into an editor line",
          "expected": "The caret lands on that line",
          "code": "{\"tool\":\"slint.click\",\"arguments\":{\"id\":\"CodeEditor::line-ta\",\"index\":3,\"timeout_s\":30}}"
        },
        {
          "order": 4,
          "action": "Capture the caret",
          "expected": "Screenshot shows a single crisp caret",
          "code": "{\"tool\":\"slint.screenshot\",\"arguments\":{}}"
        },
        {
          "order": 5,
          "action": "Stop filming",
          "expected": "MP4 attached to the run",
          "code": "{\"tool\":\"slint.stop_video\",\"arguments\":{}}"
        },
        {
          "order": 6,
          "action": "Stop the application",
          "expected": "Process exits",
          "code": "{\"tool\":\"slint.close\",\"arguments\":{}}"
        }
      ]
    },
    {
      "sourceRef": "rdb/v43/keyboard-delivery",
      "name": "keyboard_events_are_delivered_but_ignored",
      "title": "Keyboard delivery diagnostic: the window receives keys and nothing consumes them",
      "description": "Cmd+C copy cannot be asserted here. Brackets the key dispatch with the event recorder: pointer events come back Accepted, key events come back Ignored, so the keys arrive and no focused item handles them. Records the evidence rather than asserting a pass.",
      "priority": "P2",
      "source": "MCP",
      "category": "Diagnostic",
      "tags": [
        "rdb",
        "keyboard",
        "diagnostic",
        "v43"
      ],
      "steps": [
        {
          "order": 0,
          "action": "Launch rdb in mock mode on the saved SQL screen",
          "expected": "Window up, MCP port answers",
          "code": "{\"tool\": \"slint.launch\", \"arguments\": {\"command\": [\"${RDB_BINARY}\"], \"env\": {\"RDB_MOCK\": \"1\", \"RDB_SCREEN\": \"sql\", \"RDB_WIN\": \"1400x900\"}, \"ready_timeout_s\": 60}}"
        },
        {
          "order": 1,
          "action": "Wait for the result rows",
          "expected": "The grid has cells, so the query has finished",
          "code": "{\"tool\": \"slint.assert_visible\", \"arguments\": {\"id\": \"TabularGrid::cell-ta\", \"timeout_s\": 60}}"
        },
        {
          "order": 2,
          "action": "Start recording the events the app receives",
          "expected": "Recorder armed",
          "code": "{\"tool\":\"slint.start_recording\",\"arguments\":{}}"
        },
        {
          "order": 3,
          "action": "Click a cell to focus the grid",
          "expected": "Pointer events are accepted",
          "code": "{\"tool\":\"slint.click\",\"arguments\":{\"id\":\"TabularGrid::cell-ta\",\"index\":4,\"timeout_s\":30}}"
        },
        {
          "order": 4,
          "action": "Send the copy key",
          "expected": "The key reaches the window",
          "code": "{\"tool\":\"slint.press_key\",\"arguments\":{\"text\":\"c\"}}"
        },
        {
          "order": 5,
          "action": "Read the event log back",
          "expected": "Each event carries its Accepted/Ignored verdict",
          "code": "{\"tool\":\"slint.stop_recording\",\"arguments\":{}}"
        },
        {
          "order": 6,
          "action": "Stop the application",
          "expected": "Process exits",
          "code": "{\"tool\":\"slint.close\",\"arguments\":{}}"
        }
      ]
    },
    {
      "sourceRef": "rdb/v43/open-query-adds-a-tab",
      "name": "opening_a_query_adds_a_tab",
      "title": "Opening a query from the sidebar adds a tab instead of replacing one",
      "description": "Picking a query from history or the saved list reused whichever SQL tab was active and overwrote its text, taking unsaved work with it. Opens a second query and checks both that a tab was added and that the tabs already open are still there.",
      "priority": "P1",
      "source": "MCP",
      "category": "Regression",
      "tags": [
        "rdb",
        "tabs",
        "history",
        "v43"
      ],
      "steps": [
        {
          "order": 0,
          "action": "Launch rdb in mock mode on the saved SQL screen",
          "expected": "Window up, MCP port answers",
          "code": "{\"tool\": \"slint.launch\", \"arguments\": {\"command\": [\"${RDB_BINARY}\"], \"env\": {\"RDB_MOCK\": \"1\", \"RDB_SCREEN\": \"sql\", \"RDB_WIN\": \"1400x900\"}, \"ready_timeout_s\": 60}}"
        },
        {
          "order": 1,
          "action": "Wait for the result rows",
          "expected": "The grid has cells, so the query has finished",
          "code": "{\"tool\": \"slint.assert_visible\", \"arguments\": {\"id\": \"TabularGrid::cell-ta\", \"timeout_s\": 60}}"
        },
        {
          "order": 2,
          "action": "Start filming",
          "expected": "Recording",
          "code": "{\"tool\": \"slint.start_video\", \"arguments\": {\"interval_ms\": 60}}"
        },
        {
          "order": 3,
          "action": "Open a saved query from the sidebar",
          "expected": "It opens without disturbing the open tabs",
          "code": "{\"tool\": \"slint.click\", \"arguments\": {\"id\": \"Sidebar::row-ta\", \"index\": 1, \"timeout_s\": 30}}"
        },
        {
          "order": 4,
          "action": "Look for a second tab of that query",
          "expected": "A tab was added, not reused",
          "code": "{\"tool\": \"slint.assert_visible\", \"arguments\": {\"id\": \"MainWindow::tab-root\", \"label\": \"emiten-per-sektor\", \"index\": 1, \"timeout_s\": 15}}"
        },
        {
          "order": 5,
          "action": "Check a tab that was already open",
          "expected": "The other tabs survived untouched",
          "code": "{\"tool\": \"slint.assert_visible\", \"arguments\": {\"id\": \"MainWindow::tab-root\", \"label\": \"mongo\", \"timeout_s\": 15}}"
        },
        {
          "order": 6,
          "action": "Stop filming",
          "expected": "MP4 attached to the run",
          "code": "{\"tool\": \"slint.stop_video\", \"arguments\": {}}"
        },
        {
          "order": 7,
          "action": "Stop the application",
          "expected": "Process exits",
          "code": "{\"tool\": \"slint.close\", \"arguments\": {}}"
        }
      ]
    }
  ]
